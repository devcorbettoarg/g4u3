{%- assign metafield_benefits = product.metafields.custom.product_benefits.value -%}

{%- if metafield_benefits != blank -%}
  <div class="g4u-card__tags g4u-product-highlights__tags" aria-label="Características del producto" {{ block.shopify_attributes }}>
    {%- for benefit in metafield_benefits -%}
      <span class="g4u-card__tag">
        {%- if benefit.icon.value != blank -%}
          {{ benefit.icon.value | image_url: width: 100 | image_tag: class: 'g4u-card__tag-icon', loading: 'lazy', alt: benefit.name.value }}
        {%- endif -%}
        {%- if benefit.name.value != blank -%}{{ benefit.name.value | escape }}{%- endif -%}
      </span>
    {%- endfor -%}
  </div>
{%- endif -%}
