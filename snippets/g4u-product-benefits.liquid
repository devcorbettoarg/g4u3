{%- liquid
  assign intro = product.metafields.custom.product_intro.value | default: block.settings.intro
  assign beneficios_obj = product.metafields.custom.lista_beneficios.value
-%}

<div class="g4u-product-highlights" {{ block.shopify_attributes }}>
  {%- if intro != blank -%}
    <div class="g4u-product-highlights__intro">{{product.metafields.custom.description | metafield_tag }}</div>
  {%- endif -%}

  {%- if beneficios_obj != blank and beneficios_obj.beneficios.value != blank -%}
    <ul class="barkin-benefits-list">
      {%- for beneficio in beneficios_obj.beneficios.value -%}
        <li class="barkin-benefits-list__item">{{ beneficio | escape }}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>
