{%- liquid
  assign intro = product.metafields.custom.product_intro.value | default: block.settings.intro
  assign beneficios_obj = product.metafields.custom.lista_beneficios.value
-%}
<p>{{ product.metafields.custom.description | metafield_tag }}</p>

<div class="g4u-product-highlights" {{ block.shopify_attributes }}>
  {%- if intro != blank -%}
    <div class="g4u-product-highlights__intro">
      {%- if product.metafields.custom.product_intro2.value != blank -%}
        {{ product.metafields.custom.product_intro | metafield_tag }}
      {%- else -%}
        {{ intro | escape }}
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if beneficios_obj != blank and beneficios_obj.beneficios.value != blank -%}
    <ul class="barkin-benefits-list">
      {%- for beneficio in beneficios_obj.beneficios.value -%}
        <li class="barkin-benefits-list__item"><img class="g4u-benefit-check" src="{{ 'g4u-icon-check.svg' | asset_url }}" alt="" width="20" height="20">{{ beneficio | escape }}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>
