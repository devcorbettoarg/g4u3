{%- liquid
  assign intro = product.metafields.custom.product_intro.value | default: block.settings.intro
  assign metafield_benefits = product.metafields.custom.lista_beneficios.value
-%}

<div class="g4u-product-highlights" {{ block.shopify_attributes }}>
  {%- if intro != blank -%}
    <p class="g4u-product-highlights__intro">{{product.metafields.custom.description}}</p>
  {%- endif -%}

  <ul>
    {%- if metafield_benefits != blank -%}
      {%- for benefit in metafield_benefits limit: 6 -%}
        {%- liquid
          assign benefit_label = benefit.title.value | default: benefit.title | default: benefit
        -%}
        {%- if benefit_label != blank -%}<li>{{ benefit_label | escape }}</li>{%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- for index in (1..6) -%}
        {%- assign benefit_setting = 'benefit_' | append: index -%}
        {%- assign benefit = block.settings[benefit_setting] -%}
        {%- if benefit != blank -%}<li>{{ benefit | escape }}</li>{%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </ul>
</div>
