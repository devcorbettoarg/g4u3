{%- comment -%}
  Shared PDP shipping copy. Product-specific shipping overrides are resolved by
  the accordion before rendering this snippet. A linked page replaces block copy.
{%- endcomment -%}
<div class="g4u-shipping-information">
  {%- if block.settings.page != blank -%}
    {{ block.settings.page.content }}
  {%- else -%}
    {{ block.settings.content }}
  {%- endif -%}
  {%- unless block.settings.show_free_shipping == false -%}
    {%- assign shipping_goal = settings.free_shipping_threshold | default: 60000 | times: 100 -%}
    {%- if shipping_goal <= 0 -%}{%- assign shipping_goal = 6000000 -%}{%- endif -%}
    <ul>
      <li>Envío gratis a partir de {{ shipping_goal | money_without_trailing_zeros }}.</li>
    </ul>
  {%- endunless -%}
</div>
