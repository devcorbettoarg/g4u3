<g4u-sticky-cart class="g4u-sticky-cart" data-section-id="{{ section_id }}" hidden>
  {%- if product.featured_image -%}
    {{ product.featured_image | image_url: width: 120 | image_tag: class: 'g4u-sticky-cart__image', loading: 'lazy', alt: '' }}
  {%- endif -%}
  <div class="g4u-sticky-cart__info">
    <p class="g4u-sticky-cart__title">{{ product.title | split: '|' | first | strip | escape }}</p>
    <div data-sticky-price>{% render 'price', product: product, use_variant: true %}</div>
  </div>
  <button type="button" class="button button--primary g4u-sticky-cart__button" data-sticky-submit>
    {{ 'products.product.add_to_cart' | t }}
  </button>
</g4u-sticky-cart>
