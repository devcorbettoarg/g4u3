{% comment %}
  Renders share button.
  Accepts:
  - block: {Object} passes in the block information.
  - share_link: {String} url to be added to the input the user will get/copy.

  Usage:
  {% render 'share-button',
    block: block,
    share_link: share_url
  %}
{% endcomment %}
<script src="{{ 'share.js' | asset_url }}" defer="defer"></script>

<share-button id="Share-{{ section.id }}" class="share-button quick-add-hidden" {{ block.shopify_attributes }}>
  <div class="g4u-product-payments" aria-label="Medios de pago aceptados">
    <span>Pagá con</span>
    <ul role="list">
      {%- for type in shop.enabled_payment_types limit: 4 -%}
        <li>{{ type | payment_type_svg_tag }}</li>
      {%- endfor -%}
    </ul>
  </div>
  <div class="g4u-product-share-row">
    <span>{{ block.settings.share_label | escape }}</span>
    <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ share_link | url_encode }}" target="_blank" rel="noopener" aria-label="Compartir en LinkedIn"><svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M3.4 5.3H.6V15h2.8V5.3ZM2 1A1.7 1.7 0 1 0 2 4.4 1.7 1.7 0 0 0 2 1Zm6 4.3H5.3V15H8v-4.8c0-1.3.2-2.5 1.8-2.5 1.5 0 1.6 1.4 1.6 2.6V15h2.8V9.7c0-2.6-.6-4.7-3.7-4.7A3.2 3.2 0 0 0 7.8 6.5H8V5.3Z"/></svg></a>
    <a href="https://www.facebook.com/sharer/sharer.php?u={{ share_link | url_encode }}" target="_blank" rel="noopener" aria-label="Compartir en Facebook">{{- 'icon-facebook.svg' | inline_asset_content -}}</a>
    <a href="https://twitter.com/intent/tweet?url={{ share_link | url_encode }}" target="_blank" rel="noopener" aria-label="Compartir en X"><svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M12.6 1h2.5l-5.4 6.2L16 15h-4.9L7.3 10.3 3.2 15H.7l5.4-6.3L0 1h5l3.4 4.3L12.6 1Zm-.9 12.6h1.4L4.2 2.3H2.7l9 11.3Z"/></svg></a>
    <a href="https://wa.me/?text={{ share_link | url_encode }}" target="_blank" rel="noopener" aria-label="Compartir por WhatsApp"><svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M13.6 2.3A7.7 7.7 0 0 0 1.5 11.6L.4 15.5l4-1a7.7 7.7 0 0 0 3.7.9A7.8 7.8 0 0 0 13.6 2.3ZM8.1 14a6.4 6.4 0 0 1-3.3-.9l-.2-.1-2.4.6.6-2.3-.2-.3A6.3 6.3 0 1 1 8.1 14Zm3.5-4.7c-.2-.1-1.1-.6-1.3-.6-.2-.1-.3-.1-.5.1l-.6.8c-.1.2-.3.2-.5.1a5.2 5.2 0 0 1-1.6-1 5.7 5.7 0 0 1-1.1-1.4c-.1-.2 0-.4.1-.5l.4-.5.2-.4c.1-.2 0-.3 0-.4L6.1 4c-.2-.5-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.3-.8.8-.8 2s.8 2.3.9 2.5c.1.2 1.7 2.6 4.1 3.6.6.2 1 .4 1.4.5.6.2 1.1.2 1.5.1.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .2-1.1-.1-.1-.2-.2-.4-.3l-1.4-.8Z"/></svg></a>
  </div>
  <button class="share-button__button hidden">
    <span class="svg-wrapper">{{ 'icon-share.svg' | inline_asset_content }}</span>
    {{ block.settings.share_label | escape }}
  </button>
  <details id="Details-{{ block.id }}-{{ section.id }}" class="visually-hidden">
    <summary class="share-button__button">
      <span class="svg-wrapper">{{ 'icon-share.svg' | inline_asset_content }}</span>
      {{ block.settings.share_label | escape }}
    </summary>
    <div class="share-button__fallback motion-reduce">
      <div class="field">
        <span id="ShareMessage-{{ section.id }}" class="share-button__message hidden" role="status"> </span>
        <input
          type="text"
          class="field__input"
          id="ShareUrl-{{ section.id }}"
          value="{{ share_link }}"
          placeholder="{{ 'general.share.share_url' | t }}"
          onclick="this.select();"
          readonly
        >
        <label class="field__label" for="ShareUrl-{{ section.id }}">{{ 'general.share.share_url' | t }}</label>
      </div>
      <button class="share-button__close hidden">
        <span class="svg-wrapper">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
        <span class="visually-hidden">{{ 'general.share.close' | t }}</span>
      </button>
      <button class="share-button__copy">
        <span class="svg-wrapper">
          {{- 'icon-copy.svg' | inline_asset_content -}}
        </span>
        <span class="visually-hidden">{{ 'general.share.copy_to_clipboard' | t }}</span>
      </button>
    </div>
  </details>
</share-button>
