{%- assign fallback_image = 'g4u-feel-good.jpg' -%}

{%- if section.settings.fallback_image == 'about_flour' -%}
  {%- assign fallback_image = 'g4u-about-flour-cta.png' -%}
{%- endif -%}

<style>
  /* ==========================================
     G4U · Sentite bien — Cinematic reveal
     ========================================== */

  @keyframes g4uFeelGoodImageReveal {
    0% {
      opacity: 0;
      transform: translateY(20px) scale(1.07);
    }

    45% {
      opacity: 1;
    }

    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .animate__g4uFeelGoodImageReveal {
    animation-name: g4uFeelGoodImageReveal;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    transform-origin: center center;
    will-change: transform, opacity;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate__g4uFeelGoodImageReveal {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<section
  class="g4u-feel-good"
  aria-labelledby="G4uFeelGood-{{ section.id }}"
>

  {%- if section.settings.image != blank -%}

    {{
      section.settings.image
      | image_url: width: 3000
      | image_tag:
        class: 'g4u-feel-good__image wow animate__g4uFeelGoodImageReveal',
        loading: 'lazy',
        widths: '750, 1100, 1500, 2000, 2500, 3000',
        sizes: '100vw'
    }}

  {%- else -%}

    <img
      class="g4u-feel-good__image wow animate__g4uFeelGoodImageReveal"
      src="{{ fallback_image | asset_url }}"
      alt="{{ section.settings.image_alt | escape }}"
      width="2000"
      height="1333"
      loading="lazy"
      data-wow-duration="1.15s"
    >

  {%- endif -%}

  <div class="g4u-feel-good__content">

    <h2
      class="g4u-feel-good__title g4u-display wow animate__fadeInUp"
      id="G4uFeelGood-{{ section.id }}"
      data-wow-duration="0.8s"
      data-wow-delay="0.10s"
    >
      {{ section.settings.heading | escape }}

      <span class="g4u-feel-good__accent">
        {{ section.settings.accent_heading | escape }}
      </span>
    </h2>

    <div
      class="g4u-feel-good__text rte wow animate__fadeIn"
      data-wow-duration="0.75s"
      data-wow-delay="0.22s"
    >
      {{ section.settings.text }}
    </div>

    {%- if section.settings.button_label != blank -%}

      <a
        class="g4u-pill g4u-feel-good__button wow animate__fadeInUp"
        href="{{ section.settings.button_link | default: routes.root_url }}"
        data-wow-duration="0.7s"
        data-wow-delay="0.32s"
      >
        {{ section.settings.button_label | escape }}
      </a>

    {%- endif -%}

  </div>

</section>

{% schema %}
{
  "name": "G4U · Sentite bien",
  "tag": "section",
  "class": "section-g4u-feel-good",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "select",
      "id": "fallback_image",
      "label": "Imagen predeterminada",
      "options": [
        {
          "value": "feel_good",
          "label": "Sentite bien"
        },
        {
          "value": "about_flour",
          "label": "Harina · Nosotros"
        }
      ],
      "default": "feel_good"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Descripción de imagen",
      "default": "Mesa compartida con panes G4U"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Sentite bien,"
    },
    {
      "type": "text",
      "id": "accent_heading",
      "label": "Título destacado",
      "default": "comiendo rico"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>En G4U combinamos tecnología alimentaria avanzada y sabor artesanal.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Conocé nuestra harina"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    }
  ],
  "presets": [
    {
      "name": "G4U · Sentite bien"
    }
  ]
}
{% endschema %}