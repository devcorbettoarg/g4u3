<script src="{{ 'g4u-scroll-carousel.js' | asset_url }}" defer="defer"></script>

<g4u-scroll-carousel
  class="g4u-experts"
  role="region"
  aria-labelledby="G4uExperts-{{ section.id }}"
>

  <header class="g4u-experts__header">

    <div class="g4u-experts__heading">

      <p
        class="g4u-experts__eyebrow wow animate__fadeIn"
        data-wow-duration="0.6s"
      >
        {{ section.settings.eyebrow | escape }}
      </p>

      <h2
        class="g4u-experts__title g4u-display wow animate__fadeInUp"
        id="G4uExperts-{{ section.id }}"
        data-wow-duration="0.8s"
        data-wow-delay="0.06s"
      >
        {{ section.settings.title | escape }}
      </h2>

      <div
        class="g4u-experts__intro rte wow animate__fadeInUp"
        data-wow-duration="0.75s"
        data-wow-delay="0.14s"
      >
        {{ section.settings.description }}
      </div>

    </div>

    <div
      class="g4u-experts__controls wow animate__fadeIn"
      data-wow-duration="0.65s"
      data-wow-delay="0.22s"
    >

      <button
        class="g4u-experts__arrow"
        type="button"
        data-g4u-scroll-prev
        aria-label="Recomendación anterior"
      >
        <img
          src="{{ 'g4u-icon-arrow-back.svg' | asset_url }}"
          alt=""
          width="24"
          height="24"
        >
      </button>

      <button
        class="g4u-experts__arrow"
        type="button"
        data-g4u-scroll-next
        aria-label="Recomendación siguiente"
      >
<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M8.14453 0.5C8.21548 0.500668 8.27733 0.517317 8.33887 0.560547L8.40039 0.613281L15.3486 7.56152C15.4018 7.61569 15.4275 7.65782 15.4395 7.68652V7.6875C15.4546 7.72385 15.4629 7.7639 15.4629 7.81152C15.4629 7.85913 15.4543 7.89825 15.4395 7.93359V7.93457C15.4276 7.96304 15.4022 8.00538 15.3486 8.05957L8.39453 15.0078C8.30318 15.0981 8.22456 15.124 8.1416 15.124C8.0609 15.1239 7.98874 15.0994 7.90527 15.0137L7.90039 15.0088L7.84863 14.9482C7.80653 14.8886 7.79201 14.8306 7.79199 14.7656C7.79199 14.701 7.80676 14.6433 7.84863 14.584L7.90039 14.5234L14.2617 8.16211H0.851562C0.729469 8.16207 0.657228 8.12693 0.59668 8.06641H0.595703C0.53483 8.0055 0.500002 7.93257 0.5 7.81055C0.5 7.68853 0.534835 7.6156 0.595703 7.55469H0.59668C0.657231 7.49416 0.729461 7.45902 0.851562 7.45898H14.2617L7.90625 1.10352C7.84494 1.04216 7.81315 0.983763 7.80078 0.918945L7.79492 0.851562C7.79401 0.761613 7.82017 0.688031 7.90039 0.607422L7.90137 0.606445C7.98151 0.525858 8.05487 0.499224 8.14453 0.5Z" fill="#26131B" stroke="#26131B"/>
</svg>

      </button>

    </div>

  </header>


  <ul
    class="g4u-experts__track wow animate__fadeInUp"
    data-g4u-scroll-track
    role="list"
    data-wow-duration="0.85s"
    data-wow-delay="0.16s"
  >

    {%- for block in section.blocks -%}

      {%- liquid
        assign fallback_media = 'g4u-expert-alejandra.png'
        assign fallback_avatar = 'g4u-expert-alejandra-avatar.png'

        if forloop.index == 2 or forloop.index == 4
          assign fallback_media = 'g4u-expert-roxana.png'
          assign fallback_avatar = 'g4u-expert-roxana-avatar.png'
        endif
      -%}

      <li
        class="g4u-expert-card"
        {{ block.shopify_attributes }}
      >

        <div class="g4u-expert-card__media">

          {%- if block.settings.media != blank -%}

            {{
              block.settings.media
              | image_url: width: 1200
              | image_tag:
                class: 'g4u-expert-card__image',
                loading: 'lazy',
                widths: '500, 750, 1000, 1200',
                sizes: '(min-width: 750px) 332px, 88vw'
            }}

          {%- else -%}

            <img
              class="g4u-expert-card__image"
              src="{{ fallback_media | replace: '.png', '.webp' | asset_url }}"
              alt="{{ block.settings.name | escape }}"
              width="900"
              height="1593"
              loading="lazy"
            >

          {%- endif -%}


          {%- if block.settings.video_url != blank -%}

            <a
              href="{{ block.settings.video_url }}"
              aria-label="Ver video de {{ block.settings.name | escape }}"
            >
              <img
                class="g4u-expert-card__play"
                src="{{ 'g4u-icon-play.svg' | asset_url }}"
                alt=""
                width="64"
                height="64"
              >
            </a>

          {%- else -%}

            <img
              class="g4u-expert-card__play"
              src="{{ 'g4u-icon-play.svg' | asset_url }}"
              alt=""
              width="64"
              height="64"
            >

          {%- endif -%}

        </div>


        <blockquote class="g4u-expert-card__quote">

          <div class="g4u-expert-card__profile">

            {%- if block.settings.avatar != blank -%}

              {{
                block.settings.avatar
                | image_url: width: 160
                | image_tag:
                  class: 'g4u-expert-card__avatar',
                  loading: 'lazy'
              }}

            {%- else -%}

              <img
                class="g4u-expert-card__avatar"
                src="{{ fallback_avatar | asset_url }}"
                alt=""
                width="56"
                height="56"
                loading="lazy"
              >

            {%- endif -%}

            <div>

              <p class="g4u-expert-card__name">
                {{ block.settings.name | escape }}
              </p>

              <p class="g4u-expert-card__role">
                {{ block.settings.role | escape | newline_to_br }}
              </p>

            </div>

          </div>


          <hr class="g4u-expert-card__divider">


          <img
            class="g4u-expert-card__stars"
            src="{{ 'g4u-stars.svg' | asset_url }}"
            alt="5 estrellas"
            width="82"
            height="14"
          >


          <div class="g4u-expert-card__text">
            {{ block.settings.quote }}
          </div>


          {%- if block.settings.handle != blank -%}

            {%- if block.settings.profile_link != blank -%}

              <a
                class="g4u-expert-card__handle"
                href="{{ block.settings.profile_link }}"
              >
                {{ block.settings.handle | escape }}
              </a>

            {%- else -%}

              <span class="g4u-expert-card__handle">
                {{ block.settings.handle | escape }}
              </span>

            {%- endif -%}

          {%- endif -%}

        </blockquote>

      </li>

    {%- endfor -%}

  </ul>

</g4u-scroll-carousel>


{% schema %}
{
  "name": "G4U · Profesionales",
  "tag": "section",
  "class": "section-g4u-experts",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Respaldo profesional"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Profesionales que nos recomiendan"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción",
      "default": "<p>Nutricionistas y especialistas en alimentación confían en G4U por su perfil nutricional y lo incorporan como una herramienta dentro de una alimentación equilibrada.</p>"
    }
  ],
  "blocks": [
    {
      "type": "expert",
      "name": "Profesional",
      "settings": [
        {
          "type": "image_picker",
          "id": "media",
          "label": "Imagen principal"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Enlace al video"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nombre",
          "default": "Dra. Alejandra Moisello"
        },
        {
          "type": "textarea",
          "id": "role",
          "label": "Especialidad",
          "default": "Especialista en Nutrición y Medicina del deporte"
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Recomendación",
          "default": "<p>Recomiendo los productos de G4U por su excelente aporte de fibra y proteínas.</p>"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Usuario social",
          "default": "@Dra.alejandramoisello"
        },
        {
          "type": "url",
          "id": "profile_link",
          "label": "Perfil social"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "G4U · Profesionales",
      "blocks": [
        {
          "type": "expert"
        },
        {
          "type": "expert"
        }
      ]
    }
  ]
}
{% endschema %}