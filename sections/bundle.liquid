      animation-duration: .01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: .01ms !important;
    }
  }
</style>

<script>
  (() => {
    const ROOT_ID = 'PackBuilder-{{ section.id }}';
    const root = document.getElementById(ROOT_ID);
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const state = new Map();
    const tabs = [...root.querySelectorAll('[data-tab]')];
    const panels = [...root.querySelectorAll('[data-panel]')];
    const cards = [...root.querySelectorAll('[data-product-card]')];
    const summary = root.querySelector('.pb-summary');
    const summaryToggle = root.querySelector('[data-summary-toggle]');
    const submitButton = root.querySelector('[data-submit]');
    const submitLabel = root.querySelector('[data-submit-label]');
    const statusNode = root.querySelector('[data-status]');
    const progressMessage = root.querySelector('[data-progress-message]');
    const progressFill = root.querySelector('[data-progress-fill]');
    const progressDot = root.querySelector('[data-progress-dot]');
    const subtotalNode = root.querySelector('[data-subtotal]');
    const discountRow = root.querySelector('[data-discount-row]');
    const discountAmountNode = root.querySelector('[data-discount-amount]');
    const estimatedTotalNode = root.querySelector('[data-estimated-total]');
    const summaryCount = root.querySelector('[data-summary-count]');

    const settings = {
      currency: root.dataset.currency || 'USD',
      locale: root.dataset.locale || 'es',
      packName: root.dataset.packName || 'Armá tu pack',
      packKey: root.dataset.packKey || 'pack',
      enforceMinimums: root.dataset.enforceMinimums === 'true',
      afterAdd: root.dataset.afterAdd || 'drawer',
      resetAfterAdd: root.dataset.resetAfterAdd === 'true',
      levels: [
        { qty: Number(root.dataset.discount1Qty || 0), value: Number(root.dataset.discount1Value || 0) },
        { qty: Number(root.dataset.discount2Qty || 0), value: Number(root.dataset.discount2Value || 0) },
        { qty: Number(root.dataset.discount3Qty || 0), value: Number(root.dataset.discount3Value || 0) }
      ].filter(level => level.qty > 0).sort((a, b) => a.qty - b.qty)
    };

    const text = {
      add: {{ section.settings.add_to_pack_label | json }},
      soldOut: {{ section.settings.sold_out_label | json }},
      submit: {{ section.settings.submit_label | json }},
      loading: {{ section.settings.loading_label | json }},
      added: {{ section.settings.success_message | json }},
      error: {{ section.settings.error_message | json }},
      initialProgress: {{ section.settings.initial_progress_text | json }},
      complete: {{ section.settings.pack_complete_text | json }},
      addMorePrefix: {{ section.settings.add_more_prefix | json }},
      addMoreSuffix: {{ section.settings.add_more_suffix | json }},
      missingPrefix: {{ section.settings.missing_prefix | json }},
      missingJoin: {{ section.settings.missing_join | json }},
      defaultVariant: {{ section.settings.default_variant_label | json }}
    };

    const moneyFormatter = new Intl.NumberFormat(settings.locale, {
      style: 'currency',
      currency: settings.currency
    });

    const formatMoney = cents => moneyFormatter.format((Number(cents) || 0) / 100);

    const getVariantElement = card => card.querySelector('[data-variant-select]');

    const getVariantData = card => {
      const control = getVariantElement(card);
      if (!control) return null;

      const source = control.tagName === 'SELECT'
        ? control.options[control.selectedIndex]
        : control;

      if (!source || !source.value) return null;

      return {
        id: String(source.value),
        price: Number(source.dataset.price || 0),
        priceFormatted: source.dataset.priceFormatted || formatMoney(source.dataset.price || 0),
        available: source.dataset.available !== 'false',
        variantTitle: source.dataset.title || '',
        image: source.dataset.image || card.querySelector('.pb-card__image')?.currentSrc || card.querySelector('.pb-card__image')?.src || '',
        productTitle: card.dataset.productTitle || '',
        productId: card.dataset.productId || '',
        category: card.dataset.category || '',
        categoryTitle: card.dataset.categoryTitle || ''
      };
    };

    const getCategoryConfiguration = () => {
      return panels.map(panel => ({
        id: panel.dataset.panel,
        title: panel.dataset.categoryTitle || panel.dataset.panel,
        minimum: Number(panel.dataset.categoryMinimum || 0)
      }));
    };

    const getTotals = () => {
      let quantity = 0;
      let subtotal = 0;
      const byCategory = {};

      state.forEach(item => {
        quantity += item.quantity;
        subtotal += item.price * item.quantity;
        byCategory[item.category] = (byCategory[item.category] || 0) + item.quantity;
      });

      return { quantity, subtotal, byCategory };
    };

    const getDiscount = quantity => {
      let current = { qty: 0, value: 0 };
      settings.levels.forEach(level => {
        if (quantity >= level.qty) current = level;
      });
      return current;
    };

    const getNextDiscount = quantity => {
      return settings.levels.find(level => quantity < level.qty) || null;
    };

    const getMissingCategories = totals => {
      return getCategoryConfiguration()
        .filter(category => (totals.byCategory[category.id] || 0) < category.minimum)
        .map(category => ({
          ...category,
          missing: Math.max(category.minimum - (totals.byCategory[category.id] || 0), 0)
        }));
    };

    const setStatus = (message, isError = false) => {
      if (!statusNode) return;
      statusNode.textContent = message || '';
      statusNode.style.color = isError ? '#b42318' : '';
    };

    const activateTab = (category, focus = false) => {
      tabs.forEach(tab => {
        const active = tab.dataset.tab === category;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && focus) tab.focus();
      });

      panels.forEach(panel => {
        const active = panel.dataset.panel === category;
        panel.classList.toggle('is-active', active);
        panel.hidden = !active;
      });
    };

    const moveTab = direction => {
      if (!tabs.length) return;
      const currentIndex = Math.max(tabs.findIndex(tab => tab.classList.contains('is-active')), 0);
      const nextIndex = (currentIndex + direction + tabs.length) % tabs.length;
      activateTab(tabs[nextIndex].dataset.tab, true);
    };

    const scrollProducts = direction => {
      const activePanel = panels.find(panel => !panel.hidden);
      const grid = activePanel?.querySelector('.pb__grid');
      const firstCard = grid?.querySelector('[data-product-card]');
      if (!grid || !firstCard) return;

      const gap = Number.parseFloat(getComputedStyle(grid).columnGap || getComputedStyle(grid).gap || 0);
      const distance = firstCard.getBoundingClientRect().width + gap;
      grid.scrollBy({ left: distance * direction, behavior: 'smooth' });
    };

    const updateCard = card => {
      const variant = getVariantData(card);
      if (!variant) return;

      const item = state.get(variant.id);
      const quantity = item?.quantity || 0;
      const addButton = card.querySelector('[data-add-item]');
      const quantityControl = card.querySelector('[data-card-quantity]');
      const quantityValue = card.querySelector('[data-card-quantity-value]');
      const priceNode = card.querySelector('[data-card-price]');

      if (priceNode) priceNode.textContent = variant.priceFormatted;
      if (quantityValue) quantityValue.textContent = quantity;

      if (quantity > 0) {
        addButton.hidden = true;
        quantityControl.hidden = false;
      } else {
        addButton.hidden = false;
        quantityControl.hidden = true;
        addButton.disabled = !variant.available;
        addButton.textContent = variant.available ? text.add : text.soldOut;
      }
    };

    const updateAllCards = () => cards.forEach(updateCard);

    const createSelectedItem = item => {
      const row = document.createElement('div');
      row.className = 'pb-selected';
      row.dataset.selectedVariant = item.id;

      const media = item.image
        ? `<img class="pb-selected__image" src="${escapeHtml(item.image)}" alt="" loading="lazy">`
        : `<span class="pb-selected__fallback" aria-hidden="true">IMG</span>`;

      const variantTitle = item.variantTitle && item.variantTitle !== text.defaultVariant
        ? `<div class="pb-selected__variant">${escapeHtml(item.variantTitle)}</div>`
        : '';

      row.innerHTML = `
        ${media}
        <div class="pb-selected__info">
          <p class="pb-selected__title">${escapeHtml(item.productTitle)}</p>
          ${variantTitle}
          <div class="pb-selected__price">${formatMoney(item.price * item.quantity)}</div>
        </div>
        <div class="pb-selected__controls">
          <button type="button" data-selected-minus aria-label={{ section.settings.decrease_label | json }}>−</button>
          <span>${item.quantity}</span>
          <button type="button" data-selected-plus aria-label={{ section.settings.increase_label | json }}>+</button>
        </div>
      `;

      row.querySelector('[data-selected-minus]').addEventListener('click', () => changeQuantity(item.id, -1));
      row.querySelector('[data-selected-plus]').addEventListener('click', () => changeQuantity(item.id, 1));

      return row;
    };

    const renderSummaryGroups = totals => {
      root.querySelectorAll('[data-summary-group]').forEach(group => {
        const category = group.dataset.summaryGroup;
        const itemsContainer = group.querySelector('[data-category-items]');
        const empty = group.querySelector('[data-group-empty]');
        const categoryCount = group.querySelector('[data-category-count]');
        const categoryItems = [...state.values()].filter(item => item.category === category);

        if (categoryCount) categoryCount.textContent = totals.byCategory[category] || 0;
        itemsContainer.querySelectorAll('[data-selected-variant]').forEach(node => node.remove());

        if (categoryItems.length) {
          empty.hidden = true;
          categoryItems.forEach(item => itemsContainer.appendChild(createSelectedItem(item)));
        } else {
          empty.hidden = false;
        }
      });
    };

    const updateProgress = totals => {
      const maxLevel = settings.levels[settings.levels.length - 1]?.qty || 1;
      const percentage = Math.min((totals.quantity / maxLevel) * 100, 100);
      const currentDiscount = getDiscount(totals.quantity);
      const nextDiscount = getNextDiscount(totals.quantity);
      const missingCategories = getMissingCategories(totals);

      if (progressFill) progressFill.style.width = `${percentage}%`;
      if (progressDot) progressDot.style.left = `${percentage}%`;

      root.querySelectorAll('[data-level]').forEach((node, index) => {
        const level = settings.levels[index];
        node.classList.toggle('is-reached', Boolean(level && totals.quantity >= level.qty));
      });

      if (settings.enforceMinimums && missingCategories.length) {
        const missingText = missingCategories
          .map(category => `${category.missing} ${category.title}`)
          .join(text.missingJoin);
        progressMessage.textContent = `${text.missingPrefix}${missingText}`;
      } else if (nextDiscount) {
        progressMessage.textContent = `${text.addMorePrefix}${nextDiscount.qty - totals.quantity}${text.addMoreSuffix}${nextDiscount.value}%`;
      } else if (currentDiscount.value > 0) {
        progressMessage.textContent = `${text.complete} ${currentDiscount.value}% off`;
      } else {
        progressMessage.textContent = text.initialProgress;
      }
    };

    const updateTotals = totals => {
      const discount = getDiscount(totals.quantity);
      const discountAmount = Math.round(totals.subtotal * (discount.value / 100));
      const estimatedTotal = totals.subtotal - discountAmount;

      subtotalNode.textContent = formatMoney(totals.subtotal);
      estimatedTotalNode.textContent = formatMoney(estimatedTotal);
      discountAmountNode.textContent = `−${formatMoney(discountAmount)}`;
      discountRow.hidden = discountAmount <= 0;
      summaryCount.textContent = totals.quantity;

      const missingCategories = getMissingCategories(totals);
      const canSubmit = totals.quantity > 0 && (!settings.enforceMinimums || missingCategories.length === 0);
      submitButton.disabled = !canSubmit;
    };

    const render = () => {
      const totals = getTotals();
      updateAllCards();
      renderSummaryGroups(totals);
      updateProgress(totals);
      updateTotals(totals);
      setStatus('');
    };

    const changeQuantity = (variantId, delta, variantData = null) => {
      const current = state.get(String(variantId));
      const nextQuantity = Math.max((current?.quantity || 0) + delta, 0);

      if (nextQuantity === 0) {
        state.delete(String(variantId));
      } else if (current) {
        current.quantity = nextQuantity;
        state.set(String(variantId), current);
      } else if (variantData) {
        state.set(String(variantId), { ...variantData, quantity: nextQuantity });
      }

      render();
    };

    const escapeHtml = value => String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');

    const getCartSectionIds = () => {
      const ids = new Set();

      const dawnDrawer = document.querySelector('cart-drawer');
      if (dawnDrawer && typeof dawnDrawer.getSectionsToRender === 'function') {
        dawnDrawer.getSectionsToRender().forEach(section => {
          if (section?.id) ids.add(section.id);
        });
      }

      document.querySelectorAll('cart-items-component[data-section-id]').forEach(component => {
        if (component.dataset.sectionId) ids.add(component.dataset.sectionId);
      });

      if (document.getElementById('cart-icon-bubble')) ids.add('cart-icon-bubble');

      return [...ids];
    };

    const refreshGenericCartCount = async () => {
      try {
        const rootRoute = window.Shopify?.routes?.root || '/';
        const response = await fetch(`${rootRoute}cart.js`, {
          headers: { Accept: 'application/json' }
        });
        if (!response.ok) return;
        const cart = await response.json();

        document.querySelectorAll('[data-cart-count], .cart-count-bubble span[aria-hidden="true"]').forEach(node => {
          node.textContent = cart.item_count;
        });
      } catch (error) {
        console.warn('[Pack Builder] No se pudo actualizar el contador del carrito.', error);
      }
    };

    const updateThemeCart = async response => {
      let handled = false;

      const dawnDrawer = document.querySelector('cart-drawer');
      if (dawnDrawer && typeof dawnDrawer.renderContents === 'function' && response.sections) {
        const parsedState = {
          ...response,
          id: response.id || response.items?.[0]?.id || null
        };
        dawnDrawer.renderContents(parsedState);
        handled = true;
      }

      const dawnNotification = document.querySelector('cart-notification');
      if (!handled && dawnNotification && typeof dawnNotification.renderContents === 'function' && response.sections) {
        dawnNotification.renderContents({
          ...response,
          id: response.id || response.items?.[0]?.id || null
        });
        handled = true;
      }

      const horizonCartComponents = [...document.querySelectorAll('cart-items-component')];
      if (horizonCartComponents.length) {
        await Promise.allSettled(
          horizonCartComponents.map(component => {
            if (typeof component.fetchCartData === 'function') return component.fetchCartData();
            return Promise.resolve();
          })
        );

        const horizonDrawerComponent = document.querySelector('cart-drawer-component');
        const themeDrawer = horizonDrawerComponent?.closest('theme-drawer') || document.querySelector('theme-drawer');
        if (settings.afterAdd === 'drawer') {
          if (themeDrawer && typeof themeDrawer.open === 'function') {
            themeDrawer.open();
          } else if (themeDrawer) {
            themeDrawer.setAttribute('open', '');
          }
        }
        handled = true;
      }

      await refreshGenericCartCount();
      document.dispatchEvent(new CustomEvent('cart:refresh', {
        bubbles: true,
        detail: { source: 'pack-builder', response }
      }));

      return handled;
    };

    const addPackToCart = async () => {
      const totals = getTotals();
      const missingCategories = getMissingCategories(totals);

      if (!totals.quantity || (settings.enforceMinimums && missingCategories.length)) {
        render();
        return;
      }

      submitButton.disabled = true;
      submitButton.classList.add('is-loading');
      submitLabel.textContent = text.loading;
      setStatus('');

      const packInstance = `${settings.packKey}-${Date.now()}`;
      const items = [...state.values()].map(item => ({
        id: Number(item.id),
        quantity: item.quantity,
        properties: {
          _pack_id: packInstance,
          _pack_name: settings.packName,
          _pack_category: item.category
        }
      }));

      const sectionIds = getCartSectionIds();
      const payload = { items };

      if (sectionIds.length) {
        payload.sections = sectionIds.join(',');
        payload.sections_url = window.location.pathname;
      }

      try {
        const rootRoute = window.Shopify?.routes?.root || '/';
        const response = await fetch(`${rootRoute}cart/add.js`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json'
          },
          body: JSON.stringify(payload)
        });

        const data = await response.json();

        if (!response.ok || data.status) {
          throw new Error(data.description || data.message || text.error);
        }

        await updateThemeCart(data);
        setStatus(text.added);

        if (settings.resetAfterAdd) {
          state.clear();
          render();
        }

        if (settings.afterAdd === 'cart') {
          window.location.href = `${rootRoute}cart`;
          return;
        }

        if (settings.afterAdd === 'drawer') {
          const dawnDrawer = document.querySelector('cart-drawer');
          if (dawnDrawer && typeof dawnDrawer.open === 'function' && !dawnDrawer.classList.contains('active')) {
            dawnDrawer.open(submitButton);
          }
        }
      } catch (error) {
        console.error('[Pack Builder]', error);
        setStatus(error.message || text.error, true);
      } finally {
        submitButton.classList.remove('is-loading');
        submitLabel.textContent = text.submit;
        const refreshedTotals = getTotals();
        const missing = getMissingCategories(refreshedTotals);
        submitButton.disabled = refreshedTotals.quantity === 0 || (settings.enforceMinimums && missing.length > 0);
      }
    };

    tabs.forEach(tab => {
      tab.addEventListener('click', () => activateTab(tab.dataset.tab));
      tab.addEventListener('keydown', event => {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          moveTab(1);
        }
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          moveTab(-1);
        }
      });
    });

    root.querySelector('[data-tab-prev]')?.addEventListener('click', () => scrollProducts(-1));
    root.querySelector('[data-tab-next]')?.addEventListener('click', () => scrollProducts(1));

    cards.forEach(card => {
      card.querySelector('[data-add-item]')?.addEventListener('click', () => {
        const variant = getVariantData(card);
        if (!variant?.available) return;
        changeQuantity(variant.id, 1, variant);
      });

      card.querySelector('[data-card-minus]')?.addEventListener('click', () => {
        const variant = getVariantData(card);
        if (!variant) return;
        changeQuantity(variant.id, -1, variant);
      });

      card.querySelector('[data-card-plus]')?.addEventListener('click', () => {
        const variant = getVariantData(card);
        if (!variant?.available) return;
        changeQuantity(variant.id, 1, variant);
      });

      const variantSelect = card.querySelector('select[data-variant-select]');
      variantSelect?.addEventListener('change', () => updateCard(card));
    });

    summaryToggle?.addEventListener('click', () => {
      const isOpen = summary.classList.toggle('is-open');
      summaryToggle.setAttribute('aria-expanded', String(isOpen));
    });

    submitButton?.addEventListener('click', addPackToCart);

    document.addEventListener('shopify:section:unload', event => {
      if (event.detail?.sectionId === root.dataset.sectionId) {
        root.dataset.initialized = 'false';
      }
    });

    render();
  })();
</script>

