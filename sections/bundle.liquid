{% comment %}
  Pack Builder nativo para Shopify
  Compatible con themes Online Store 2.0, incluido Dawn y Horizon.
  Instalar como: sections/pack-builder.liquid
{% endcomment %}

{%- liquid
  assign has_collections = false
  if section.settings.breakfast_collection != blank or section.settings.sandwich_collection != blank or section.settings.snacks_collection != blank
    assign has_collections = true
  endif
-%}

<section
  id="PackBuilder-{{ section.id }}"
  class="pb"
  data-section-id="{{ section.id }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  data-locale="{{ request.locale.iso_code | default: 'es' }}"
  data-pack-name="{{ section.settings.pack_name | escape }}"
  data-pack-key="{{ section.settings.pack_key | handleize }}"
  data-enforce-minimums="{{ section.settings.enforce_category_minimums }}"
  data-after-add="{{ section.settings.after_add_action }}"
  data-reset-after-add="{{ section.settings.reset_after_add }}"
  data-discount-1-qty="{{ section.settings.discount_1_qty }}"
  data-discount-1-value="{{ section.settings.discount_1_value }}"
  data-discount-2-qty="{{ section.settings.discount_2_qty }}"
  data-discount-2-value="{{ section.settings.discount_2_value }}"
  data-discount-3-qty="{{ section.settings.discount_3_qty }}"
  data-discount-3-value="{{ section.settings.discount_3_value }}"
  style="
    --pb-bg: {{ section.settings.background_color }};
    --pb-card: {{ section.settings.card_color }};
    --pb-panel: {{ section.settings.panel_color }};
    --pb-text: {{ section.settings.text_color }};
    --pb-muted: {{ section.settings.muted_color }};
    --pb-border: {{ section.settings.border_color }};
    --pb-accent: {{ section.settings.accent_color }};
    --pb-accent-contrast: {{ section.settings.accent_contrast }};
    --pb-radius: {{ section.settings.border_radius }}px;
    --pb-image-ratio: {{ section.settings.image_ratio }};
    --pb-max-width: {{ section.settings.max_width }}px;
  "
>
  <div class="pb__container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <header class="pb__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="pb__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="pb__subheading">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if has_collections -%}
      <div class="pb__layout">
        <div class="pb__catalog">
          <div class="pb__tabs-shell">
            <div class="pb__tabs" role="tablist" aria-label="{{ section.settings.tabs_aria_label | escape }}">
              {%- assign rendered_tabs = 0 -%}
              {%- for category_index in (1..3) -%}
                {%- liquid
                  case category_index
                    when 1
                      assign category_id = 'breakfast'
                      assign category_title = section.settings.breakfast_title
                      assign category_collection = section.settings.breakfast_collection
                      assign category_minimum = section.settings.breakfast_minimum
                    when 2
                      assign category_id = 'sandwich'
                      assign category_title = section.settings.sandwich_title
                      assign category_collection = section.settings.sandwich_collection
                      assign category_minimum = section.settings.sandwich_minimum
                    when 3
                      assign category_id = 'snacks'
                      assign category_title = section.settings.snacks_title
                      assign category_collection = section.settings.snacks_collection
                      assign category_minimum = section.settings.snacks_minimum
                  endcase
                -%}

                {%- if category_collection != blank -%}
                  {%- assign rendered_tabs = rendered_tabs | plus: 1 -%}
                  <button
                    type="button"
                    class="pb__tab{% if rendered_tabs == 1 %} is-active{% endif %}"
                    role="tab"
                    id="PackTab-{{ section.id }}-{{ category_id }}"
                    aria-controls="PackPanel-{{ section.id }}-{{ category_id }}"
                    aria-selected="{% if rendered_tabs == 1 %}true{% else %}false{% endif %}"
                    tabindex="{% if rendered_tabs == 1 %}0{% else %}-1{% endif %}"
                    data-tab="{{ category_id }}"
                    data-minimum="{{ category_minimum }}"
                  >
                    <span class="pb__tab-icon" aria-hidden="true">
                      {%- case category_index -%}
                        {%- when 1 -%}
                          <svg viewBox="0 0 24 24" fill="none">
                            <path d="M7 4h10l2 5v10H5V9l2-5Z" stroke="currentColor" stroke-width="1.5"/>
                            <path d="M9 8h6M9 12h6M9 16h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                          </svg>
                        {%- when 2 -%}
                          <svg viewBox="0 0 24 24" fill="none">
                            <path d="M4 10.5c0-3 3.6-5.5 8-5.5s8 2.5 8 5.5H4Z" stroke="currentColor" stroke-width="1.5"/>
                            <path d="M5 13h14M5 16h14M6 19h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                          </svg>
                        {%- when 3 -%}
                          <svg viewBox="0 0 24 24" fill="none">
                            <path d="M7 5h10l1 14H6L7 5Z" stroke="currentColor" stroke-width="1.5"/>
                            <path d="M9 9h6M9 13h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                          </svg>
                      {%- endcase -%}
                    </span>
                    <span>{{ category_title }}</span>
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>

            <div class="pb__tab-arrows" aria-label="{{ section.settings.navigation_aria_label | escape }}">
              <button type="button" class="pb__arrow" data-tab-prev aria-label="{{ section.settings.previous_label | escape }}">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="m15 5-7 7 7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <button type="button" class="pb__arrow pb__arrow--accent" data-tab-next aria-label="{{ section.settings.next_label | escape }}">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </div>

          <div class="pb__panels">
            {%- assign rendered_panels = 0 -%}
            {%- for category_index in (1..3) -%}
              {%- liquid
                case category_index
                  when 1
                    assign category_id = 'breakfast'
                    assign category_title = section.settings.breakfast_title
                    assign category_collection = section.settings.breakfast_collection
                    assign category_minimum = section.settings.breakfast_minimum
                  when 2
                    assign category_id = 'sandwich'
                    assign category_title = section.settings.sandwich_title
                    assign category_collection = section.settings.sandwich_collection
                    assign category_minimum = section.settings.sandwich_minimum
                  when 3
                    assign category_id = 'snacks'
                    assign category_title = section.settings.snacks_title
                    assign category_collection = section.settings.snacks_collection
                    assign category_minimum = section.settings.snacks_minimum
                endcase
              -%}

              {%- if category_collection != blank -%}
                {%- assign rendered_panels = rendered_panels | plus: 1 -%}
                <div
                  class="pb__panel{% if rendered_panels == 1 %} is-active{% endif %}"
                  role="tabpanel"
                  id="PackPanel-{{ section.id }}-{{ category_id }}"
                  aria-labelledby="PackTab-{{ section.id }}-{{ category_id }}"
                  data-panel="{{ category_id }}"
                  data-category-title="{{ category_title | escape }}"
                  data-category-minimum="{{ category_minimum }}"
                  {% unless rendered_panels == 1 %}hidden{% endunless %}
                >
                  <div class="pb__grid">
                    {%- for product in category_collection.products limit: section.settings.products_limit -%}
                      {%- assign selected_variant = product.selected_or_first_available_variant -%}
                      <article
                        class="pb-card"
                        data-product-card
                        data-category="{{ category_id }}"
                        data-category-title="{{ category_title | escape }}"
                        data-product-id="{{ product.id }}"
                        data-product-title="{{ product.title | escape }}"
                      >
                        <a class="pb-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                          {%- if product.featured_image != blank -%}
                            {{
                              product.featured_image
                              | image_url: width: 900
                              | image_tag:
                                loading: 'lazy',
                                widths: '240, 360, 540, 720, 900',
                                sizes: '(min-width: 990px) 28vw, (min-width: 750px) 45vw, 85vw',
                                class: 'pb-card__image',
                                alt: product.featured_image.alt
                            }}
                          {%- else -%}
                            {{ 'product-1' | placeholder_svg_tag: 'pb-card__placeholder' }}
                          {%- endif -%}
                        </a>

                        <div class="pb-card__body">
                          <h3 class="pb-card__title">
                            <a href="{{ product.url }}">{{ product.title }}</a>
                          </h3>

                          <div class="pb-card__price" data-card-price>
                            {{ selected_variant.price | money }}
                          </div>

                          {%- if product.variants.size > 1 -%}
                            <label class="pb-card__variant-label" for="PackVariant-{{ section.id }}-{{ product.id }}">
                              {{ section.settings.variant_label }}
                            </label>
                            <select
                              id="PackVariant-{{ section.id }}-{{ product.id }}"
                              class="pb-card__variant"
                              data-variant-select
                            >
                              {%- for variant in product.variants -%}
                                {%- assign variant_image = variant.featured_image | default: product.featured_image -%}
                                <option
                                  value="{{ variant.id }}"
                                  data-price="{{ variant.price }}"
                                  data-price-formatted="{{ variant.price | money | escape }}"
                                  data-available="{{ variant.available }}"
                                  data-title="{{ variant.title | escape }}"
                                  {% if variant_image != blank %}data-image="{{ variant_image | image_url: width: 320 }}"{% endif %}
                                  {% if variant.id == selected_variant.id %}selected{% endif %}
                                  {% unless variant.available %}disabled{% endunless %}
                                >
                                  {{ variant.title }}{% unless variant.available %} — {{ section.settings.sold_out_label }}{% endunless %}
                                </option>
                              {%- endfor -%}
                            </select>
                          {%- else -%}
                            <input
                              type="hidden"
                              data-variant-select
                              value="{{ selected_variant.id }}"
                              data-price="{{ selected_variant.price }}"
                              data-price-formatted="{{ selected_variant.price | money | escape }}"
                              data-available="{{ selected_variant.available }}"
                              data-title="{{ selected_variant.title | escape }}"
                              {% if selected_variant.featured_image != blank %}data-image="{{ selected_variant.featured_image | image_url: width: 320 }}"{% elsif product.featured_image != blank %}data-image="{{ product.featured_image | image_url: width: 320 }}"{% endif %}
                            >
                          {%- endif -%}

                          {%- if section.settings.show_tags and product.tags.size > 0 -%}
                            <div class="pb-card__tags" aria-label="{{ section.settings.tags_aria_label | escape }}">
                              {%- for tag in product.tags limit: 3 -%}
                                <span class="pb-card__tag">
                                  <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                    <path d="m2.5 8 5.2-5.2h4.8v4.8L7.3 12.8 2.5 8Z" stroke="currentColor" stroke-width="1.1"/>
                                    <circle cx="10.4" cy="4.9" r=".8" fill="currentColor"/>
                                  </svg>
                                  {{ tag }}
                                </span>
                              {%- endfor -%}
                            </div>
                          {%- endif -%}

                          <div class="pb-card__actions">
                            <button
                              type="button"
                              class="pb-card__add"
                              data-add-item
                              {% unless selected_variant.available %}disabled{% endunless %}
                            >
                              {% if selected_variant.available %}
                                {{ section.settings.add_to_pack_label }}
                              {% else %}
                                {{ section.settings.sold_out_label }}
                              {% endif %}
                            </button>

                            <div class="pb-card__quantity" data-card-quantity hidden>
                              <button type="button" data-card-minus aria-label="{{ section.settings.decrease_label | escape }}">−</button>
                              <span data-card-quantity-value aria-live="polite">0</span>
                              <button type="button" data-card-plus aria-label="{{ section.settings.increase_label | escape }}">+</button>
                            </div>
                          </div>
                        </div>
                      </article>
                    {%- else -%}
                      <p class="pb__empty-category">{{ section.settings.empty_collection_text }}</p>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        <aside class="pb-summary" aria-labelledby="PackSummaryTitle-{{ section.id }}">
          <div class="pb-summary__inner">
            <div class="pb-summary__heading-row">
              <div>
                <h2 id="PackSummaryTitle-{{ section.id }}" class="pb-summary__title">
                  {{ section.settings.summary_title }}
                </h2>
                <p class="pb-summary__message" data-progress-message>
                  {{ section.settings.initial_progress_text }}
                </p>
              </div>
              <button
                type="button"
                class="pb-summary__mobile-toggle"
                data-summary-toggle
                aria-expanded="false"
                aria-controls="PackSummaryContent-{{ section.id }}"
              >
                <span data-summary-count>0</span>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>

            <div id="PackSummaryContent-{{ section.id }}" class="pb-summary__content" data-summary-content>
              <div class="pb-progress" aria-label="{{ section.settings.progress_aria_label | escape }}">
                <div class="pb-progress__track">
                  <span class="pb-progress__fill" data-progress-fill></span>
                  <span class="pb-progress__dot" data-progress-dot></span>
                </div>
                <div class="pb-progress__levels">
                  <span data-level="1">
                    <strong>{{ section.settings.discount_1_value }}% off</strong>
                    <small>{{ section.settings.discount_1_qty }} {{ section.settings.items_short_label }}</small>
                  </span>
                  <span data-level="2">
                    <strong>{{ section.settings.discount_2_value }}% off</strong>
                    <small>{{ section.settings.discount_2_qty }} {{ section.settings.items_short_label }}</small>
                  </span>
                  <span data-level="3">
                    <strong>{{ section.settings.discount_3_value }}% off</strong>
                    <small>{{ section.settings.discount_3_qty }} {{ section.settings.items_short_label }}</small>
                  </span>
                </div>
              </div>

              <div class="pb-summary__groups">
                {%- for category_index in (1..3) -%}
                  {%- liquid
                    case category_index
                      when 1
                        assign category_id = 'breakfast'
                        assign category_title = section.settings.breakfast_title
                        assign category_collection = section.settings.breakfast_collection
                        assign category_minimum = section.settings.breakfast_minimum
                      when 2
                        assign category_id = 'sandwich'
                        assign category_title = section.settings.sandwich_title
                        assign category_collection = section.settings.sandwich_collection
                        assign category_minimum = section.settings.sandwich_minimum
                      when 3
                        assign category_id = 'snacks'
                        assign category_title = section.settings.snacks_title
                        assign category_collection = section.settings.snacks_collection
                        assign category_minimum = section.settings.snacks_minimum
                    endcase
                  -%}

                  {%- if category_collection != blank -%}
                    <details class="pb-group" data-summary-group="{{ category_id }}" open>
                      <summary>
                        <span>
                          <strong>{{ category_title }}</strong>
                          <small>
                            {{ section.settings.requires_prefix }}
                            {{ category_minimum }}
                            {% if category_minimum == 1 %}{{ section.settings.item_singular }}{% else %}{{ section.settings.item_plural }}{% endif %}
                          </small>
                        </span>
                        <span class="pb-group__count">
                          <b data-category-count>0</b> {{ section.settings.items_added_label }}
                          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </span>
                      </summary>
                      <div class="pb-group__items" data-category-items>
                        <p class="pb-group__empty" data-group-empty>{{ section.settings.empty_group_text }}</p>
                      </div>
                    </details>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              <div class="pb-summary__totals">
                <div>
                  <span>{{ section.settings.subtotal_label }}</span>
                  <strong data-subtotal>—</strong>
                </div>
                <div data-discount-row hidden>
                  <span>{{ section.settings.estimated_discount_label }}</span>
                  <strong data-discount-amount>—</strong>
                </div>
                <div class="pb-summary__total-row">
                  <span>{{ section.settings.total_label }}</span>
                  <strong data-estimated-total>—</strong>
                </div>
              </div>

              <button type="button" class="pb-summary__submit" data-submit disabled>
                <span data-submit-label>{{ section.settings.submit_label }}</span>
                <span class="pb-summary__spinner" aria-hidden="true"></span>
              </button>

              <p class="pb-summary__note">{{ section.settings.discount_note }}</p>
              <div class="pb-summary__status" data-status role="status" aria-live="polite"></div>
            </div>
          </div>
        </aside>
      </div>
    {%- else -%}
      <div class="pb__editor-empty">
        <strong>{{ section.settings.no_collections_title }}</strong>
        <p>{{ section.settings.no_collections_text }}</p>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #PackBuilder-{{ section.id }} {
    background: var(--pb-bg);
    color: var(--pb-text);
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }

  #PackBuilder-{{ section.id }} *,
  #PackBuilder-{{ section.id }} *::before,
  #PackBuilder-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #PackBuilder-{{ section.id }} button,
  #PackBuilder-{{ section.id }} select {
    font: inherit;
  }

  #PackBuilder-{{ section.id }} button {
    color: inherit;
  }

  #PackBuilder-{{ section.id }} .pb__container {
    width: min(100%, var(--pb-max-width));
    margin-inline: auto;
  }

  #PackBuilder-{{ section.id }} .pb__header {
    text-align: center;
    margin-bottom: 28px;
  }

  #PackBuilder-{{ section.id }} .pb__heading {
    margin: 0;
    font-size: clamp(28px, 4vw, 46px);
    line-height: 1.05;
  }

  #PackBuilder-{{ section.id }} .pb__subheading {
    max-width: 720px;
    margin: 10px auto 0;
    color: var(--pb-muted);
  }

  #PackBuilder-{{ section.id }} .pb__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(290px, 340px);
    gap: 14px;
    align-items: start;
  }

  #PackBuilder-{{ section.id }} .pb__catalog {
    min-width: 0;
  }

  #PackBuilder-{{ section.id }} .pb__tabs-shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    min-height: 58px;
    margin-bottom: 14px;
    padding: 8px 10px;
    border: 1px solid var(--pb-border);
    border-radius: var(--pb-radius);
    background: var(--pb-card);
  }

  #PackBuilder-{{ section.id }} .pb__tabs {
    display: flex;
    min-width: 0;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  #PackBuilder-{{ section.id }} .pb__tabs::-webkit-scrollbar {
    display: none;
  }

  #PackBuilder-{{ section.id }} .pb__tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;
    border: 0;
    background: transparent;
    color: var(--pb-muted);
    border-radius: 999px;
    padding: 8px 12px;
    cursor: pointer;
    transition: color .2s ease, background .2s ease;
  }

  #PackBuilder-{{ section.id }} .pb__tab:hover,
  #PackBuilder-{{ section.id }} .pb__tab.is-active {
    color: var(--pb-text);
    background: color-mix(in srgb, var(--pb-accent) 11%, transparent);
  }

  #PackBuilder-{{ section.id }} .pb__tab-icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--pb-border);
    border-radius: 50%;
  }

  #PackBuilder-{{ section.id }} .pb__tab.is-active .pb__tab-icon {
    color: var(--pb-accent-contrast);
    background: var(--pb-accent);
    border-color: var(--pb-accent);
  }

  #PackBuilder-{{ section.id }} .pb__tab-icon svg {
    width: 16px;
    height: 16px;
  }

  #PackBuilder-{{ section.id }} .pb__tab-arrows {
    display: flex;
    gap: 8px;
    flex: 0 0 auto;
  }

  #PackBuilder-{{ section.id }} .pb__arrow {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--pb-text);
    background: transparent;
    border-radius: 50%;
    cursor: pointer;
  }

  #PackBuilder-{{ section.id }} .pb__arrow--accent {
    border-color: var(--pb-accent);
    background: var(--pb-accent);
    color: var(--pb-accent-contrast);
  }

  #PackBuilder-{{ section.id }} .pb__arrow svg {
    width: 18px;
    height: 18px;
  }

  #PackBuilder-{{ section.id }} .pb__panel[hidden] {
    display: none;
  }

  #PackBuilder-{{ section.id }} .pb__grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - ({{ section.settings.columns_desktop | minus: 1 }} * 12px)) / {{ section.settings.columns_desktop }});
    gap: 12px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-behavior: smooth;
    scroll-snap-type: inline mandatory;
    scrollbar-width: none;
  }

  #PackBuilder-{{ section.id }} .pb__grid::-webkit-scrollbar {
    display: none;
  }

  #PackBuilder-{{ section.id }} .pb-card {
    min-width: 0;
    scroll-snap-align: start;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: var(--pb-radius);
    background: var(--pb-card);
    transition: border-color .2s ease, transform .2s ease;
  }

  #PackBuilder-{{ section.id }} .pb-card:has(.pb-card__quantity:not([hidden])) {
    border-color: var(--pb-accent);
  }

  #PackBuilder-{{ section.id }} .pb-card__media {
    display: block;
    position: relative;
    aspect-ratio: var(--pb-image-ratio);
    overflow: hidden;
    background: color-mix(in srgb, var(--pb-border) 35%, transparent);
  }

  #PackBuilder-{{ section.id }} .pb-card__image,
  #PackBuilder-{{ section.id }} .pb-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .35s ease;
  }

  #PackBuilder-{{ section.id }} .pb-card:hover .pb-card__image {
    transform: scale(1.025);
  }

  #PackBuilder-{{ section.id }} .pb-card__body {
    display: flex;
    flex-direction: column;
    min-height: 205px;
    padding: 14px;
  }

  #PackBuilder-{{ section.id }} .pb-card__title {
    margin: 0;
    font-size: 15px;
    line-height: 1.3;
  }

  #PackBuilder-{{ section.id }} .pb-card__title a {
    color: inherit;
    text-decoration: none;
  }

  #PackBuilder-{{ section.id }} .pb-card__price {
    margin-top: 7px;
    font-size: 17px;
    line-height: 1.2;
  }

  #PackBuilder-{{ section.id }} .pb-card__variant-label {
    display: block;
    margin-top: 12px;
    margin-bottom: 5px;
    font-size: 11px;
    color: var(--pb-muted);
  }

  #PackBuilder-{{ section.id }} .pb-card__variant {
    width: 100%;
    min-height: 38px;
    padding: 7px 34px 7px 10px;
