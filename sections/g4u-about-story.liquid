{%- liquid
  assign fallback_asset = 'g4u-about-history.png'

  if section.settings.fallback_asset == 'philosophy'
    assign fallback_asset = 'g4u-about-philosophy.png'
  endif

  assign media_animation_class = 'animate__g4uStoryRevealRight'

  if section.settings.image_position == 'left'
    assign media_animation_class = 'animate__g4uStoryRevealLeft'
  endif
-%}

<style>
  /* =========================================================
     G4U · Relato editorial — Image reveal
     ========================================================= */

  @keyframes g4uStoryRevealRight {
    0% {
      opacity: 0;
      transform: translateX(30px) translateY(10px) scale(0.95) rotate(1deg);
    }

    60% {
      opacity: 1;
    }

    100% {
      opacity: 1;
      transform: translateX(0) translateY(0) scale(1) rotate(0deg);
    }
  }

  @keyframes g4uStoryRevealLeft {
    0% {
      opacity: 0;
      transform: translateX(-30px) translateY(10px) scale(0.95) rotate(-1deg);
    }

    60% {
      opacity: 1;
    }

    100% {
      opacity: 1;
      transform: translateX(0) translateY(0) scale(1) rotate(0deg);
    }
  }

  .animate__g4uStoryRevealRight {
    animation-name: g4uStoryRevealRight;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    transform-origin: center center;
  }

  .animate__g4uStoryRevealLeft {
    animation-name: g4uStoryRevealLeft;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    transform-origin: center center;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate__g4uStoryRevealRight,
    .animate__g4uStoryRevealLeft {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<section
  class="g4u-about-story g4u-about-story--{{ section.settings.background }}{% if section.settings.image_position == 'left' %} g4u-about-story--reverse{% endif %}"
  aria-labelledby="G4uAboutStory-{{ section.id }}"
>
  <div class="g4u-about-story__inner">

    <div class="g4u-about-story__content">

      {%- if section.settings.eyebrow != blank -%}
        <p
          class="g4u-about-story__eyebrow wow animate__fadeIn"
          data-wow-duration="0.6s"
        >
          {{ section.settings.eyebrow | escape }}
        </p>
      {%- endif -%}

      <h2
        class="g4u-about-story__title g4u-display wow animate__fadeInUp"
        id="G4uAboutStory-{{ section.id }}"
        data-wow-duration="0.8s"
        data-wow-delay="0.06s"
      >
        {{ section.settings.title | replace: "|", "<br>" }}
      </h2>

      {%- if section.settings.lead != blank -%}
        <div
          class="g4u-about-story__lead rte wow animate__fadeInUp"
          data-wow-duration="0.75s"
          data-wow-delay="0.14s"
        >
          {{ section.settings.lead }}
        </div>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div
          class="g4u-about-story__text rte wow animate__fadeIn"
          data-wow-duration="0.8s"
          data-wow-delay="0.22s"
        >
          {{ section.settings.text }}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}

        <ul class="g4u-about-story__list" role="list">

          {%- for block in section.blocks -%}

            {%- assign item_delay = '0.26s' -%}

            {%- case forloop.index -%}
              {%- when 2 -%}
                {%- assign item_delay = '0.32s' -%}
              {%- when 3 -%}
                {%- assign item_delay = '0.38s' -%}
              {%- when 4 -%}
                {%- assign item_delay = '0.44s' -%}
              {%- when 5 -%}
                {%- assign item_delay = '0.50s' -%}
              {%- when 6 -%}
                {%- assign item_delay = '0.56s' -%}
            {%- endcase -%}

            <li
              class="g4u-about-story__list-item wow animate__fadeInUp"
              data-wow-duration="0.65s"
              data-wow-delay="{{ item_delay }}"
              {{ block.shopify_attributes }}
            >

              {%- if block.settings.icon != blank -%}

                <img
                  class="g4u-about-story__list-icon"
                  src="{{ block.settings.icon | image_url }}"
                  alt=""
                  width="20"
                  height="20"
                  aria-hidden="true"
                >

              {%- else -%}

                <img
                  class="g4u-about-story__list-icon"
                  src="{{ 'g4u-icon-check.svg' | asset_url }}"
                  alt=""
                  width="20"
                  height="20"
                  aria-hidden="true"
                >

              {%- endif -%}

              <span>
                {{ block.settings.text | escape }}
              </span>

            </li>

          {%- endfor -%}

        </ul>

      {%- endif -%}

    </div>


    <div
      class="g4u-about-story__media wow {{ media_animation_class }}"
      data-wow-duration="1s"
      data-wow-delay="0.10s"
    >

      {%- if section.settings.image != blank -%}

        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            class: 'g4u-about-story__image',
            loading: 'lazy',
            widths: '550, 750, 1100, 1500, 1800',
            sizes: '(min-width: 990px) 50vw, 100vw'
        }}

      {%- else -%}

        <img
          class="g4u-about-story__image"
          src="{{ fallback_asset | asset_url }}"
          alt="{{ section.settings.image_alt | escape }}"
          width="2731"
          height="4096"
          loading="lazy"
        >

      {%- endif -%}

    </div>

  </div>
</section>

{% schema %}
{
  "name": "G4U · Relato editorial",
  "tag": "section",
  "class": "section-g4u-about-story",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Fondo",
      "options": [
        {
          "value": "cream",
          "label": "Crema"
        },
        {
          "value": "soft",
          "label": "Suave"
        }
      ],
      "default": "cream"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Posición de imagen",
      "options": [
        {
          "value": "right",
          "label": "Derecha"
        },
        {
          "value": "left",
          "label": "Izquierda"
        }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "fallback_asset",
      "label": "Imagen predeterminada",
      "options": [
        {
          "value": "history",
          "label": "Historia"
        },
        {
          "value": "philosophy",
          "label": "Filosofía"
        }
      ],
      "default": "history"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Descripción de imagen",
      "default": "Pan G4U preparado artesanalmente"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Nuestra historia"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Todo empezó con una pregunta"
    },
    {
      "type": "richtext",
      "id": "lead",
      "label": "Destacado",
      "default": "<p>¿Y si el pan pudiera seguir siendo pan, pero nutricionalmente mejor?</p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Nos preguntamos si era posible hacerlo diferente.</p><p>Así nació G4U: con el desafío de desarrollar productos que mantuvieran la experiencia de los alimentos que todos disfrutamos, pero con un perfil nutricional superior.</p><p>Hoy seguimos investigando, desarrollando y mejorando cada receta para demostrar que comer mejor no tiene por qué sentirse como un sacrificio.</p>"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Punto",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "En información clara."
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icono personalizado",
          "info": "Opcional. Si no seleccionás ningún icono se utilizará automáticamente el check predeterminado."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "G4U · Relato editorial"
    }
  ]
}
{% endschema %}