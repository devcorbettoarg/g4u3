<section class="g4u-faq-page" aria-labelledby="G4uFaqPageTitle-{{ section.id }}">
  <header class="g4u-faq-page__header"><h1 class="g4u-display" id="G4uFaqPageTitle-{{ section.id }}">{{ section.settings.title | escape }}</h1><div class="rte">{{ section.settings.intro }}</div></header>
  <div class="g4u-faq-page__groups">
    {%- for block in section.blocks -%}
      <article class="g4u-faq-page__group" {{ block.shopify_attributes }}><h2>{{ block.settings.title | escape }}</h2>{%- assign questions = block.settings.questions | newline_to_br | split: '<br />' -%}{%- assign answers = block.settings.answers | newline_to_br | split: '<br />' -%}{%- for question in questions -%}{%- if question != blank -%}<details><summary>{{ question | escape }}<span aria-hidden="true"></span></summary><p>{{ answers[forloop.index0] | default: 'Consultanos y te ayudaremos.' | escape }}</p></details>{%- endif -%}{%- endfor -%}</article>
    {%- endfor -%}
  </div>
  <div class="g4u-faq-page__contact"><p>{{ section.settings.contact_title | escape }}</p><a class="g4u-pill" href="{{ section.settings.contact_link | default: routes.root_url }}">{{ section.settings.contact_label | escape }}</a></div>
</section>
{% schema %}
{"name":"G4U · Página FAQ","tag":"section","class":"section-g4u-faq-page","max_blocks":8,"settings":[{"type":"text","id":"title","label":"Título","default":"Preguntas frecuentes"},{"type":"richtext","id":"intro","label":"Introducción","default":"<p>Queremos que tengas toda la información para disfrutar de G4U con tranquilidad. Si no encontrás la respuesta que buscás, escribinos y nuestro equipo te responderá a la brevedad.</p>"},{"type":"text","id":"contact_title","label":"Título contacto","default":"¿Todavía tenés preguntas?"},{"type":"text","id":"contact_label","label":"Botón contacto","default":"Contactate con nosotros"},{"type":"url","id":"contact_link","label":"Enlace contacto"}],"blocks":[{"type":"group","name":"Categoría","settings":[{"type":"text","id":"title","label":"Título","default":"Productos G4U"},{"type":"textarea","id":"questions","label":"Preguntas (una por línea)","default":"¿Qué hace diferentes a los productos G4U?\n¿Dónde puedo ver los ingredientes?"},{"type":"textarea","id":"answers","label":"Respuestas (una por línea, mismo orden)","default":"Desarrollamos alimentos funcionales que combinan nutrición, ciencia y sabor.\nEncontrás la información en cada ficha de producto."}]}],"presets":[{"name":"G4U · Página FAQ","blocks":[{"type":"group","settings":{"title":"Productos G4U","questions":"¿Qué hace diferentes a los productos G4U?\n¿Los productos son aptos para una alimentación low-carb?","answers":"Combinan nutrición, ciencia y sabor para mejorar el perfil nutricional de los alimentos de todos los días.\nMuchos de nuestros productos tienen menor contenido de carbohidratos; revisá la información de cada producto."}},{"type":"group","settings":{"title":"Envíos y compras","questions":"¿Dónde realizan envíos?\n¿Cuánto demora mi pedido?","answers":"Realizamos envíos a Buenos Aires, Córdoba y Santa Fe.\nLas entregas en AMBA se realizan habitualmente en 24/48 hs."}}]}]}
{% endschema %}
