<section
  class="g4u-faq-page"
  aria-labelledby="G4uFaqPageTitle-{{ section.id }}"
  style="--g4u-faq-padding-top: {{ section.settings.padding_top }}px; --g4u-faq-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <header class="g4u-faq-page__header"><h1 class="g4u-display" id="G4uFaqPageTitle-{{ section.id }}">{{ section.settings.title | escape }}</h1><div class="rte">{{ section.settings.intro }}</div></header>
  <div class="g4u-faq-page__groups">
    {%- assign group_is_open = false -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'faq_header' -%}
          {%- if group_is_open -%}</div></article>{%- endif -%}
          {%- assign group_is_open = true -%}
          <article class="g4u-faq-page__group" {{ block.shopify_attributes }}>
            <header class="g4u-faq-page__group-header">
              <h2>{{ block.settings.title | escape }}</h2>
              {%- if block.settings.subtitle != blank -%}<p class="g4u-faq-page__group-subtitle">{{ block.settings.subtitle | escape }}</p>{%- endif -%}
            </header>
            <div class="g4u-faq-page__accordions">
        {%- when 'faq_item' -%}
          {%- if group_is_open and block.settings.question != blank -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question | escape }}<span aria-hidden="true"></span></summary>
              {%- if block.settings.answer != blank -%}<div class="rte">{{ block.settings.answer }}</div>{%- endif -%}
            </details>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
    {%- if group_is_open -%}</div></article>{%- endif -%}
  </div>
  <div class="g4u-faq-page__contact">
    <p>{{ section.settings.contact_title | escape }}</p>
    {%- if section.settings.contact_text != blank -%}<div class="g4u-faq-page__contact-text rte">{{ section.settings.contact_text }}</div>{%- endif -%}
    <a class="g4u-pill" href="{{ section.settings.contact_link | default: routes.root_url }}">{{ section.settings.contact_label | escape }}</a>
  </div>
</section>
{% schema %}
{"name":"G4U · Página FAQ","tag":"section","class":"section-g4u-faq-page","max_blocks":32,"settings":[{"type":"text","id":"title","label":"Título","default":"Preguntas frecuentes"},{"type":"richtext","id":"intro","label":"Introducción","default":"<p>Queremos que tengas toda la información para disfrutar de G4U con tranquilidad. Si no encontrás la respuesta que buscás, al final de la página podés escribirnos y nuestro equipo te responderá a la brevedad.</p>"},{"type":"text","id":"contact_title","label":"Título contacto","default":"¿No encontraste lo que buscabas?"},{"type":"richtext","id":"contact_text","label":"Texto contacto","default":"<p>Si todavía tenés alguna consulta, completá el formulario y nuestro equipo se pondrá en contacto con vos lo antes posible.</p>"},{"type":"text","id":"contact_label","label":"Botón contacto","default":"Contactate con nosotros"},{"type":"url","id":"contact_link","label":"Enlace contacto"},{"type":"range","id":"padding_top","label":"Padding superior","min":0,"max":240,"step":4,"unit":"px","default":200},{"type":"range","id":"padding_bottom","label":"Padding inferior","min":0,"max":240,"step":4,"unit":"px","default":80}],"blocks":[{"type":"faq_header","name":"Encabezado de categoría","settings":[{"type":"text","id":"title","label":"Título","default":"PRODUCTOS"},{"type":"text","id":"subtitle","label":"Subtítulo","default":"Sobre nuestros productos"}]},{"type":"faq_item","name":"Pregunta frecuente","settings":[{"type":"text","id":"question","label":"Pregunta","default":"¿Qué hace diferente a los productos G4U?"},{"type":"richtext","id":"answer","label":"Respuesta","default":"<p>Desarrollamos alimentos funcionales que combinan nutrición, ciencia y sabor.</p>"}]}],"presets":[{"name":"G4U · Página FAQ","blocks":[{"type":"faq_header"},{"type":"faq_item"}]}]}
{% endschema %}
