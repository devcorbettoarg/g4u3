<section class="g4u-faq-page" aria-labelledby="G4uFaqPageTitle-{{ section.id }}">
  <header class="g4u-faq-page__header"><h1 class="g4u-display" id="G4uFaqPageTitle-{{ section.id }}">{{ section.settings.title | escape }}</h1><div class="rte">{{ section.settings.intro }}</div></header>
  <div class="g4u-faq-page__groups">
    {%- for block in section.blocks -%}
      <article class="g4u-faq-page__group" {{ block.shopify_attributes }}>
        <h2>{{ block.settings.title | escape }}</h2>
        {%- if block.settings.subtitle != blank -%}<p class="g4u-faq-page__group-subtitle">{{ block.settings.subtitle | escape }}</p>{%- endif -%}
        {%- assign questions = block.settings.questions | newline_to_br | split: '<br />' -%}
        {%- assign answers = block.settings.answers | newline_to_br | split: '<br />' -%}
        {%- for question in questions -%}
          {%- if question != blank -%}
            <details>
              <summary>{{ question | escape }}<span aria-hidden="true"></span></summary>
              {%- if answers[forloop.index0] != blank -%}<div class="rte">{{ answers[forloop.index0] }}</div>{%- endif -%}
            </details>
          {%- endif -%}
        {%- endfor -%}
      </article>
    {%- endfor -%}
  </div>
  <div class="g4u-faq-page__contact">
    <p>{{ section.settings.contact_title | escape }}</p>
    {%- if section.settings.contact_text != blank -%}<div class="g4u-faq-page__contact-text rte">{{ section.settings.contact_text }}</div>{%- endif -%}
    <a class="g4u-pill" href="{{ section.settings.contact_link | default: routes.root_url }}">{{ section.settings.contact_label | escape }}</a>
  </div>
</section>
{% schema %}
{"name":"G4U · Página FAQ","tag":"section","class":"section-g4u-faq-page","max_blocks":8,"settings":[{"type":"text","id":"title","label":"Título","default":"Preguntas frecuentes"},{"type":"richtext","id":"intro","label":"Introducción","default":"<p>Queremos que tengas toda la información para disfrutar de G4U con tranquilidad. Si no encontrás la respuesta que buscás, al final de la página podés escribirnos y nuestro equipo te responderá a la brevedad.</p>"},{"type":"text","id":"contact_title","label":"Título contacto","default":"¿No encontraste lo que buscabas?"},{"type":"richtext","id":"contact_text","label":"Texto contacto","default":"<p>Si todavía tenés alguna consulta, completá el formulario y nuestro equipo se pondrá en contacto con vos lo antes posible.</p>"},{"type":"text","id":"contact_label","label":"Botón contacto","default":"Contactate con nosotros"},{"type":"url","id":"contact_link","label":"Enlace contacto"}],"blocks":[{"type":"group","name":"Categoría","settings":[{"type":"text","id":"title","label":"Título","default":"PRODUCTOS"},{"type":"text","id":"subtitle","label":"Subtítulo","default":"Sobre nuestros productos"},{"type":"textarea","id":"questions","label":"Preguntas (una por línea)","default":"¿Qué hace diferentes a los productos G4U?\n¿Los productos son aptos para una alimentación low-carb o keto?"},{"type":"textarea","id":"answers","label":"Respuestas (una por línea, mismo orden)","default":"Desarrollamos alimentos funcionales que combinan nutrición, ciencia y sabor.\n"}]}],"presets":[{"name":"G4U · Página FAQ","blocks":[{"type":"group","settings":{"title":"PRODUCTOS","subtitle":"Sobre nuestros productos","questions":"¿Qué hace diferente a los productos G4U?\n¿Son aptos para una alimentación low-carb o keto?\n¿Los productos contienen gluten?\n¿Puedo congelarlos?\n¿Dónde encuentro la información nutricional?\n¿Qué hace diferente a la harina G4U?","answers":"Combinan nutrición, ciencia y sabor para mejorar el perfil nutricional de los alimentos de todos los días.\nMuchos de nuestros productos tienen menor contenido de carbohidratos; revisá la información de cada producto.\n\n\n\nLa encontrás en cada ficha de producto.\n"}},{"type":"group","settings":{"title":"COMPRAS, ENVÍOS Y PAGOS","subtitle":"Compras y envíos","questions":"¿A qué zonas realizan envíos?\n¿Cuánto demora mi pedido?\n¿Cómo puedo seguir mi compra?\n¿Qué medios de pago aceptan?\n¿Puedo cambiar o cancelar un pedido?\n¿Cómo debo conservar los productos?","answers":"Realizamos envíos a Buenos Aires, Córdoba y Santa Fe.\nLas entregas en AMBA se realizan habitualmente en 24/48 hs.\n\n\nContactanos lo antes posible para que podamos ayudarte.\n"}}]}]}
{% endschema %}
