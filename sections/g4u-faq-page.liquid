<section
  class="g4u-faq-page"
  aria-labelledby="G4uFaqPageTitle-{{ section.id }}"
  style="--g4u-faq-padding-top: {{ section.settings.padding_top }}px; --g4u-faq-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <header class="g4u-faq-page__header"><h1 class="g4u-display" id="G4uFaqPageTitle-{{ section.id }}">{{ section.settings.title | escape }}</h1><div class="rte">{{ section.settings.intro }}</div></header>
  <div class="g4u-faq-page__groups">
    {%- for block in section.blocks -%}
      {%- if block.type == 'faq_header' -%}
        {%- assign faq_start = forloop.index -%}
        <article class="g4u-faq-page__group" {{ block.shopify_attributes }}>
          <header class="g4u-faq-page__group-header">
            <h2>{{ block.settings.title | escape }}</h2>
            {%- if block.settings.subtitle != blank -%}<p class="g4u-faq-page__group-subtitle">{{ block.settings.subtitle | escape }}</p>{%- endif -%}
          </header>
          <div class="g4u-faq-page__accordions">
            {%- for faq_block in section.blocks offset: faq_start -%}
              {%- if faq_block.type == 'faq_header' -%}{%- break -%}{%- endif -%}
              {%- if faq_block.type == 'faq_item' and faq_block.settings.question != blank -%}
                <details {{ faq_block.shopify_attributes }}>
                  <summary>{{ faq_block.settings.question | escape }}<span aria-hidden="true"></span></summary>
                  {%- if faq_block.settings.answer != blank -%}<div class="rte">{{ faq_block.settings.answer }}</div>{%- endif -%}
                </details>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{"name":"G4U · Página FAQ","tag":"section","class":"section-g4u-faq-page","max_blocks":32,"settings":[{"type":"text","id":"title","label":"Título","default":"Preguntas frecuentes"},{"type":"richtext","id":"intro","label":"Introducción","default":"<p>Queremos que tengas toda la información para disfrutar de G4U con tranquilidad. Si no encontrás la respuesta que buscás, al final de la página podés escribirnos y nuestro equipo te responderá a la brevedad.</p>"},{"type":"range","id":"padding_top","label":"Padding superior","min":0,"max":240,"step":4,"unit":"px","default":200},{"type":"range","id":"padding_bottom","label":"Padding inferior","min":0,"max":240,"step":4,"unit":"px","default":80}],"blocks":[{"type":"faq_header","name":"Encabezado de categoría","settings":[{"type":"text","id":"title","label":"Título","default":"PRODUCTOS"},{"type":"text","id":"subtitle","label":"Subtítulo","default":"Sobre nuestros productos"}]},{"type":"faq_item","name":"Pregunta frecuente","settings":[{"type":"text","id":"question","label":"Pregunta","default":"¿Qué hace diferente a los productos G4U?"},{"type":"richtext","id":"answer","label":"Respuesta","default":"<p>Desarrollamos alimentos funcionales que combinan nutrición, ciencia y sabor.</p>"}]}],"presets":[{"name":"G4U · Página FAQ","blocks":[{"type":"faq_header"},{"type":"faq_item"}]}]}
{% endschema %}
