<style>
  /* =========================================================
     G4U · Calidad harina — Editorial image reveal
     ========================================================= */

  @keyframes g4uQualityImageReveal {
    0% {
      clip-path: inset(0 100% 0 0);
      transform: scale(1.04);
    }

    100% {
      clip-path: inset(0 0 0 0);
      transform: scale(1);
    }
  }

  .animate__g4uQualityImageReveal {
    animation-name: g4uQualityImageReveal;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    transform-origin: center center;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate__g4uQualityImageReveal {
      animation: none !important;
      clip-path: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

<section
  class="g4u-flour-quality"
  aria-labelledby="G4uFlourQualityTitle-{{ section.id }}"
>

  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 2200
      | image_tag:
        class: 'g4u-flour-quality__image wow animate__g4uQualityImageReveal',
        loading: 'lazy',
        widths: '750, 1100, 1500, 1800, 2200',
        sizes: '100vw'
    }}
  {%- else -%}

    <img
      class="g4u-flour-quality__image wow animate__g4uQualityImageReveal"
      src="{{ 'g4u-flour-quality.webp' | asset_url }}"
      alt="{{ section.settings.image_alt | escape }}"
      width="2200"
      height="1447"
      loading="lazy"
    >

  {%- endif -%}

  <div class="g4u-flour-quality__content">

    <h2
      class="g4u-flour-quality__title g4u-display wow animate__fadeInLeft"
      id="G4uFlourQualityTitle-{{ section.id }}"
      data-wow-duration="0.8s"
      data-wow-delay="0.12s"
    >
      <em>{{ section.settings.accent | escape }}</em><br>
      {{ section.settings.title | escape }}
    </h2>

    <div
      class="g4u-flour-quality__text rte wow animate__fadeIn"
      data-wow-duration="0.75s"
      data-wow-delay="0.24s"
    >
      {{ section.settings.text }}
    </div>

    {%- if section.settings.button_label != blank -%}

      <a
        class="g4u-pill g4u-pill--light wow animate__fadeInUp"
        href="{{ section.settings.button_link | default: 'https://drive.google.com/file/d/1phHsXeXerpK-pRPHk34W481dR7vwaBtT/view?usp=sharing' }}"
        target="_blank"
        rel="noopener"
        data-wow-duration="0.7s"
        data-wow-delay="0.34s"
      >
        {{ section.settings.button_label | escape }}
      </a>

    {%- endif -%}

  </div>

</section>

{% schema %}
{
  "name": "G4U · Calidad harina",
  "tag": "section",
  "class": "section-g4u-flour-quality",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Descripción de imagen",
      "default": "Harina junto a espigas de trigo"
    },
    {
      "type": "text",
      "id": "accent",
      "label": "Título destacado",
      "default": "Calidad"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "respaldada"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Nuestra harina fue desarrollada y analizada para garantizar un perfil nutricional consistente y transparente.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Ver el análisis CONICET"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    }
  ],
  "presets": [
    {
      "name": "G4U · Calidad harina"
    }
  ]
}
{% endschema %}