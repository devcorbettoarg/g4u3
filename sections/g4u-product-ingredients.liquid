<section class="g4u-product-ingredients" aria-labelledby="G4uProductIngredients-{{ section.id }}">
  <header class="g4u-product-ingredients__header">
    {%- if section.settings.eyebrow != blank -%}<p>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h2 class="g4u-display" id="G4uProductIngredients-{{ section.id }}">{{ section.settings.title | escape }}</h2>
    {%- if section.settings.description != blank -%}<div class="rte">{{ section.settings.description }}</div>{%- endif -%}
  </header>
  <div class="g4u-product-ingredients__items">
    {%- for block in section.blocks -%}
      <details {{ block.shopify_attributes }}>
        <summary>
          <span class="g4u-product-ingredients__summary-label">
            {%- if block.settings.custom_icon != blank -%}
              {{ block.settings.custom_icon | image_url: width: 64 | image_tag: loading: 'lazy', widths: '32, 64', sizes: '32px' }}
            {%- else -%}
              {% render 'icon-accordion', icon: block.settings.icon %}
            {%- endif -%}
            {{ block.settings.title | escape }}
          </span>
          <span class="g4u-product-ingredients__chevron" aria-hidden="true"></span>
        </summary>
        <div class="rte">{{ block.settings.text }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "G4U · Ingredientes PDP",
  "tag": "section",
  "class": "section-g4u-product-ingredients",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Ingredientes" },
    { "type": "text", "id": "title", "label": "Título", "default": "Ciencia y nutrición en cada ingrediente" },
    { "type": "richtext", "id": "description", "label": "Descripción", "default": "<p>Cada componente de nuestra fórmula cumple una función específica para lograr un pan más nutritivo, sin resignar sabor ni textura.</p>" }
  ],
  "blocks": [
    { "type": "ingredient", "name": "Ingrediente", "settings": [
      { "type": "image_picker", "id": "custom_icon", "label": "Ícono personalizado" },
      { "type": "select", "id": "icon", "label": "Icono", "options": [
        { "value": "leaf", "label": "Hoja" },
        { "value": "iron", "label": "Nutrientes" },
        { "value": "serving_dish", "label": "Porción" },
        { "value": "check_mark", "label": "Check" },
        { "value": "none", "label": "Sin icono" }
      ], "default": "leaf" },
      { "type": "text", "id": "title", "label": "Título", "default": "Almidón resistente RS4" },
      { "type": "richtext", "id": "text", "label": "Descripción", "default": "<p>Aporta fibra funcional y contribuye a un perfil nutricional más equilibrado.</p>" }
    ] }
  ],
  "presets": [{ "name": "G4U · Ingredientes PDP", "blocks": [{ "type": "ingredient" }, { "type": "ingredient", "settings": { "title": "Fibras funcionales" } }, { "type": "ingredient", "settings": { "title": "Proteínas de alta calidad" } }, { "type": "ingredient", "settings": { "title": "Tecnología alimentaria" } }] }]
}
{% endschema %}
