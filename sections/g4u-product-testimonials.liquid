<script src="{{ 'g4u-scroll-carousel.js' | asset_url }}" defer="defer"></script>
<g4u-scroll-carousel class="g4u-product-testimonials" role="region" aria-labelledby="G4uProductTestimonials-{{ section.id }}">
  <div class="g4u-product-testimonials__inner">
    <header class="g4u-product-testimonials__header">
      <h2 class="g4u-display" id="G4uProductTestimonials-{{ section.id }}">{{ section.settings.title | escape }}</h2>
      {%- if section.blocks.size > 0 -%}
        <div class="g4u-product-testimonials__controls">
          <button class="g4u-product-testimonials__arrow" type="button" data-g4u-scroll-prev aria-label="Reseña anterior"><img src="{{ 'g4u-icon-arrow-back.svg' | asset_url }}" alt="" width="24" height="24"></button>
          <button class="g4u-product-testimonials__arrow" type="button" data-g4u-scroll-next aria-label="Reseña siguiente"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M8.14453 0.5C8.21548 0.500668 8.27733 0.517317 8.33887 0.560547L8.40039 0.613281L15.3486 7.56152C15.4018 7.61569 15.4275 7.65782 15.4395 7.68652V7.6875C15.4546 7.72385 15.4629 7.7639 15.4629 7.81152C15.4629 7.85913 15.4543 7.89825 15.4395 7.93359V7.93457C15.4276 7.96304 15.4022 8.00538 15.3486 8.05957L8.39453 15.0078C8.30318 15.0981 8.22456 15.124 8.1416 15.124C8.0609 15.1239 7.98874 15.0994 7.90527 15.0137L7.90039 15.0088L7.84863 14.9482C7.80653 14.8886 7.79201 14.8306 7.79199 14.7656C7.79199 14.701 7.80676 14.6433 7.84863 14.584L7.90039 14.5234L14.2617 8.16211H0.851562C0.729469 8.16207 0.657228 8.12693 0.59668 8.06641H0.595703C0.53483 8.0055 0.500002 7.93257 0.5 7.81055C0.5 7.68853 0.534835 7.6156 0.595703 7.55469H0.59668C0.657231 7.49416 0.729461 7.45902 0.851562 7.45898H14.2617L7.90625 1.10352C7.84494 1.04216 7.81315 0.983763 7.80078 0.918945L7.79492 0.851562C7.79401 0.761613 7.82017 0.688031 7.90039 0.607422L7.90137 0.606445C7.98151 0.525858 8.05487 0.499224 8.14453 0.5Z" fill="#26131B" stroke="#26131B"/>
</svg>
</button>
        </div>
      {%- endif -%}
    </header>
    <div class="g4u-product-testimonials__grid" data-g4u-scroll-track>
      {%- for block in section.blocks -%}
        <blockquote {{ block.shopify_attributes }}>
          <p class="g4u-product-testimonials__stars" aria-label="{{ block.settings.rating | escape }} de 5 estrellas">★★★★★</p>
          <div class="rte">{{ block.settings.quote }}</div>
          <footer>{{ block.settings.author | escape }}</footer>
        </blockquote>
      {%- endfor -%}
    </div>
  </div>
</g4u-scroll-carousel>

{% schema %}
{
  "name": "G4U · Reseñas PDP",
  "tag": "section",
  "class": "section-g4u-product-testimonials",
  "max_blocks": 4,
  "settings": [{ "type": "text", "id": "title", "label": "Título", "default": "Lo dicen quienes ya lo probaron" }],
  "blocks": [
    { "type": "review", "name": "Reseña", "settings": [
      { "type": "text", "id": "rating", "label": "Calificación", "default": "5" },
      { "type": "richtext", "id": "quote", "label": "Reseña", "default": "<p>“Por fin un pan que no se siente un cartón. Es suave, esponjoso y tiene sabor a pan real.”</p>" },
      { "type": "text", "id": "author", "label": "Autor", "default": "Mariana G." }
    ] }
  ],
  "presets": [{ "name": "G4U · Reseñas PDP", "blocks": [{ "type": "review" }, { "type": "review", "settings": { "quote": "<p>“Excelente producto: rico, práctico y fácil de incorporar todos los días.”</p>", "author": "Juan A." } }, { "type": "review", "settings": { "quote": "<p>“Me encantó. Lo sigo recomendando y voy a seguir comprando.”</p>", "author": "Ivana M." } }] }]
}
{% endschema %}
