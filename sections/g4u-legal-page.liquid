<section class="g4u-legal" aria-labelledby="G4uLegalTitle-{{ section.id }}">
  <header class="g4u-legal__header">
    <h1 id="G4uLegalTitle-{{ section.id }}">{{ page.title | escape }}</h1>
    {%- if section.settings.updated_at != blank -%}<p>{{ section.settings.updated_at | escape }}</p>{%- endif -%}
  </header>

  <div class="g4u-legal__content rte">
    {{ page.content }}
  </div>
</section>

{% schema %}
{
  "name": "G4U página legal",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "updated_at",
      "label": "Fecha de actualización",
      "default": "Última actualización: 8 de enero de 2026"
    }
  ]
}
{% endschema %}
