<section class="g4u-flour-faq" aria-labelledby="G4uFlourFaqTitle-{{ section.id }}">
  <header class="g4u-flour-faq__header"><h2 class="g4u-display" id="G4uFlourFaqTitle-{{ section.id }}">{{ section.settings.title | escape }}</h2>{%- if section.settings.description != blank -%}<div class="rte">{{ section.settings.description }}</div>{%- endif -%}</header>
  <div class="g4u-flour-faq__items">{%- for block in section.blocks -%}<details class="g4u-flour-faq__item" {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}<span aria-hidden="true"></span></summary><div class="rte">{{ block.settings.answer }}</div></details>{%- endfor -%}</div>
  <div class="g4u-flour-faq__contact"><p>{{ section.settings.contact_title | escape }}</p>{%- if section.settings.contact_label != blank -%}<a class="g4u-pill" href="{{ section.settings.contact_link | default: routes.root_url }}">{{ section.settings.contact_label | escape }}</a>{%- endif -%}</div>
</section>

{% schema %}
{"name":"G4U · FAQ harina","tag":"section","class":"section-g4u-flour-faq","max_blocks":8,"settings":[{"type":"text","id":"title","label":"Título","default":"Preguntas frecuentes"},{"type":"richtext","id":"description","label":"Descripción","default":"<p>Todo lo que querés saber sobre la harina que hace diferentes a nuestros productos.</p>"},{"type":"text","id":"contact_title","label":"Título contacto","default":"¿Todavía tenés preguntas?"},{"type":"text","id":"contact_label","label":"Botón contacto","default":"Contactate con nosotros"},{"type":"url","id":"contact_link","label":"Enlace contacto"}],"blocks":[{"type":"question","name":"Pregunta","settings":[{"type":"text","id":"question","label":"Pregunta","default":"¿Qué hace diferente a la harina G4U?"},{"type":"richtext","id":"answer","label":"Respuesta","default":"<p>Es una formulación funcional propia que combina proteínas, fibras y almidón resistente para mejorar el perfil nutricional sin resignar sabor ni textura.</p>"}]}],"presets":[{"name":"G4U · FAQ harina","blocks":[{"type":"question","settings":{"question":"¿Qué hace diferente a la harina G4U?"}},{"type":"question","settings":{"question":"¿Qué es el almidón resistente RS4?","answer":"<p>Es un ingrediente funcional que aporta fibra y ayuda a reducir el impacto de los carbohidratos disponibles.</p>"}},{"type":"question","settings":{"question":"¿Por qué desarrollaron una harina propia?","answer":"<p>Para poder mejorar el perfil nutricional de nuestros productos desde su origen, manteniendo la experiencia del pan de siempre.</p>"}},{"type":"question","settings":{"question":"¿La harina G4U se utiliza en todos sus productos?","answer":"<p>Nuestra harina funcional es la base de la línea de productos G4U.</p>"}},{"type":"question","settings":{"question":"¿La harina modifica el sabor del pan?","answer":"<p>No: la fórmula fue desarrollada para conservar una textura suave y el sabor que esperamos de un buen pan.</p>"}},{"type":"question","settings":{"question":"¿Puedo comprar la harina G4U por separado?","answer":"<p>Consultanos para conocer la disponibilidad y las opciones vigentes.</p>"}}]}]}
{% endschema %}
