{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<style>
  /* ==========================================
     G4U · Featured products — Product reveal
     ========================================== */

  @keyframes g4uProductCardReveal {
    0% {
      opacity: 0;
      transform: translateY(22px) scale(0.97);
    }

    60% {
      opacity: 1;
    }

    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .animate__g4uProductCardReveal {
    animation-name: g4uProductCardReveal;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    transform-origin: center bottom;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate__g4uProductCardReveal {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<section
  class="g4u-featured-products"
  aria-labelledby="G4uProducts-{{ section.id }}"
>

  <header class="g4u-featured-products__header">

    {%- if section.settings.eyebrow != blank -%}
      <p
        class="g4u-featured-products__eyebrow wow animate__fadeIn"
        data-wow-duration="0.6s"
      >
        {{ section.settings.eyebrow | escape }}
      </p>
    {%- endif -%}

    <h2
      class="g4u-featured-products__title g4u-display wow animate__fadeInUp"
      id="G4uProducts-{{ section.id }}"
      data-wow-duration="0.8s"
      data-wow-delay="0.06s"
    >
      {{ section.settings.title | escape }}
    </h2>

    {%- if section.settings.description != blank -%}
      <div
        class="g4u-featured-products__description rte wow animate__fadeIn"
        data-wow-duration="0.75s"
        data-wow-delay="0.14s"
      >
        {{ section.settings.description }}
      </div>
    {%- endif -%}

  </header>

  <ul
    class="g4u-featured-products__grid"
    role="list"
  >

    {%- if section.settings.collection.products.size > 0 -%}

      {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}

        {%- assign product_delay = '0.05s' -%}

        {%- case forloop.index -%}
          {%- when 2 -%}
            {%- assign product_delay = '0.12s' -%}
          {%- when 3 -%}
            {%- assign product_delay = '0.19s' -%}
          {%- when 4 -%}
            {%- assign product_delay = '0.26s' -%}
          {%- when 5 -%}
            {%- assign product_delay = '0.33s' -%}
          {%- when 6 -%}
            {%- assign product_delay = '0.40s' -%}
          {%- when 7 -%}
            {%- assign product_delay = '0.47s' -%}
          {%- when 8 -%}
            {%- assign product_delay = '0.54s' -%}
        {%- endcase -%}

        <li
          class="g4u-featured-products__item wow animate__g4uProductCardReveal"
          data-wow-duration="0.8s"
          data-wow-delay="{{ product_delay }}"
        >
          {% render 'card-product',
            card_product: product,
            media_aspect_ratio: 'portrait',
            image_shape: 'default',
            lazy_load: true,
            show_secondary_image: section.settings.show_secondary_image,
            show_vendor: false,
            show_rating: false,
            skip_styles: forloop.index0,
            section_id: section.id,
            quick_add: 'none',
            product_view_context: 'featured-collection'
          %}
        </li>

      {%- endfor -%}

    {%- else -%}

      {%- for index in (1..4) -%}

        {%- assign product_delay = '0.05s' -%}

        {%- case forloop.index -%}
          {%- when 2 -%}
            {%- assign product_delay = '0.12s' -%}
          {%- when 3 -%}
            {%- assign product_delay = '0.19s' -%}
          {%- when 4 -%}
            {%- assign product_delay = '0.26s' -%}
        {%- endcase -%}

        <li
          class="g4u-featured-products__item wow animate__g4uProductCardReveal"
          data-wow-duration="0.8s"
          data-wow-delay="{{ product_delay }}"
        >
          {% render 'card-product',
            media_aspect_ratio: 'portrait',
            placeholder_image: 'product-apparel-1',
            skip_styles: forloop.index0
          %}
        </li>

      {%- endfor -%}

    {%- endif -%}

  </ul>

  {%- if section.settings.show_view_all -%}

    <div
      class="g4u-featured-products__footer wow animate__fadeInUp"
      data-wow-duration="0.7s"
      data-wow-delay="0.16s"
    >
      <a
        class="g4u-pill g4u-featured-products__button"
        href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}"
      >
        {{ section.settings.button_label | escape }}
      </a>
    </div>

  {%- endif -%}

</section>

{% schema %}
{
  "name": "G4U · Packs destacados",
  "tag": "section",
  "class": "section-g4u-products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Products"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Nuestros packs"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción",
      "default": "<p>Elegí el pack que mejor se adapta a vos y disfrutá todos los días.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Productos",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Segunda imagen al pasar el cursor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Mostrar botón",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Ver todos los productos"
    }
  ],
  "presets": [
    {
      "name": "G4U · Packs destacados"
    }
  ]
}
{% endschema %}