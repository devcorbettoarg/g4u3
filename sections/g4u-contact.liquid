<section class="g4u-contact" aria-labelledby="G4uContactTitle-{{ section.id }}">
  <header class="g4u-contact__header"><p>{{ section.settings.eyebrow | escape }}</p><h1 class="g4u-display" id="G4uContactTitle-{{ section.id }}">{{ section.settings.title | escape }}</h1><div class="rte">{{ section.settings.intro }}</div></header>
  <div class="g4u-contact__grid"><div class="g4u-contact__media">{%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 750px) 50vw, 100vw' }}{%- else -%}<img src="{{ 'g4u-contact.jpg' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="1024" height="1536" loading="lazy">{%- endif -%}</div><div class="g4u-contact__form">{%- form 'contact' -%}{%- if form.posted_successfully? -%}<p class="g4u-contact__success">{{ section.settings.success | escape }}</p>{%- endif -%}{%- if form.errors -%}<div class="form-status form-status-list form__message" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}<label for="ContactName-{{ section.id }}">Nombre</label><input id="ContactName-{{ section.id }}" type="text" name="contact[name]" value="{% if form.name %}{{ form.name }}{% endif %}" required><label for="ContactEmail-{{ section.id }}">Email</label><input id="ContactEmail-{{ section.id }}" type="email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% endif %}" required><label for="ContactPhone-{{ section.id }}">Teléfono</label><input id="ContactPhone-{{ section.id }}" type="tel" name="contact[phone]" value="{% if form.phone %}{{ form.phone }}{% endif %}"><label for="ContactMessage-{{ section.id }}">Mensaje</label><textarea id="ContactMessage-{{ section.id }}" name="contact[body]" rows="6" required>{% if form.body %}{{ form.body }}{% endif %}</textarea><button class="g4u-pill" type="submit">{{ section.settings.button_label | escape }}</button>{%- endform -%}</div></div>
</section>
{% schema %}
{"name":"G4U · Contacto","tag":"section","class":"section-g4u-contact","settings":[{"type":"text","id":"eyebrow","label":"Antetítulo","default":"Estamos para ayudarte"},{"type":"text","id":"title","label":"Título","default":"Contactanos"},{"type":"richtext","id":"intro","label":"Introducción","default":"<p>Escribinos y nuestro equipo te responderá a la brevedad.</p>"},{"type":"image_picker","id":"image","label":"Imagen"},{"type":"text","id":"image_alt","label":"Descripción de imagen","default":"Productos G4U sobre una mesa"},{"type":"text","id":"button_label","label":"Botón","default":"Enviar mensaje"},{"type":"text","id":"success","label":"Mensaje de éxito","default":"¡Gracias! Recibimos tu mensaje."}],"presets":[{"name":"G4U · Contacto"}]}
{% endschema %}
