<script src="{{ 'g4u-tabs.js' | asset_url }}" defer="defer"></script>

<section class="g4u-science" aria-labelledby="G4uScience-{{ section.id }}">
  <header class="g4u-science__header">
    <p class="g4u-science__eyebrow">
      {{ section.settings.eyebrow | escape }}
    </p>

    <h2
      class="g4u-science__title g4u-display"
      id="G4uScience-{{ section.id }}"
    >
      {{ section.settings.title | replace: "|", "<br>" }}
    </h2>

    <div class="g4u-science__intro rte">
      {{ section.settings.description }}
    </div>
  </header>

  <g4u-tabs>

    <div
      class="g4u-science__tablist"
      role="tablist"
      aria-label="{{ section.settings.tabs_label | escape }}"
    >
      {%- for block in section.blocks -%}
        <button
          class="g4u-science__tab"
          id="G4uScienceTab-{{ section.id }}-{{ forloop.index }}"
          type="button"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-controls="G4uSciencePanel-{{ section.id }}-{{ forloop.index }}"
          tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
        >
          {{ forloop.index }}. {{ block.settings.tab_label | escape }}
        </button>
      {%- endfor -%}
    </div>

    <div class="g4u-science__panels">

      {%- for block in section.blocks -%}

        <article
          class="g4u-science__panel{% if forloop.first %} is-active{% endif %}"
          id="G4uSciencePanel-{{ section.id }}-{{ forloop.index }}"
          role="tabpanel"
          aria-labelledby="G4uScienceTab-{{ section.id }}-{{ forloop.index }}"
          {% unless forloop.first %}hidden{% endunless %}
          {{ block.shopify_attributes }}
        >

          <div class="g4u-science__media">

            {%- if block.settings.image != blank -%}

              {{
                block.settings.image
                | image_url: width: 1400
                | image_tag:
                  class: 'g4u-science__image',
                  loading: 'lazy',
                  widths: '550, 800, 1100, 1400',
                  sizes: '(min-width: 750px) 45vw, 100vw'
              }}

            {%- else -%}

              <img
                class="g4u-science__image"
                src="{{ 'g4u-flour-science.jpg' | asset_url }}"
                alt="{{ block.settings.image_alt | escape }}"
                width="1400"
                height="934"
                loading="lazy"
              >

            {%- endif -%}

          </div>

          <div class="g4u-science__content">

            {%- if block.settings.tagline != blank -%}
              <p class="g4u-science__tagline">
                {{ block.settings.tagline | escape }}
              </p>
            {%- endif -%}

            <h3 class="g4u-science__panel-title g4u-display">
              {{ block.settings.heading  | replace: "|", "<br>" }}
            </h3>

            {%- if block.settings.text != blank -%}
              <div class="g4u-science__text rte">
                {{ block.settings.text }}
              </div>
            {%- endif -%}

            {%- if
              block.settings.benefit_1 != blank
              or block.settings.benefit_2 != blank
              or block.settings.benefit_3 != blank
              or block.settings.benefit_4 != blank
            -%}

              {%- if block.settings.why_label != blank -%}
                <p class="g4u-science__why">
                  {{ block.settings.why_label | escape }}
                </p>
              {%- endif -%}

              <ul class="g4u-science__benefits" role="list">

                {%- for benefit_index in (1..4) -%}

                  {%- assign benefit_key = 'benefit_' | append: benefit_index -%}

                  {%- if block.settings[benefit_key] != blank -%}

                    <li class="g4u-science__benefit">
                      <img
                        class="g4u-science__check"
                        src="{{ 'g4u-icon-check.svg' | asset_url }}"
                        alt=""
                        width="20"
                        height="20"
                      >

                      {{ block.settings[benefit_key] | escape }}
                    </li>

                  {%- endif -%}

                {%- endfor -%}

              </ul>

            {%- endif -%}

            {%- if section.settings.link_label != blank -%}
              <a
                class="g4u-science__link"
                href="{{ section.settings.link | default: routes.root_url }}"
              >
                {{ section.settings.link_label | escape }}

                <img
                  src="{{ 'g4u-icon-chevron.svg' | asset_url }}"
                  alt=""
                  width="24"
                  height="24"
                >
              </a>
            {%- endif -%}

          </div>

        </article>

      {%- endfor -%}

      {%- if section.blocks.size > 1 -%}

        <div class="g4u-science__arrows">

          <button
            class="g4u-science__arrow"
            type="button"
            data-g4u-tabs-previous
            aria-label="Contenido anterior"
          >
         
<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M7.82129 0.5C7.90691 0.500059 7.98026 0.526325 8.0625 0.608398C8.1448 0.694341 8.1709 0.771445 8.1709 0.857422C8.17081 0.944261 8.14426 1.01826 8.0625 1.10059L1.70117 7.46191H15.1113C15.2328 7.46193 15.3079 7.49726 15.3721 7.56055C15.4342 7.6219 15.4687 7.69362 15.4688 7.81348C15.4688 7.93333 15.4342 8.00505 15.3721 8.06641C15.3079 8.12969 15.2328 8.16502 15.1113 8.16504H1.70117L8.05664 14.5205V14.5195C8.1389 14.602 8.16719 14.6788 8.16797 14.7705V14.7715C8.16849 14.838 8.15383 14.8964 8.1123 14.9561L8.06055 15.0176C7.9806 15.0985 7.90742 15.1248 7.81836 15.124C7.72391 15.1231 7.6456 15.0931 7.5625 15.0107L0.614258 8.0625C0.561096 8.00833 0.5354 7.9662 0.523438 7.9375V7.93652C0.50833 7.90019 0.5 7.8601 0.5 7.8125C0.50003 7.76491 0.508641 7.72576 0.523438 7.69043V7.68945C0.535302 7.66099 0.560769 7.61862 0.614258 7.56445L7.56445 0.614258C7.65485 0.527034 7.73453 0.5 7.82129 0.5Z" fill="#26131B" stroke="#26131B"/>
</svg>

          </button>

          <button
            class="g4u-science__arrow"
            type="button"
            data-g4u-tabs-next
            aria-label="Contenido siguiente"
          >
           
<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M8.14453 0.5C8.21548 0.500668 8.27733 0.517317 8.33887 0.560547L8.40039 0.613281L15.3486 7.56152C15.4018 7.61569 15.4275 7.65782 15.4395 7.68652V7.6875C15.4546 7.72385 15.4629 7.7639 15.4629 7.81152C15.4629 7.85913 15.4543 7.89825 15.4395 7.93359V7.93457C15.4276 7.96304 15.4022 8.00538 15.3486 8.05957L8.39453 15.0078C8.30318 15.0981 8.22456 15.124 8.1416 15.124C8.0609 15.1239 7.98874 15.0994 7.90527 15.0137L7.90039 15.0088L7.84863 14.9482C7.80653 14.8886 7.79201 14.8306 7.79199 14.7656C7.79199 14.701 7.80676 14.6433 7.84863 14.584L7.90039 14.5234L14.2617 8.16211H0.851562C0.729469 8.16207 0.657228 8.12693 0.59668 8.06641H0.595703C0.53483 8.0055 0.500002 7.93257 0.5 7.81055C0.5 7.68853 0.534835 7.6156 0.595703 7.55469H0.59668C0.657231 7.49416 0.729461 7.45902 0.851562 7.45898H14.2617L7.90625 1.10352C7.84494 1.04216 7.81315 0.983763 7.80078 0.918945L7.79492 0.851562C7.79401 0.761613 7.82017 0.688031 7.90039 0.607422L7.90137 0.606445C7.98151 0.525858 8.05487 0.499224 8.14453 0.5Z" fill="#26131B" stroke="#26131B"/>
</svg>

          </button>

        </div>

      {%- endif -%}

    </div>

  </g4u-tabs>

</section>

{% schema %}
{
  "name": "G4U · Ciencia y tabs",
  "tag": "section",
  "class": "section-g4u-science",
  "max_blocks": 4,

  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Nuestra harina"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "La ciencia detrás de nuestro pan"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción",
      "default": "<p>Una harina funcional desarrollada para lograr el sabor y la textura del pan tradicional, con beneficios nutricionales reales.</p>"
    },
    {
      "type": "text",
      "id": "tabs_label",
      "label": "Nombre accesible de tabs",
      "default": "Beneficios de nuestra harina"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto del enlace",
      "default": "Conocé nuestra harina"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace"
    }
  ],

  "blocks": [
    {
      "type": "tab",
      "name": "Tab",

      "settings": [
        {
          "type": "text",
          "id": "tab_label",
          "label": "Etiqueta",
          "default": "Menos carbohidratos"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Descripción de imagen",
          "default": "Espigas de trigo sobre harina"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Antetítulo",
          "default": "Almidón resistente RS4"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "El carbohidrato que se comporta como fibra."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Nuestra base está formulada con almidón resistente tipo 4 (RS4), que no se digiere como un carbohidrato tradicional.</p>"
        },
        {
          "type": "text",
          "id": "why_label",
          "label": "Título de beneficios",
          "default": "Por qué lo usamos"
        },
        {
          "type": "text",
          "id": "benefit_1",
          "label": "Beneficio 1",
          "default": "Menor impacto glucémico"
        },
        {
          "type": "text",
          "id": "benefit_2",
          "label": "Beneficio 2",
          "default": "Más fibra funcional"
        },
        {
          "type": "text",
          "id": "benefit_3",
          "label": "Beneficio 3",
          "default": "Mayor saciedad"
        },
        {
          "type": "text",
          "id": "benefit_4",
          "label": "Beneficio 4"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "G4U · Ciencia y tabs",
      "blocks": [
        { "type": "tab" },
        { "type": "tab" },
        { "type": "tab" },
        { "type": "tab" }
      ]
    }
  ]
}
{% endschema %}