<script src="{{ 'g4u-tabs.js' | asset_url }}" defer="defer"></script>

<section class="g4u-science" aria-labelledby="G4uScience-{{ section.id }}">
  <header class="g4u-science__header">
    <p class="g4u-science__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="g4u-science__title g4u-display" id="G4uScience-{{ section.id }}">{{ section.settings.title | escape }}</h2>
    <div class="g4u-science__intro rte">{{ section.settings.description }}</div>
  </header>

  <g4u-tabs>
    <div class="g4u-science__tablist" role="tablist" aria-label="{{ section.settings.tabs_label | escape }}">
      {%- for block in section.blocks -%}
        <button
          class="g4u-science__tab"
          id="G4uScienceTab-{{ section.id }}-{{ forloop.index }}"
          type="button"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-controls="G4uSciencePanel-{{ section.id }}-{{ forloop.index }}"
          tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
        >
          {{ forloop.index }}. {{ block.settings.tab_label | escape }}
        </button>
      {%- endfor -%}
    </div>

    <div class="g4u-science__panels">
      {%- for block in section.blocks -%}
        <article
          class="g4u-science__panel{% if forloop.first %} is-active{% endif %}"
          id="G4uSciencePanel-{{ section.id }}-{{ forloop.index }}"
          role="tabpanel"
          aria-labelledby="G4uScienceTab-{{ section.id }}-{{ forloop.index }}"
          {% unless forloop.first %}hidden{% endunless %}
          {{ block.shopify_attributes }}
        >
          <div class="g4u-science__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1400 | image_tag: class: 'g4u-science__image', loading: 'lazy', widths: '550, 800, 1100, 1400', sizes: '(min-width: 750px) 45vw, 100vw' }}
            {%- else -%}
              <img class="g4u-science__image" src="{{ 'g4u-flour-science.jpg' | asset_url }}" alt="{{ block.settings.image_alt | escape }}" width="1400" height="934" loading="lazy">
            {%- endif -%}
          </div>
          <div class="g4u-science__content">
            {%- if block.settings.tagline != blank -%}<p class="g4u-science__tagline">{{ block.settings.tagline | escape }}</p>{%- endif -%}
            <h3 class="g4u-science__panel-title g4u-display">{{ block.settings.heading | escape }}</h3>
            {%- if block.settings.text != blank -%}<div class="g4u-science__text rte">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.benefit_1 != blank or block.settings.benefit_2 != blank or block.settings.benefit_3 != blank -%}
             {%- if block.settings.why_label != blank -%}
  <p class="g4u-science__why">
    {{ block.settings.why_label | escape }}
  </p>
{%- endif -%}
              <ul class="g4u-science__benefits" role="list">
                {%- for benefit_index in (1..3) -%}
                  {%- assign benefit_key = 'benefit_' | append: benefit_index -%}
                  {%- if block.settings[benefit_key] != blank -%}
                    <li class="g4u-science__benefit"><img class="g4u-science__check" src="{{ 'g4u-icon-check.svg' | asset_url }}" alt="" width="20" height="20">{{ block.settings[benefit_key] | escape }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
            {%- if section.settings.link_label != blank -%}
              <a class="g4u-science__link" href="{{ section.settings.link | default: routes.root_url }}">{{ section.settings.link_label | escape }} <img src="{{ 'g4u-icon-chevron.svg' | asset_url }}" alt="" width="24" height="24"></a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
      {%- if section.blocks.size > 1 -%}
        <div class="g4u-science__arrows">
          <button class="g4u-science__arrow" type="button" data-g4u-tabs-previous aria-label="Contenido anterior"><img src="{{ 'g4u-icon-arrow-back.svg' | asset_url }}" alt="" width="24" height="24"></button>
          <button class="g4u-science__arrow" type="button" data-g4u-tabs-next aria-label="Contenido siguiente"><img src="{{ 'g4u-icon-arrow-forward.svg' | asset_url }}" alt="" width="24" height="24"></button>
        </div>
      {%- endif -%}
    </div>
  </g4u-tabs>
</section>

{% schema %}
{
  "name": "G4U · Ciencia y tabs",
  "tag": "section",
  "class": "section-g4u-science",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Nuestra harina" },
    { "type": "text", "id": "title", "label": "Título", "default": "La ciencia detrás de nuestro pan" },
    { "type": "richtext", "id": "description", "label": "Descripción", "default": "<p>Una harina funcional desarrollada para lograr el sabor y la textura del pan tradicional, con beneficios nutricionales reales.</p>" },
    { "type": "text", "id": "tabs_label", "label": "Nombre accesible de tabs", "default": "Beneficios de nuestra harina" },
    { "type": "text", "id": "why_label", "label": "Título de beneficios", "default": "Por qué lo usamos" },
    { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Conocé nuestra harina" },
    { "type": "url", "id": "link", "label": "Enlace" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "tab_label", "label": "Etiqueta", "default": "Menos carbohidratos" },
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "image_alt", "label": "Descripción de imagen", "default": "Espigas de trigo sobre harina" },
        { "type": "text", "id": "tagline", "label": "Antetítulo", "default": "Almidón resistente RS4" },
        { "type": "text", "id": "heading", "label": "Título", "default": "El carbohidrato que se comporta como fibra." },
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Nuestra base está formulada con almidón resistente tipo 4 (RS4), que no se digiere como un carbohidrato tradicional.</p>" },
        { "type": "text", "id": "benefit_1", "label": "Beneficio 1", "default": "Menor impacto glucémico" },
        { "type": "text", "id": "benefit_2", "label": "Beneficio 2", "default": "Más fibra funcional" },
        { "type": "text", "id": "benefit_3", "label": "Beneficio 3", "default": "Mayor saciedad" }
      ]
    }
  ],
  "presets": [{ "name": "G4U · Ciencia y tabs", "blocks": [{ "type": "tab" }, { "type": "tab" }, { "type": "tab" }, { "type": "tab" }] }]
}
{% endschema %}
