<section class="g4u-flour-formula" aria-labelledby="G4uFlourFormulaTitle-{{ section.id }}">
  <header class="g4u-flour-formula__header"><p class="g4u-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="g4u-flour-formula__title g4u-display" id="G4uFlourFormulaTitle-{{ section.id }}">{{ section.settings.title | escape }}</h2></header>
  <div class="g4u-flour-formula__grid">
    <div class="g4u-flour-formula__list">
      {%- for block in section.blocks limit: 2 -%}<article class="g4u-flour-formula__item" {{ block.shopify_attributes }}><img src="{{ block.settings.icon | default: 'g4u-flour-icon-starch.svg' | asset_url }}" alt="" width="48" height="48" loading="lazy"><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></article>{%- endfor -%}
    </div>
    <div class="g4u-flour-formula__media">{%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200', sizes: '(min-width: 750px) 540px, 90vw' }}{%- else -%}<img src="{{ 'g4u-flour-ingredients.png' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="4096" height="2734" loading="lazy">{%- endif -%}</div>
    <div class="g4u-flour-formula__list">
      {%- for block in section.blocks offset: 2 -%}<article class="g4u-flour-formula__item" {{ block.shopify_attributes }}><img src="{{ block.settings.icon | default: 'g4u-flour-icon-fiber.svg' | asset_url }}" alt="" width="48" height="48" loading="lazy"><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></article>{%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{"name":"G4U · Fórmula harina","tag":"section","class":"section-g4u-flour-formula","max_blocks":4,"settings":[{"type":"text","id":"eyebrow","label":"Antetítulo","default":"¿Cómo lo logramos?"},{"type":"text","id":"title","label":"Título","default":"Una fórmula donde cada ingrediente tiene un propósito"},{"type":"image_picker","id":"image","label":"Imagen"},{"type":"text","id":"image_alt","label":"Descripción de imagen","default":"Espigas de trigo sobre harina"}],"blocks":[{"type":"ingredient","name":"Ingrediente","settings":[{"type":"select","id":"icon","label":"Ícono","options":[{"value":"g4u-flour-icon-starch.svg","label":"Almidón"},{"value":"g4u-flour-icon-protein.svg","label":"Proteína"},{"value":"g4u-flour-icon-fiber.svg","label":"Fibra"}],"default":"g4u-flour-icon-starch.svg"},{"type":"text","id":"title","label":"Título","default":"Almidón resistente RS4"},{"type":"textarea","id":"text","label":"Descripción","default":"Reduce el impacto de los carbohidratos disponibles y aporta fibra funcional, ayudando a lograr un mejor perfil nutricional."}]}],"presets":[{"name":"G4U · Fórmula harina","blocks":[{"type":"ingredient","settings":{"icon":"g4u-flour-icon-starch.svg","title":"Almidón resistente RS4","text":"Reduce el impacto de los carbohidratos disponibles y aporta fibra funcional, ayudando a lograr un mejor perfil nutricional."}},{"type":"ingredient","settings":{"icon":"g4u-flour-icon-protein.svg","title":"Proteínas de alta calidad","text":"Combinamos distintas fuentes proteicas para aumentar el contenido de proteínas y conservar una textura suave y esponjosa."}},{"type":"ingredient","settings":{"icon":"g4u-flour-icon-fiber.svg","title":"Fibras funcionales","text":"Ingredientes como la inulina y el psyllium aportan fibra y ayudan a prolongar la sensación de saciedad."}},{"type":"ingredient","settings":{"icon":"g4u-flour-icon-fiber.svg","title":"Tecnología alimentaria","text":"Cada componente fue cuidadosamente seleccionado para lograr estabilidad, frescura y una experiencia similar a la del pan tradicional."}}]}]}
{% endschema %}
