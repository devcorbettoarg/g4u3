      current,
      target,
      amount
    ) => {

      return (
        current +
        (
          target -
          current
        ) *
        amount
      );

    };


    const smoothstep = (
      value
    ) => {

      const x =
        clamp(
          value,
          0,
          1
        );


      return (
        x *
        x *
        (
          3 -
          (
            2 *
            x
          )
        )
      );

    };


    /* ==========================================================
       MOBILE STATIC STATE
       ========================================================== */

    const setCssVar = (
      name,
      value
    ) => {

      section.style.setProperty(
        name,
        value
      );

    };


    const applyMobileStaticState = () => {

      /* Partículas totalmente estáticas */
      setCssVar(
        '--g4u-particles-one-x',
        '0px'
      );

      setCssVar(
        '--g4u-particles-one-y',
        '0px'
      );

      setCssVar(
        '--g4u-particles-one-r',
        '0deg'
      );

      setCssVar(
        '--g4u-particles-two-x',
        '0px'
      );

      setCssVar(
        '--g4u-particles-two-y',
        '0px'
      );

      setCssVar(
        '--g4u-particles-two-r',
        '0deg'
      );


      /* Productos en su composición final, sin movimiento */
      Object.entries(
        mobileStaticProducts
      ).forEach(
        ([name, config]) => {

          setCssVar(
            `--g4u-${name}-x`,
            '0px'
          );

          setCssVar(
            `--g4u-${name}-y`,
            '0px'
          );

          setCssVar(
            `--g4u-${name}-rz`,
            '0deg'
          );

          setCssVar(
            `--g4u-${name}-rx`,
            '0deg'
          );

          setCssVar(
            `--g4u-${name}-ry`,
            '0deg'
          );

          setCssVar(
            `--g4u-${name}-scale`,
            String(
              config.displayScale
            )
          );

        }
      );


      targetPointerX =
        0;

      targetPointerY =
        0;

      pointerX =
        0;

      pointerY =
        0;

      targetScroll =
        0;

      currentScroll =
        0;

      targetApproach =
        1;

      currentApproach =
        1;

    };


    /* ==========================================================
       SCROLL
       ========================================================== */

    const updateScroll = () => {

      if (
        !desktopQuery.matches ||
        reducedMotionQuery.matches
      ) {
        return;
      }


      const rect =
        section.getBoundingClientRect();


      const viewportHeight =
        window.innerHeight;


      /* ========================================================
         FULL PARALLAX PROGRESS
         ======================================================== */

      const sectionCenter =
        rect.top +
        (
          rect.height /
          2
        );


      const viewportCenter =
        viewportHeight /
        2;


      const travelRange =
        (
          viewportHeight +
          rect.height
        ) /
        2;


      targetScroll =
        clamp(
          (
            viewportCenter -
            sectionCenter
          ) /
          travelRange,
          -1,
          1
        );


      /* ========================================================
         APPROACH
         ======================================================== */

      const start =
        viewportHeight *
        1.25;


      const end =
        viewportHeight *
        -0.02;


      const raw =
        clamp(
          (
            start -
            rect.top
          ) /
          (
            start -
            end
          ),
          0,
          1
        );


      targetApproach =
        smoothstep(
          raw
        );

    };


    /* ==========================================================
       POINTER
       ========================================================== */

    const updatePointer = (
      event
    ) => {

      if (
        !desktopQuery.matches ||
        reducedMotionQuery.matches
      ) {
        return;
      }


      const rect =
        section.getBoundingClientRect();


      targetPointerX =
        clamp(
          (
            (
              event.clientX -
              rect.left
            ) /
            rect.width -
            0.5
          ) *
          2,
          -1,
          1
        );


      targetPointerY =
        clamp(
          (
            (
              event.clientY -
              rect.top
            ) /
            rect.height -
            0.5
          ) *
          2,
          -1,
          1
        );

    };


    const resetPointer = () => {

      targetPointerX =
        0;

      targetPointerY =
        0;

    };


    /* ==========================================================
       ORGANIC MOTION
       ========================================================== */

    const getOrganic = (
      time,
      config
    ) => {

      const t =
        time *
        config.frequency;


      const waveA =
        Math.sin(
          t +
          config.phase
        );


      const waveB =
        Math.sin(
          (
            t *
            1.67
          ) +
          (
            config.phase *
            1.8
          )
        );


      const waveC =
        Math.cos(
          (
            t *
            0.63
          ) +
          (
            config.phase *
            0.75
          )
        );


      return {

        x:
          (
            (
              waveA *
              0.52
            ) +
            (
              waveB *
              0.31
            ) +
            (
              waveC *
              0.17
            )
          ) *
          config.floatX,


        y:
          (
            (
              waveA *
              0.27
            ) +
            (
              waveB *
              0.48
            ) +
            (
              waveC *
              0.25
            )
          ) *
          config.floatY

      };

    };


    /* ==========================================================
       PARTICLES RENDER
       ========================================================== */

    const renderParticle = (
      key,
      config,
      time
    ) => {

      const organic =
        getOrganic(
          time,
          config
        );


      const x =
        (
          pointerX *
          config.mouseX
        ) +
        organic.x;


      const y =
        (
          currentScroll *
          config.scrollY
        ) +
        (
          pointerY *
          config.mouseY
        ) +
        organic.y;


      const rotation =
        Math.sin(
          (
            time *
            config.frequency *
            0.75
          ) +
          config.phase
        ) *
        config.rotate;


      section.style.setProperty(
        `--g4u-particles-${key}-x`,
        `${x.toFixed(2)}px`
      );


      section.style.setProperty(
        `--g4u-particles-${key}-y`,
        `${y.toFixed(2)}px`
      );


      section.style.setProperty(
        `--g4u-particles-${key}-r`,
        `${rotation.toFixed(3)}deg`
      );

    };


    /* ==========================================================
       PRODUCT RENDER
       ========================================================== */

    const renderProduct = (
      name,
      config,
      time
    ) => {

      const organic =
        getOrganic(
          time,
          config
        );


      /*
       * 1 = entry
       * 0 = final composition
       */
      const far =
        1 -
        currentApproach;


      /* ========================================================
         ENTRY VECTOR
         ======================================================== */

      const entryX =
        config.entryX *
        far;


      const entryY =
        config.entryY *
        far;


      /* ========================================================
         X
         ======================================================== */

      const x =
        entryX +

        (
          currentScroll *
          config.scrollX
        ) +

        (
          pointerX *
          config.mouseX
        ) +

        organic.x;


      /* ========================================================
         Y
         ======================================================== */

      const y =
        entryY +

        (
          currentScroll *
          config.scrollY
        ) +

        (
          pointerY *
          config.mouseY
        ) +

        organic.y;


      /* ========================================================
         SCALE
         ======================================================== */

      const baseScale =
        lerp(
          config.startScale,
          config.finalScale,
          currentApproach
        );


      const pulse =
        Math.sin(
          currentApproach *
          Math.PI
        ) *
        config.scalePulse;


      const scale =
        (
          baseScale +
          pulse
        ) *
        config.displayScale;


      /* ========================================================
         ROTATE Z
         ======================================================== */

      const entryRotation =
        config.startRotate *
        far;


      const organicRotation =
        Math.sin(
          (
            time *
            config.frequency *
            0.80
          ) +
          config.phase
        ) *
        0.085;


      const rotateZ =
        entryRotation +
        organicRotation;


      /* ========================================================
         3D TILT
         ======================================================== */

      const rotateX =
        (
          config.tiltX *
          far
        ) -
        (
          pointerY *
          config.pointerTilt
        );


      const rotateY =
        (
          config.tiltY *
          far
        ) +
        (
          pointerX *
          config.pointerTilt
        );


      /* ========================================================
         WRITE
         ======================================================== */

      section.style.setProperty(
        `--g4u-${name}-x`,
        `${x.toFixed(2)}px`
      );


      section.style.setProperty(
        `--g4u-${name}-y`,
        `${y.toFixed(2)}px`
      );


      section.style.setProperty(
        `--g4u-${name}-scale`,
        scale.toFixed(4)
      );


      section.style.setProperty(
        `--g4u-${name}-rz`,
        `${rotateZ.toFixed(3)}deg`
      );


      section.style.setProperty(
        `--g4u-${name}-rx`,
        `${rotateX.toFixed(3)}deg`
      );


      section.style.setProperty(
        `--g4u-${name}-ry`,
        `${rotateY.toFixed(3)}deg`
      );

    };


    /* ==========================================================
       DESKTOP-ONLY LOOP

       En mobile no se ejecuta ningún frame de parallax.
       ========================================================== */

    let animationFrameId =
      null;


    const render = (
      time
    ) => {

      animationFrameId =
        null;


      if (
        !desktopQuery.matches ||
        reducedMotionQuery.matches
      ) {
        return;
      }


      /* ========================================================
         POINTER DAMPING
         Desktop aprobado: sin cambios.
         ======================================================== */

      pointerX =
        lerp(
          pointerX,
          targetPointerX,
          0.09
        );


      pointerY =
        lerp(
          pointerY,
          targetPointerY,
          0.09
        );


      /* ========================================================
         SCROLL DAMPING
         Desktop aprobado: sin cambios.
         ======================================================== */

      currentScroll =
        lerp(
          currentScroll,
          targetScroll,
          0.080
        );


      /* ========================================================
         APPROACH DAMPING
         Desktop aprobado: sin cambios.
         ======================================================== */

      currentApproach =
        lerp(
          currentApproach,
          targetApproach,
          0.046
        );


      /* ========================================================
         DRAW
         ======================================================== */

      if (visible) {

        renderParticle(
          'one',
          desktopParticles.one,
          time
        );


        renderParticle(
          'two',
          desktopParticles.two,
          time
        );


        renderProduct(
          'snack',
          desktopProducts.snack,
          time
        );


        renderProduct(
          'bread',
          desktopProducts.bread,
          time
        );


        renderProduct(
          'tortilla',
          desktopProducts.tortilla,
          time
        );

      }


      animationFrameId =
        requestAnimationFrame(
          render
        );

    };


    const startDesktopAnimation = () => {

      if (
        !desktopQuery.matches ||
        reducedMotionQuery.matches ||
        animationFrameId !== null
      ) {
        return;
      }


      updateScroll();


      animationFrameId =
        requestAnimationFrame(
          render
        );

    };


    const stopDesktopAnimation = () => {

      if (
        animationFrameId === null
      ) {
        return;
      }


      cancelAnimationFrame(
        animationFrameId
      );


      animationFrameId =
        null;

    };


    const syncMotionMode = () => {

      resetPointer();


      if (
        desktopQuery.matches &&
        !reducedMotionQuery.matches
      ) {

        updateScroll();

        startDesktopAnimation();

        return;

      }


      stopDesktopAnimation();


      if (
        !desktopQuery.matches
      ) {

        applyMobileStaticState();

      }

    };


    /* ==========================================================
       OBSERVER
       ========================================================== */

    if (
      'IntersectionObserver' in window
    ) {

      const observer =
        new IntersectionObserver(
          (entries) => {

            entries.forEach(
              (entry) => {

                visible =
                  entry.isIntersecting;


                if (visible) {

                  updateScroll();

                }

              }
            );

          },
          {
            rootMargin:
              '35% 0px 35% 0px'
          }
        );


      observer.observe(
        section
      );

    }


    /* ==========================================================
       EVENTS
       ========================================================== */

    window.addEventListener(
      'scroll',
      () => {

        if (
          desktopQuery.matches
        ) {

          updateScroll();

        }

      },
      {
        passive:
          true
      }
    );


    window.addEventListener(
      'resize',
      () => {

        resetPointer();


        if (
          desktopQuery.matches
        ) {

          updateScroll();

        } else {

          applyMobileStaticState();

        }

      },
      {
        passive:
          true
      }
    );


    section.addEventListener(
      'pointermove',
      updatePointer,
      {
        passive:
          true
      }
    );


    section.addEventListener(
      'pointerleave',
      resetPointer,
      {
        passive:
          true
      }
    );


    desktopQuery.addEventListener?.(
      'change',
      syncMotionMode
    );


    reducedMotionQuery.addEventListener?.(
      'change',
      syncMotionMode
    );


    /* ==========================================================
       INIT
       ========================================================== */

    syncMotionMode();


  })();
</script>


