<section
  class="g4u-about-manifesto"
  id="G4uAboutManifesto-{{ section.id }}"
  aria-labelledby="G4uAboutManifestoTitle-{{ section.id }}"
  data-g4u-manifesto-parallax
>
  <div class="g4u-about-manifesto__copy">
    <h2
      class="g4u-about-manifesto__title g4u-display"
      id="G4uAboutManifestoTitle-{{ section.id }}"
    >
      Creemos en la <em>nutrición inteligente,</em><br>
      la que combina <strong>ciencia, sabor</strong><br>
      y <strong>bienestar</strong> real.<br>
      En los alimentos que<br>
      no prometen magia,<br>
      sino <em>resultados</em> auténticos.<br>
      Creemos en la <strong>transparencia,</strong><br>
      en los <em>ingredientes limpios</em><br>
      y en las <strong>decisiones conscientes.</strong><br>
      Creemos que lo <em>saludable</em><br>
      no tiene que ser aburrido.
    </h2>

    <div class="g4u-about-manifesto__closing g4u-display">
      <p>{{ section.settings.closing | escape | newline_to_br }}</p>
      <p>{{ section.settings.closing_accent | escape | newline_to_br }}</p>
    </div>
  </div>


  <div class="g4u-about-manifesto__art" aria-hidden="true">

    {%- if section.settings.dust_image != blank -%}
      {{
        section.settings.dust_image
        | image_url: width: 1024
        | image_tag:
          class: 'g4u-about-manifesto__dust',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__dust"
        src="{{ 'g4u-about-manifesto-dust.png' | asset_url }}"
        alt=""
        width="1024"
        height="1536"
        loading="lazy"
      >
    {%- endif -%}


    {%- if section.settings.texture_image != blank -%}
      {{
        section.settings.texture_image
        | image_url: width: 1024
        | image_tag:
          class: 'g4u-about-manifesto__texture',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__texture"
        src="{{ 'g4u-about-manifesto-texture.png' | asset_url }}"
        alt=""
        width="1024"
        height="1535"
        loading="lazy"
      >
    {%- endif -%}


    {%- if section.settings.snack_image != blank -%}
      {{
        section.settings.snack_image
        | image_url: width: 456
        | image_tag:
          class: 'g4u-about-manifesto__object g4u-about-manifesto__object--snack',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__object g4u-about-manifesto__object--snack"
        src="{{ 'g4u-about-snack.png' | asset_url }}"
        alt=""
        width="456"
        height="458"
        loading="lazy"
      >
    {%- endif -%}


    {%- if section.settings.bread_image != blank -%}
      {{
        section.settings.bread_image
        | image_url: width: 866
        | image_tag:
          class: 'g4u-about-manifesto__object g4u-about-manifesto__object--bread',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__object g4u-about-manifesto__object--bread"
        src="{{ 'g4u-about-bread.png' | asset_url }}"
        alt=""
        width="866"
        height="926"
        loading="lazy"
      >
    {%- endif -%}


    {%- if section.settings.tortilla_image != blank -%}
      {{
        section.settings.tortilla_image
        | image_url: width: 490
        | image_tag:
          class: 'g4u-about-manifesto__object g4u-about-manifesto__object--tortilla',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__object g4u-about-manifesto__object--tortilla"
        src="{{ 'g4u-about-tortilla.png' | asset_url }}"
        alt=""
        width="490"
        height="449"
        loading="lazy"
      >
    {%- endif -%}

  </div>
</section>


<style>
  /* ============================================================
     G4U · MANIFIESTO
     CINEMATIC DEPTH PARALLAX V2

     Objetivos:
     - partículas siempre al fondo
     - fondo uniforme #500322
     - PNG transparentes sin conflictos
     - productos agrupados
     - profundidad mediante Z + escala
     - 3D muy leve
     - movimiento orgánico
     ============================================================ */


  /* ============================================================
     SECTION
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }} {
    position: relative;

    background-color: #500322 !important;
    background-image: none !important;

    isolation: isolate;
  }


  /* ============================================================
     TEXT
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__copy {
    position: relative;
    z-index: 5;
  }


  /* ============================================================
     ART CONTAINER

     IMPORTANTE:
     No ponemos perspective ni preserve-3d acá.

     Eso permite que las partículas con mix-blend-mode
     se compongan directamente contra #500322.
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__art {
    background-color: #500322 !important;
    background-image: none !important;

    isolation: isolate;

    transform-style: flat;

    /*
     * No usar overflow hidden aquí salvo que tu diseño original
     * ya lo necesite. Los objetos necesitan libertad para moverse.
     */
  }


  /* ============================================================
     PARTICLES / BACKGROUND

     SIEMPRE permanecen detrás de los panes.
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__dust,

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__texture {
    z-index: 0 !important;

    pointer-events: none;

    mix-blend-mode: screen;

    background: transparent !important;

    backface-visibility: hidden;

    will-change:
      translate,
      rotate;
  }


  /* ============================================================
     PRODUCTS

     Estos deben conservar transparencia PNG normal.

     No blend mode.
     No background.
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__object {
    z-index: 2 !important;

    pointer-events: none;

    background:
      transparent !important;

    background-color:
      transparent !important;

    background-image:
      none !important;

    mix-blend-mode:
      normal !important;

    opacity: 1;

    transform-origin:
      center center;

    backface-visibility:
      hidden;

    will-change:
      transform,
      translate,
      rotate;
  }


  /* ============================================================
     PRODUCT 3D

     Cada producto maneja su propia perspectiva.

     Esto evita contaminar la composición del background
     y del mix-blend-mode de las partículas.
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__object--snack {
    transform:
      perspective(1200px)
      translateZ(
        var(--g4u-snack-z, 0px)
      )
      rotateX(
        var(--g4u-snack-rx, 0deg)
      )
      rotateY(
        var(--g4u-snack-ry, 0deg)
      )
      scale(
        var(--g4u-snack-depth-scale, 1)
      );
  }


  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__object--bread {
    transform:
      perspective(1250px)
      translateZ(
        var(--g4u-bread-z, 0px)
      )
      rotateX(
        var(--g4u-bread-rx, 0deg)
      )
      rotateY(
        var(--g4u-bread-ry, 0deg)
      )
      scale(
        var(--g4u-bread-depth-scale, 1)
      );
  }


  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__object--tortilla {
    transform:
      perspective(1200px)
      translateZ(
        var(--g4u-tortilla-z, 0px)
      )
      rotateX(
        var(--g4u-tortilla-rx, 0deg)
      )
      rotateY(
        var(--g4u-tortilla-ry, 0deg)
      )
      scale(
        var(--g4u-tortilla-depth-scale, 1)
      );
  }


  /* ============================================================
     DESKTOP
     ============================================================ */

  @media screen and (min-width: 990px) {


    /* ==========================================================
       DUST
       ========================================================== */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__dust {
      translate:
        var(--g4u-dust-x, 0px)
        var(--g4u-dust-y, 0px);

      rotate:
        var(--g4u-dust-rotate, 0deg);
    }


    /* ==========================================================
       TEXTURE
       ========================================================== */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__texture {
      translate:
        var(--g4u-texture-x, 0px)
        var(--g4u-texture-y, 0px);

      rotate:
        var(--g4u-texture-rotate, 0deg);

      /*
       * Leve overscan para que nunca aparezca
       * el borde del asset al moverse.
       */
      scale: 1.055;
    }


    /* ==========================================================
       SNACK
       ========================================================== */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--snack {
      translate:
        var(--g4u-snack-x, 0px)
        var(--g4u-snack-y, 0px);

      rotate:
        var(--g4u-snack-rotate, 0deg);
    }


    /* ==========================================================
       BREAD
       ========================================================== */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--bread {
      translate:
        var(--g4u-bread-x, 0px)
        var(--g4u-bread-y, 0px);

      rotate:
        var(--g4u-bread-rotate, 0deg);
    }


    /* ==========================================================
       TORTILLA
       ========================================================== */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--tortilla {
      translate:
        var(--g4u-tortilla-x, 0px)
        var(--g4u-tortilla-y, 0px);

      rotate:
        var(--g4u-tortilla-rotate, 0deg);
    }

  }


  /* ============================================================
     MOBILE
     ============================================================ */

  @media screen and (max-width: 989px) {


    /* ==========================================================
       DUST
       ========================================================== */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__dust {
      translate:
        calc(
          var(--g4u-dust-x, 0px)
          - 4px
        )
        calc(
          var(--g4u-dust-y, 0px)
          - 8px
        );

      rotate:
        var(--g4u-dust-rotate, 0deg);

      scale: 1.04;
    }


    /* ==========================================================
       TEXTURE
       ========================================================== */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__texture {
      translate:
        calc(
          var(--g4u-texture-x, 0px)
          + 4px
        )
        var(--g4u-texture-y, 0px);

      rotate:
        var(--g4u-texture-rotate, 0deg);

      scale: 1.09;
    }


    /* ==========================================================
       SNACK
       ========================================================== */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--snack {
      translate:
        calc(
          var(--g4u-snack-x, 0px)
          - 5px
        )
        calc(
          var(--g4u-snack-y, 0px)
          - 28px
        );

      rotate:
        var(--g4u-snack-rotate, 0deg);

      scale: 0.94;
    }


    /* ==========================================================
       BREAD
       ========================================================== */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--bread {
      translate:
        calc(
          var(--g4u-bread-x, 0px)
          + 4px
        )
        calc(
          var(--g4u-bread-y, 0px)
          + 3px
        );

      rotate:
        var(--g4u-bread-rotate, 0deg);

      scale: 0.93;
    }


    /* ==========================================================
       TORTILLA
       ========================================================== */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--tortilla {
      translate:
        calc(
          var(--g4u-tortilla-x, 0px)
          - 7px
        )
        calc(
          var(--g4u-tortilla-y, 0px)
          + 32px
        );

      rotate:
        var(--g4u-tortilla-rotate, 0deg);

      scale: 0.95;
    }

  }


  /* ============================================================
     MOBILE EXTRA SMALL
     ============================================================ */

  @media screen and (max-width: 480px) {

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--snack {
      translate:
        calc(
          var(--g4u-snack-x, 0px)
          - 7px
        )
        calc(
          var(--g4u-snack-y, 0px)
          - 34px
        );

      scale: 0.91;
    }


    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--bread {
      translate:
        calc(
          var(--g4u-bread-x, 0px)
          + 4px
        )
        calc(
          var(--g4u-bread-y, 0px)
          + 3px
        );

      scale: 0.91;
    }


    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--tortilla {
      translate:
        calc(
          var(--g4u-tortilla-x, 0px)
          - 8px
        )
        calc(
          var(--g4u-tortilla-y, 0px)
          + 38px
        );

      scale: 0.92;
    }

  }


  /* ============================================================
     REDUCED MOTION
     ============================================================ */

  @media (
    prefers-reduced-motion: reduce
  ) {

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__dust,

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__texture,

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object {
      translate:
        0 0 !important;

      rotate:
        0deg !important;
    }


    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object {
      transform:
        none !important;
    }

  }
</style>


<script>
  (() => {

    const section =
      document.querySelector(
        '#G4uAboutManifesto-{{ section.id }}'
      );


    if (!section) return;


    /* ==========================================================
       PREVENT DOUBLE INIT
       ========================================================== */

    if (
      section.dataset
        .g4uParallaxInitialized ===
      'true'
    ) {
      return;
    }


    section.dataset
      .g4uParallaxInitialized =
      'true';


    /* ==========================================================
       MEDIA
       ========================================================== */

    const desktopQuery =
      window.matchMedia(
        '(min-width: 990px)'
      );


    const reducedMotionQuery =
      window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      );


    /* ==========================================================
       DESKTOP CONFIGURATION
       ========================================================== */

    const desktopLayers = {


      /* ========================================================
         PARTICLES

         Se mueven MUCHO menos que los productos.

         Esto hace que permanezcan psicológicamente
         en el plano del fondo.
         ======================================================== */

      dust: {
        scrollY: 12,

        mouseX: -2.5,
        mouseY: -2,

        floatX: 1.5,
        floatY: 2,

        frequency: 0.00028,
        phase: 0.7,

        energy: 1.5,
        rotate: 0.025
      },


      texture: {
        scrollY: -18,

        mouseX: 3,
        mouseY: 2.5,

        floatX: 2,
        floatY: 3,

        frequency: 0.00024,
        phase: 2.4,

        energy: 2,
        rotate: -0.035
      },


      /* ========================================================
         SNACK

         Antes:
         -72px lateral.

         Ahora:
         sólo -18px.

         La profundidad proviene principalmente
         de Z y escala.
         ======================================================== */

      snack: {
        scrollY: -55,

        mouseX: 13,
        mouseY: 10,

        floatX: 3.4,
        floatY: 4.5,

        frequency: 0.00052,
        phase: 1.2,

        energy: 5.5,
        rotate: 0.68,


        depthX: -18,
        depthY: -8,


        farZ: -145,
        nearZ: 5,


        farScale: 0.985,
        nearScale: 1,


        scalePulse: 0.012,


        tiltX: 0.75,
        tiltY: -1.10,


        pointerTilt: 0.42
      },


      /* ========================================================
         BREAD

         Más estable y pesado.
         ======================================================== */

      bread: {
        scrollY: -38,

        mouseX: 8,
        mouseY: 6.5,

        floatX: 2.8,
        floatY: 3.5,

        frequency: 0.00038,
        phase: 3.8,

        energy: 4,
        rotate: -0.32,


        depthX: 2,
        depthY: 9,


        farZ: -110,
        nearZ: 7,


        farScale: 0.99,
        nearScale: 1,


        scalePulse: 0.008,


        tiltX: -0.55,
        tiltY: 0.70,


        pointerTilt: 0.32
      },


      /* ========================================================
         TORTILLA

         Apenas abre hacia la derecha.
         ======================================================== */

      tortilla: {
        scrollY: -47,

        mouseX: -9,
        mouseY: -7,

        floatX: 3,
        floatY: 4,

        frequency: 0.00047,
        phase: 5.1,

        energy: 4.5,
        rotate: -0.48,


        depthX: 18,
        depthY: 10,


        farZ: -135,
        nearZ: 5,


        farScale: 0.985,
        nearScale: 1,


        scalePulse: 0.010,


        tiltX: 0.65,
        tiltY: 1.00,


        pointerTilt: 0.38
      }

    };


    /* ==========================================================
       MOBILE CONFIGURATION
       ========================================================== */

    const mobileLayers = {


      dust: {
        scrollY: 7,

        mouseX: 0,
        mouseY: 0,

        floatX: 1,
        floatY: 1.5,

        frequency: 0.00028,
        phase: 0.7,

        energy: 1,
        rotate: 0.018
      },


      texture: {
        scrollY: -11,

        mouseX: 0,
        mouseY: 0,

        floatX: 1.5,
        floatY: 2,

        frequency: 0.00023,
        phase: 2.4,

        energy: 1.5,
        rotate: -0.025
      },


      snack: {
        scrollY: -36,

        mouseX: 0,
        mouseY: 0,

        floatX: 2.4,
        floatY: 3.5,

        frequency: 0.00055,
        phase: 1.2,

        energy: 4,
        rotate: 0.42,


        depthX: -8,
        depthY: -5,


        farZ: -72,
        nearZ: 2,


        farScale: 0.99,
        nearScale: 1,


        scalePulse: 0.006,


        tiltX: 0.30,
        tiltY: -0.45,


        pointerTilt: 0
      },


      bread: {
        scrollY: -24,

        mouseX: 0,
        mouseY: 0,

        floatX: 1.8,
        floatY: 2.5,

        frequency: 0.00036,
        phase: 3.8,

        energy: 3,
        rotate: -0.20,


        depthX: 1,
        depthY: 5,


        farZ: -58,
        nearZ: 3,


        farScale: 0.992,
        nearScale: 1,


        scalePulse: 0.005,


        tiltX: -0.20,
        tiltY: 0.30,


        pointerTilt: 0
      },


      tortilla: {
        scrollY: -31,

        mouseX: 0,
        mouseY: 0,

        floatX: 2.2,
        floatY: 3,

        frequency: 0.00047,
        phase: 5.1,

        energy: 3.5,
        rotate: -0.30,


        depthX: 8,
        depthY: 5,


        farZ: -68,
        nearZ: 2,


        farScale: 0.99,
        nearScale: 1,


        scalePulse: 0.006,


        tiltX: 0.25,
        tiltY: 0.40,


        pointerTilt: 0
      }

    };


    /* ==========================================================
       CURRENT CONFIG
       ========================================================== */

    const getLayers = () => {

      return desktopQuery.matches
        ? desktopLayers
        : mobileLayers;

    };


    /* ==========================================================
       STATE
       ========================================================== */

    let targetPointerX = 0;
    let targetPointerY = 0;


    let pointerX = 0;
    let pointerY = 0;


    let targetScrollProgress = 0;
    let scrollProgress = 0;


    /*
     * 0 = objetos en plano lejano
     * 1 = objetos en composición final
     */
    let targetApproachProgress = 0;
    let approachProgress = 0;


    let targetEnergy = 0;
    let energy = 0;


    let previousScrollY =
      window.scrollY;


    let previousScrollTime =
      performance.now();


    let isVisible = true;


    /* ==========================================================
       HELPERS
       ========================================================== */

    const clamp = (
      value,
      min,
      max
    ) => {

      return Math.min(
        Math.max(
          value,
          min
        ),
        max
      );

    };


    const lerp = (
      current,
      target,
      amount
    ) => {

      return (
        current +
        (
          target -
          current
        ) *
        amount
      );

    };


    const smoothstep = (
      edge0,
      edge1,
      value
    ) => {

      const x =
        clamp(
          (
            value -
            edge0
          ) /
          (
            edge1 -
            edge0
          ),
          0,
          1
        );


      return (
        x *
        x *
        (
          3 -
          (
            2 *
            x
          )
        )
      );

    };


    const enabled = () => {

      return (
        !reducedMotionQuery.matches
      );

    };


    /* ==========================================================
       SCROLL
       ========================================================== */

    const updateScrollTarget = () => {

      if (!enabled()) return;


      const rect =
        section.getBoundingClientRect();


      const viewportHeight =
        window.innerHeight;


      /* ========================================================
         PARALLAX PROGRESS

         -1 → sección por debajo
          0 → centro
          1 → sección por encima
         ======================================================== */

      const sectionCenter =
        rect.top +
        (
          rect.height / 2
        );


      const viewportCenter =
        viewportHeight / 2;


      const distance =
        viewportCenter -
        sectionCenter;


      const range =
        (
          viewportHeight +
          rect.height
        ) / 2;


      targetScrollProgress =
        clamp(
          distance / range,
          -1,
          1
        );


      /* ========================================================
         APPROACH / DEPTH

         Empieza un poco antes de que la sección entre.

         Finaliza cuando la cabecera de la sección está
         aproximadamente en el 15% superior del viewport.

         Resultado:
         acercamiento progresivo y largo.
         ======================================================== */

      const approachStart =
        viewportHeight * 1.08;


      const approachEnd =
        viewportHeight * 0.15;


      const rawApproach =
        clamp(
          (
            approachStart -
            rect.top
          ) /
          (
            approachStart -
            approachEnd
          ),
          0,
          1
        );


      targetApproachProgress =
        smoothstep(
          0,
          1,
          rawApproach
        );


      /* ========================================================
         SCROLL VELOCITY
         ======================================================== */

      const now =
        performance.now();


      const currentScrollY =
        window.scrollY;


      const deltaY =
        currentScrollY -
        previousScrollY;


      const deltaTime =
        Math.max(
          now -
          previousScrollTime,
          16
        );


      const velocity =
        Math.abs(
          deltaY
        ) /
        deltaTime;


      const velocityMultiplier =
        desktopQuery.matches
          ? 1.20
          : 0.90;


      const velocityEnergy =
        clamp(
          velocity *
          velocityMultiplier,
          0,
          1
        );


      targetEnergy =
        Math.max(
          targetEnergy,
          velocityEnergy
        );


      previousScrollY =
        currentScrollY;


      previousScrollTime =
        now;

    };


    /* ==========================================================
       POINTER
       ========================================================== */

    const updatePointerTarget = (
      event
    ) => {

      if (
        !enabled() ||
        !desktopQuery.matches
      ) {
        return;
      }


      const rect =
        section.getBoundingClientRect();


      const normalizedX =
        (
          event.clientX -
          rect.left
        ) /
        rect.width;


      const normalizedY =
        (
          event.clientY -
          rect.top
        ) /
        rect.height;


      targetPointerX =
        clamp(
          (
            normalizedX -
            0.5
          ) *
          2,
          -1,
          1
        );


      targetPointerY =
        clamp(
          (
            normalizedY -
            0.5
          ) *
          2,
          -1,
          1
        );

    };


    const resetPointer = () => {

      targetPointerX = 0;
      targetPointerY = 0;

    };


    /* ==========================================================
       ORGANIC MOTION
       ========================================================== */

    const getOrganicMotion = (
      time,
      config
    ) => {

      const t =
        time *
        config.frequency;


      const waveA =
        Math.sin(
          t +
          config.phase
        );


      const waveB =
        Math.sin(
          (
            t *
            1.73
          ) +
          (
            config.phase *
            1.8
          )
        );


      const waveC =
        Math.cos(
          (
            t *
            0.61
          ) +
          (
            config.phase *
            0.73
          )
        );


      const organicX =
        (
          (
            waveA *
            0.55
          ) +
          (
            waveB *
            0.30
          ) +
          (
            waveC *
            0.15
          )
        ) *
        config.floatX;


      const organicY =
        (
          (
            waveA *
            0.25
          ) +
          (
            waveB *
            0.50
          ) +
          (
            waveC *
            0.25
          )
        ) *
        config.floatY;


      return {
        x: organicX,
        y: organicY
      };

    };


    /* ==========================================================
       SET VARIABLES
       ========================================================== */

    const setLayerVariables = (
      name,
      config,
      time
    ) => {

      const organic =
        getOrganicMotion(
          time,
          config
        );


      /* ========================================================
         SCROLL INERTIA
         ======================================================== */

      const accelerationX =
        organic.x *
        energy *
        (
          desktopQuery.matches
            ? 0.48
            : 0.30
        );


      const accelerationY =
        Math.sin(
          (
            time *
            0.001
          ) +
          config.phase
        ) *
        config.energy *
        energy;


      /* ========================================================
         DEPTH POSITION

         IMPORTANTE:
         Ahora la dispersión X/Y es mínima.

         La sensación de distancia ocurre principalmente
         en translateZ.
         ======================================================== */

      const farAmount =
        1 -
        approachProgress;


      const depthOffsetX =
        config.depthX !== undefined
          ? (
              config.depthX *
              farAmount
            )
          : 0;


      const depthOffsetY =
        config.depthY !== undefined
          ? (
              config.depthY *
              farAmount
            )
          : 0;


      /* ========================================================
         X
         ======================================================== */

      const x =
        (
          pointerX *
          config.mouseX
        ) +
        organic.x +
        accelerationX +
        depthOffsetX;


      /* ========================================================
         Y
         ======================================================== */

      const y =
        (
          scrollProgress *
          config.scrollY
        ) +
        (
          pointerY *
          config.mouseY
        ) +
        organic.y +
        accelerationY +
        depthOffsetY;


      section.style.setProperty(
        `--g4u-${name}-x`,
        `${x.toFixed(2)}px`
      );


      section.style.setProperty(
        `--g4u-${name}-y`,
        `${y.toFixed(2)}px`
      );


      /* ========================================================
         2D ROTATION
         ======================================================== */

      const organicRotation =
        Math.sin(
          (
            time *
            config.frequency *
            0.85
          ) +
          config.phase
        ) *
        Math.min(
          (
            Math.abs(
              config.rotate
            ) *
            0.15
          ),
          0.09
        );


      const rotation =
        (
          pointerX *
          config.rotate
        ) +
        organicRotation;


      section.style.setProperty(
        `--g4u-${name}-rotate`,
        `${rotation.toFixed(3)}deg`
      );


      /* ========================================================
         3D
         PRODUCTS ONLY
         ======================================================== */

      if (
        config.farZ !== undefined
      ) {

        /* ======================================================
           Z
           ====================================================== */

        const z =
          lerp(
            config.farZ,
            config.nearZ,
            approachProgress
          );


        /* ======================================================
           SCALE

           El translateZ ya produce reducción visual.

           Por eso farScale es ahora muy cercano a 1.
           Evitamos doble reducción excesiva.
           ====================================================== */

        const baseScale =
          lerp(
            config.farScale,
            config.nearScale,
            approachProgress
          );


        /*
         * Micro expansión en mitad del recorrido.
         *
         * Muy leve.
         */
        const scalePulse =
          Math.sin(
            approachProgress *
            Math.PI
          ) *
          config.scalePulse;


        const depthScale =
          baseScale +
          scalePulse;


        /* ======================================================
           3D ROTATION
           ====================================================== */

        const rotateX =
          (
            config.tiltX *
            farAmount
          ) -
          (
            pointerY *
            config.pointerTilt
          );


        const rotateY =
          (
            config.tiltY *
            farAmount
          ) +
          (
            pointerX *
            config.pointerTilt
          );


        section.style.setProperty(
          `--g4u-${name}-z`,
          `${z.toFixed(2)}px`
        );


        section.style.setProperty(
          `--g4u-${name}-depth-scale`,
          depthScale.toFixed(4)
        );


        section.style.setProperty(
          `--g4u-${name}-rx`,
          `${rotateX.toFixed(3)}deg`
        );


        section.style.setProperty(
          `--g4u-${name}-ry`,
          `${rotateY.toFixed(3)}deg`
        );

      }

    };


    /* ==========================================================
       RESET
       ========================================================== */

    const resetStyles = () => {

      const layerNames = [
        'dust',
        'texture',
        'snack',
        'bread',
        'tortilla'
      ];


      layerNames.forEach(
        (name) => {

          section.style.removeProperty(
            `--g4u-${name}-x`
          );


          section.style.removeProperty(
            `--g4u-${name}-y`
          );


          section.style.removeProperty(
            `--g4u-${name}-rotate`
          );


          section.style.removeProperty(
            `--g4u-${name}-z`
          );


          section.style.removeProperty(
            `--g4u-${name}-rx`
          );


          section.style.removeProperty(
            `--g4u-${name}-ry`
          );


          section.style.removeProperty(
            `--g4u-${name}-depth-scale`
          );

        }
      );


      targetPointerX = 0;
      targetPointerY = 0;


      pointerX = 0;
      pointerY = 0;


      targetScrollProgress = 0;
      scrollProgress = 0;


      targetApproachProgress = 0;
      approachProgress = 0;


      targetEnergy = 0;
      energy = 0;

    };


    /* ==========================================================
       RENDER
       ========================================================== */

    const render = (
      time
    ) => {

      if (!enabled()) {

        requestAnimationFrame(
          render
        );

        return;

      }


      /* ========================================================
         DAMPING
         ======================================================== */

      const pointerEase =
        desktopQuery.matches
          ? 0.085
          : 0.065;


      const scrollEase =
        desktopQuery.matches
          ? 0.070
          : 0.058;


      /*
       * Más lento que scroll:
       * genera sensación de masa/profundidad.
       */
      const approachEase =
        desktopQuery.matches
          ? 0.046
          : 0.040;


      pointerX =
        lerp(
          pointerX,
          targetPointerX,
          pointerEase
        );


      pointerY =
        lerp(
          pointerY,
          targetPointerY,
          pointerEase
        );


      scrollProgress =
        lerp(
          scrollProgress,
          targetScrollProgress,
          scrollEase
        );


      approachProgress =
        lerp(
          approachProgress,
          targetApproachProgress,
          approachEase
        );


      /* ========================================================
         ENERGY
         ======================================================== */

      energy =
        lerp(
          energy,
          targetEnergy,
          desktopQuery.matches
            ? 0.10
            : 0.085
        );


      targetEnergy *=
        desktopQuery.matches
          ? 0.95
          : 0.94;


      if (
        targetEnergy <
        0.001
      ) {

        targetEnergy = 0;

      }


      /* ========================================================
         UPDATE LAYERS
         ======================================================== */

      if (isVisible) {

        const layers =
          getLayers();


        setLayerVariables(
          'dust',
          layers.dust,
          time
        );


        setLayerVariables(
          'texture',
          layers.texture,
          time
        );


        setLayerVariables(
          'snack',
          layers.snack,
          time
        );


        setLayerVariables(
          'bread',
          layers.bread,
          time
        );


        setLayerVariables(
          'tortilla',
          layers.tortilla,
          time
        );

      }


      requestAnimationFrame(
        render
      );

    };


    /* ==========================================================
       INTERSECTION OBSERVER
       ========================================================== */

    if (
      'IntersectionObserver'
      in window
    ) {

      const observer =
        new IntersectionObserver(
          (entries) => {

            entries.forEach(
              (entry) => {

                isVisible =
                  entry.isIntersecting;


                if (isVisible) {

                  previousScrollY =
                    window.scrollY;


                  previousScrollTime =
                    performance.now();


                  updateScrollTarget();

                }

              }
            );

          },
          {
            /*
             * Activamos antes para que al aparecer
             * ya tenga el estado de profundidad correcto.
             */
            rootMargin:
              '30% 0px 30% 0px'
          }
        );


      observer.observe(
        section
      );

    }


    /* ==========================================================
       SCROLL
       ========================================================== */

    window.addEventListener(
      'scroll',
      updateScrollTarget,
      {
        passive: true
      }
    );


    /* ==========================================================
       RESIZE
       ========================================================== */

    window.addEventListener(
      'resize',
      () => {

        if (
          !desktopQuery.matches
        ) {

          resetPointer();

        }


        previousScrollY =
          window.scrollY;


        previousScrollTime =
          performance.now();


        updateScrollTarget();

      },
      {
        passive: true
      }
    );


    /* ==========================================================
       POINTER
       ========================================================== */

    section.addEventListener(
      'pointermove',
      updatePointerTarget,
      {
        passive: true
      }
    );


    section.addEventListener(
      'pointerleave',
      resetPointer,
      {
        passive: true
      }
    );


    /* ==========================================================
       BREAKPOINT CHANGE
       ========================================================== */

    desktopQuery
      .addEventListener?.(
        'change',
        () => {

          resetPointer();


          previousScrollY =
            window.scrollY;


          previousScrollTime =
            performance.now();


          updateScrollTarget();

        }
      );


    /* ==========================================================
       REDUCED MOTION
       ========================================================== */

    reducedMotionQuery
      .addEventListener?.(
        'change',
        () => {

          if (
            reducedMotionQuery.matches
          ) {

            resetStyles();

          }
          else {

            previousScrollY =
              window.scrollY;


            previousScrollTime =
              performance.now();


            updateScrollTarget();

          }

        }
      );


    /* ==========================================================
       INIT
       ========================================================== */

    if (
      reducedMotionQuery.matches
    ) {

      resetStyles();

      return;

    }


    previousScrollY =
      window.scrollY;


    previousScrollTime =
      performance.now();


    updateScrollTarget();


    requestAnimationFrame(
      render
    );

  })();
</script>


