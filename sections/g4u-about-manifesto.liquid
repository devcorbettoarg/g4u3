<section
  class="g4u-about-manifesto"
  id="G4uAboutManifesto-{{ section.id }}"
  aria-labelledby="G4uAboutManifestoTitle-{{ section.id }}"
  data-g4u-manifesto-parallax
>
  <div class="g4u-about-manifesto__copy">
    <h2
      class="g4u-about-manifesto__title g4u-display"
      id="G4uAboutManifestoTitle-{{ section.id }}"
    >
      Creemos en la <em>nutrición inteligente,</em><br>
      la que combina <strong>ciencia, sabor</strong><br>
      y <strong>bienestar</strong> real.<br>
      En los alimentos que<br>
      no prometen magia,<br>
      sino <em>resultados</em> auténticos.<br>
      Creemos en la <strong>transparencia,</strong><br>
      en los <em>ingredientes limpios</em><br>
      y en las <strong>decisiones conscientes.</strong><br>
      Creemos que lo <em>saludable</em><br>
      no tiene que ser aburrido.
    </h2>

    <div class="g4u-about-manifesto__closing g4u-display">
      <p>{{ section.settings.closing | escape | newline_to_br }}</p>
      <p>{{ section.settings.closing_accent | escape | newline_to_br }}</p>
    </div>
  </div>

  <div class="g4u-about-manifesto__art" aria-hidden="true">

    {%- if section.settings.particles_image_1 != blank -%}
      {{
        section.settings.particles_image_1
        | image_url: width: 1800
        | image_tag:
          class: 'g4u-about-manifesto__particles g4u-about-manifesto__particles--one',
          loading: 'lazy'
      }}
    {%- endif -%}

    {%- if section.settings.particles_image_2 != blank -%}
      {{
        section.settings.particles_image_2
        | image_url: width: 1800
        | image_tag:
          class: 'g4u-about-manifesto__particles g4u-about-manifesto__particles--two',
          loading: 'lazy'
      }}
    {%- endif -%}

    {%- if section.settings.snack_image != blank -%}
      {{
        section.settings.snack_image
        | image_url: width: 1200
        | image_tag:
          class: 'g4u-about-manifesto__object g4u-about-manifesto__object--snack',
          loading: 'lazy'
      }}
    {%- endif -%}

    {%- if section.settings.bread_image != blank -%}
      {{
        section.settings.bread_image
        | image_url: width: 1600
        | image_tag:
          class: 'g4u-about-manifesto__object g4u-about-manifesto__object--bread',
          loading: 'lazy'
      }}
    {%- endif -%}

    {%- if section.settings.tortilla_image != blank -%}
      {{
        section.settings.tortilla_image
        | image_url: width: 1200
        | image_tag:
          class: 'g4u-about-manifesto__object g4u-about-manifesto__object--tortilla',
          loading: 'lazy'
      }}
    {%- endif -%}

  </div>
</section>

<style>
  /* ============================================================
     G4U · MANIFIESTO
     INDEPENDENT LAYERS PARALLAX · V2
     ============================================================ */

  .section-g4u-about-manifesto {
    background: #500322 !important;
    background-color: #500322 !important;
    background-image: none !important;
    overflow: hidden;
  }

  #G4uAboutManifesto-{{ section.id }} {
    position: relative;
    background: #500322 !important;
    background-color: #500322 !important;
    background-image: none !important;
    overflow: hidden;
    isolation: isolate;
  }

  #G4uAboutManifesto-{{ section.id }}::before,
  #G4uAboutManifesto-{{ section.id }}::after {
    content: none !important;
    display: none !important;
    background: none !important;
  }

  #G4uAboutManifesto-{{ section.id }} .g4u-about-manifesto__copy {
    position: relative;
    z-index: 10;
  }

  #G4uAboutManifesto-{{ section.id }} .g4u-about-manifesto__art {
    position: relative;
    background: #500322 !important;
    background-color: #500322 !important;
    background-image: none !important;
    overflow: hidden;
    isolation: isolate;
    contain: paint;
  }

  #G4uAboutManifesto-{{ section.id }} .g4u-about-manifesto__art::before,
  #G4uAboutManifesto-{{ section.id }} .g4u-about-manifesto__art::after {
    content: none !important;
    display: none !important;
  }

  /* ============================================================
     PARTICLES
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }} .g4u-about-manifesto__particles {
    position: absolute !important;
    z-index: 1 !important;
    pointer-events: none;
    user-select: none;
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;
    mix-blend-mode: screen !important;
    backface-visibility: hidden;
    transform-origin: center center;
    max-width: none !important;
    will-change: transform;
  }

  #G4uAboutManifesto-{{ section.id }} .g4u-about-manifesto__particles--one {
    inset: -6% !important;
    width: 112% !important;
    height: 112% !important;
    object-fit: cover;
    object-position: center center;
    opacity: {{ section.settings.particles_1_opacity | divided_by: 100.0 }};
    transform:
      translate3d(
        var(--g4u-particles-one-x, 0px),
        var(--g4u-particles-one-y, 0px),
        0
      )
      rotate(var(--g4u-particles-one-r, 0deg))
      scale(1.04);
  }

  #G4uAboutManifesto-{{ section.id }} .g4u-about-manifesto__particles--two {
    inset: -8% !important;
    width: 116% !important;
    height: 116% !important;
    object-fit: cover;
    object-position: center center;
    opacity: {{ section.settings.particles_2_opacity | divided_by: 100.0 }};
    transform:
      translate3d(
        var(--g4u-particles-two-x, 0px),
        var(--g4u-particles-two-y, 0px),
        0
      )
      rotate(var(--g4u-particles-two-r, 0deg))
      scale(1.05);
  }

  /* ============================================================
     PRODUCTS
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }} .g4u-about-manifesto__object {
    position: absolute;
    pointer-events: none;
    user-select: none;
    z-index: 3;
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;
    mix-blend-mode: normal !important;
    filter: none !important;
    opacity: 1 !important;
    transform-origin: center center;
    backface-visibility: hidden;
    will-change: transform;
  }

  #G4uAboutManifesto-{{ section.id }} .g4u-about-manifesto__object--snack {
    z-index: 4 !important;
    transform:
      perspective(1500px)
      translate3d(
        var(--g4u-snack-x, 0px),
        var(--g4u-snack-y, 0px),
        0
      )
      rotate(var(--g4u-snack-rz, 0deg))
      rotateX(var(--g4u-snack-rx, 0deg))
      rotateY(var(--g4u-snack-ry, 0deg))
      scale(var(--g4u-snack-scale, 1));
  }

  #G4uAboutManifesto-{{ section.id }} .g4u-about-manifesto__object--bread {
    z-index: 5 !important;
    transform:
      perspective(1600px)
      translate3d(
        var(--g4u-bread-x, 0px),
        var(--g4u-bread-y, 0px),
        0
      )
      rotate(var(--g4u-bread-rz, 0deg))
      rotateX(var(--g4u-bread-rx, 0deg))
      rotateY(var(--g4u-bread-ry, 0deg))
      scale(var(--g4u-bread-scale, 1));
  }

  #G4uAboutManifesto-{{ section.id }} .g4u-about-manifesto__object--tortilla {
    z-index: 4 !important;
    transform:
      perspective(1500px)
      translate3d(
        var(--g4u-tortilla-x, 0px),
        var(--g4u-tortilla-y, 0px),
        0
      )
      rotate(var(--g4u-tortilla-rz, 0deg))
      rotateX(var(--g4u-tortilla-rx, 0deg))
      rotateY(var(--g4u-tortilla-ry, 0deg))
      scale(var(--g4u-tortilla-scale, 1));
  }

  /* ============================================================
     MOBILE TWEAKS
     ============================================================ */

  @media screen and (max-width: 989px) {
    #G4uAboutManifesto-{{ section.id }} .g4u-about-manifesto__object--snack {
      margin-left: -5px;
      margin-top: -28px;
    }

    #G4uAboutManifesto-{{ section.id }} .g4u-about-manifesto__object--bread {
      margin-left: 4px;
      margin-top: 3px;
    }

    #G4uAboutManifesto-{{ section.id }} .g4u-about-manifesto__object--tortilla {
      margin-left: -7px;
      margin-top: 32px;
    }
  }

  @media screen and (max-width: 480px) {
    #G4uAboutManifesto-{{ section.id }} .g4u-about-manifesto__object--snack {
      margin-left: -7px;
      margin-top: -34px;
    }

    #G4uAboutManifesto-{{ section.id }} .g4u-about-manifesto__object--tortilla {
      margin-left: -8px;
      margin-top: 38px;
    }
  }

  /* ============================================================
     REDUCED MOTION
     ============================================================ */

  @media (prefers-reduced-motion: reduce) {
    #G4uAboutManifesto-{{ section.id }} .g4u-about-manifesto__particles,
    #G4uAboutManifesto-{{ section.id }} .g4u-about-manifesto__object {
      transform: none !important;
    }
  }
</style>

<script>
  (() => {
    const section = document.querySelector('#G4uAboutManifesto-{{ section.id }}');

    if (!section) return;

    if (section.dataset.g4uIndependentParallaxInitialized === 'true') return;
    section.dataset.g4uIndependentParallaxInitialized = 'true';

    const desktopQuery = window.matchMedia('(min-width: 990px)');
    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    /* ==========================================================
       PRODUCTS
       ========================================================== */

    const desktopProducts = {
      snack: {
        entryX: -120,
        entryY: -95,
        scrollX: 10,
        scrollY: -52,
        mouseX: 15,
        mouseY: 11,
        floatX: 2.7,
        floatY: 3.5,
        frequency: 0.00048,
        phase: 1.1,
        startScale: 0.72,
        finalScale: 1,
        displayScale: {{ section.settings.snack_size_desktop | divided_by: 100.0 }},
        scalePulse: 0.026,
        startRotate: -7,
        tiltX: 1.2,
        tiltY: -1.7,
        pointerTilt: 0.34
      },

      bread: {
        entryX: 135,
        entryY: -78,
        scrollX: -8,
        scrollY: -34,
        mouseX: 8,
        mouseY: 6,
        floatX: 1.9,
        floatY: 2.4,
        frequency: 0.00034,
        phase: 3.7,
        startScale: 0.76,
        finalScale: 1,
        displayScale: {{ section.settings.bread_size_desktop | divided_by: 100.0 }},
        scalePulse: 0.018,
        startRotate: 4.5,
        tiltX: -0.8,
        tiltY: 1.15,
        pointerTilt: 0.22
      },

      tortilla: {
        entryX: -108,
        entryY: 112,
        scrollX: 8,
        scrollY: -38,
        mouseX: -9,
        mouseY: -6,
        floatX: 2.1,
        floatY: 2.8,
        frequency: 0.00042,
        phase: 5.0,
        startScale: 0.74,
        finalScale: 1,
        displayScale: {{ section.settings.tortilla_size_desktop | divided_by: 100.0 }},
        scalePulse: 0.020,
        startRotate: -4.2,
        tiltX: 0.95,
        tiltY: -1.15,
        pointerTilt: 0.25
      }
    };

    const mobileProducts = {
      snack: {
        entryX: -48,
        entryY: -40,
        scrollX: 6,
        scrollY: -28,
        mouseX: 0,
        mouseY: 0,
        floatX: 1.4,
        floatY: 1.9,
        frequency: 0.00048,
        phase: 1.1,
        startScale: 0.88,
        finalScale: 1,
        displayScale: {{ section.settings.snack_size_mobile | divided_by: 100.0 }},
        scalePulse: 0.010,
        startRotate: -2.5,
        tiltX: 0.35,
        tiltY: -0.5,
        pointerTilt: 0
      },

      bread: {
        entryX: 56,
        entryY: -34,
        scrollX: -4,
        scrollY: -18,
        mouseX: 0,
        mouseY: 0,
        floatX: 1.1,
        floatY: 1.5,
        frequency: 0.00034,
        phase: 3.7,
        startScale: 0.90,
        finalScale: 1,
        displayScale: {{ section.settings.bread_size_mobile | divided_by: 100.0 }},
        scalePulse: 0.008,
        startRotate: 1.8,
        tiltX: -0.22,
        tiltY: 0.30,
        pointerTilt: 0
      },

      tortilla: {
        entryX: -44,
        entryY: 50,
        scrollX: 5,
        scrollY: -21,
        mouseX: 0,
        mouseY: 0,
        floatX: 1.2,
        floatY: 1.6,
        frequency: 0.00042,
        phase: 5.0,
        startScale: 0.89,
        finalScale: 1,
        displayScale: {{ section.settings.tortilla_size_mobile | divided_by: 100.0 }},
        scalePulse: 0.009,
        startRotate: -2,
        tiltX: 0.28,
        tiltY: -0.35,
        pointerTilt: 0
      }
    };

    /* ==========================================================
       PARTICLES
       ========================================================== */

    const desktopParticles = {
      one: {
        scrollY: 14,
        mouseX: -2.4,
        mouseY: -1.6,
        floatX: 1.3,
        floatY: 1.7,
        frequency: 0.00021,
        phase: 0.4,
        rotate: 0.022
      },

      two: {
        scrollY: -18,
        mouseX: 2.0,
        mouseY: 1.2,
        floatX: 1.5,
        floatY: 2.0,
        frequency: 0.00018,
        phase: 2.5,
        rotate: -0.018
      }
    };

    const mobileParticles = {
      one: {
        scrollY: 8,
        mouseX: 0,
        mouseY: 0,
        floatX: 0.7,
        floatY: 1.0,
        frequency: 0.00021,
        phase: 0.4,
        rotate: 0.010
      },

      two: {
        scrollY: -10,
        mouseX: 0,
        mouseY: 0,
        floatX: 0.8,
        floatY: 1.1,
        frequency: 0.00018,
        phase: 2.5,
        rotate: -0.009
      }
    };

    let targetPointerX = 0;
    let targetPointerY = 0;
    let pointerX = 0;
    let pointerY = 0;

    let targetScroll = 0;
    let currentScroll = 0;

    let targetApproach = 0;
    let currentApproach = 0;

    let visible = true;

    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);
    const lerp = (current, target, amount) => current + ((target - current) * amount);

    const smoothstep = (value) => {
      const x = clamp(value, 0, 1);
      return x * x * (3 - (2 * x));
    };

    const getProducts = () => (
      desktopQuery.matches ? desktopProducts : mobileProducts
    );

    const getParticles = () => (
      desktopQuery.matches ? desktopParticles : mobileParticles
    );

    const updateScroll = () => {
      if (reducedMotionQuery.matches) return;

      const rect = section.getBoundingClientRect();
      const viewportHeight = window.innerHeight;

      const sectionCenter = rect.top + (rect.height / 2);
      const viewportCenter = viewportHeight / 2;
      const travelRange = (viewportHeight + rect.height) / 2;

      targetScroll = clamp(
        (viewportCenter - sectionCenter) / travelRange,
        -1,
        1
      );

      const start = viewportHeight * 1.18;
      const end = viewportHeight * 0.04;

      const raw = clamp(
        (start - rect.top) / (start - end),
        0,
        1
      );

      targetApproach = smoothstep(raw);
    };

    const updatePointer = (event) => {
      if (!desktopQuery.matches || reducedMotionQuery.matches) return;

      const rect = section.getBoundingClientRect();

      targetPointerX = clamp(
        (((event.clientX - rect.left) / rect.width) - 0.5) * 2,
        -1,
        1
      );

      targetPointerY = clamp(
        (((event.clientY - rect.top) / rect.height) - 0.5) * 2,
        -1,
        1
      );
    };

    const resetPointer = () => {
      targetPointerX = 0;
      targetPointerY = 0;
    };

    const getOrganic = (time, config) => {
      const t = time * config.frequency;

      const waveA = Math.sin(t + config.phase);
      const waveB = Math.sin((t * 1.67) + (config.phase * 1.8));
      const waveC = Math.cos((t * 0.63) + (config.phase * 0.75));

      return {
        x: (
          (waveA * 0.52) +
          (waveB * 0.31) +
          (waveC * 0.17)
        ) * config.floatX,

        y: (
          (waveA * 0.27) +
          (waveB * 0.48) +
          (waveC * 0.25)
        ) * config.floatY
      };
    };

    const renderParticle = (key, config, time) => {
      const organic = getOrganic(time, config);

      const x =
        (pointerX * config.mouseX) +
        organic.x;

      const y =
        (currentScroll * config.scrollY) +
        (pointerY * config.mouseY) +
        organic.y;

      const rotation =
        Math.sin((time * config.frequency * 0.75) + config.phase) *
        config.rotate;

      section.style.setProperty(`--g4u-particles-${key}-x`, `${x.toFixed(2)}px`);
      section.style.setProperty(`--g4u-particles-${key}-y`, `${y.toFixed(2)}px`);
      section.style.setProperty(`--g4u-particles-${key}-r`, `${rotation.toFixed(3)}deg`);
    };

    const renderProduct = (name, config, time) => {
      const organic = getOrganic(time, config);
      const far = 1 - currentApproach;

      const entryX = config.entryX * far;
      const entryY = config.entryY * far;

      const x =
        entryX +
        (currentScroll * config.scrollX) +
        (pointerX * config.mouseX) +
        organic.x;

      const y =
        entryY +
        (currentScroll * config.scrollY) +
        (pointerY * config.mouseY) +
        organic.y;

      const baseScale = lerp(
        config.startScale,
        config.finalScale,
        currentApproach
      );

      const pulse =
        Math.sin(currentApproach * Math.PI) *
        config.scalePulse;

      const scale =
        (baseScale + pulse) *
        config.displayScale;

      const entryRotation =
        config.startRotate * far;

      const organicRotation =
        Math.sin((time * config.frequency * 0.80) + config.phase) *
        0.08;

      const rotateZ =
        entryRotation +
        organicRotation;

      const rotateX =
        (config.tiltX * far) -
        (pointerY * config.pointerTilt);

      const rotateY =
        (config.tiltY * far) +
        (pointerX * config.pointerTilt);

      section.style.setProperty(`--g4u-${name}-x`, `${x.toFixed(2)}px`);
      section.style.setProperty(`--g4u-${name}-y`, `${y.toFixed(2)}px`);
      section.style.setProperty(`--g4u-${name}-scale`, scale.toFixed(4));
      section.style.setProperty(`--g4u-${name}-rz`, `${rotateZ.toFixed(3)}deg`);
      section.style.setProperty(`--g4u-${name}-rx`, `${rotateX.toFixed(3)}deg`);
      section.style.setProperty(`--g4u-${name}-ry`, `${rotateY.toFixed(3)}deg`);
    };

    const render = (time) => {
      if (reducedMotionQuery.matches) {
        requestAnimationFrame(render);
        return;
      }

      pointerX = lerp(
        pointerX,
        targetPointerX,
        desktopQuery.matches ? 0.085 : 0.05
      );

      pointerY = lerp(
        pointerY,
        targetPointerY,
        desktopQuery.matches ? 0.085 : 0.05
      );

      currentScroll = lerp(
        currentScroll,
        targetScroll,
        desktopQuery.matches ? 0.075 : 0.060
      );

      currentApproach = lerp(
        currentApproach,
        targetApproach,
        desktopQuery.matches ? 0.050 : 0.042
      );

      if (visible) {
        const particles = getParticles();
        const products = getProducts();

        renderParticle('one', particles.one, time);
        renderParticle('two', particles.two, time);

        renderProduct('snack', products.snack, time);
        renderProduct('bread', products.bread, time);
        renderProduct('tortilla', products.tortilla, time);
      }

      requestAnimationFrame(render);
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            visible = entry.isIntersecting;

            if (visible) {
              updateScroll();
            }
          });
        },
        {
          rootMargin: '30% 0px 30% 0px'
        }
      );

      observer.observe(section);
    }

    window.addEventListener('scroll', updateScroll, { passive: true });

    window.addEventListener(
      'resize',
      () => {
        resetPointer();
        updateScroll();
      },
      { passive: true }
    );

    section.addEventListener('pointermove', updatePointer, { passive: true });
    section.addEventListener('pointerleave', resetPointer, { passive: true });

    desktopQuery.addEventListener?.('change', () => {
      resetPointer();
      updateScroll();
    });

    updateScroll();
    requestAnimationFrame(render);
  })();
</script>

{% schema %}
{
  "name": "G4U · Manifiesto Nosotros",
  "tag": "section",
  "class": "section-g4u-about-manifesto",
  "settings": [
    {
      "type": "header",
      "content": "Capas de partículas"
    },
    {
      "type": "image_picker",
      "id": "particles_image_1",
      "label": "Partículas / polvo de fondo 1"
    },
    {
      "type": "range",
      "id": "particles_1_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacidad partículas 1",
      "default": 85
    },
    {
      "type": "image_picker",
      "id": "particles_image_2",
      "label": "Partículas / polvo de fondo 2"
    },
    {
      "type": "range",
      "id": "particles_2_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacidad partículas 2",
      "default": 65
    },

    {
      "type": "header",
      "content": "Productos flotantes"
    },
    {
      "type": "image_picker",
      "id": "snack_image",
      "label": "1 · Pan pequeño superior"
    },
    {
      "type": "image_picker",
      "id": "bread_image",
      "label": "2 · Pan central"
    },
    {
      "type": "image_picker",
      "id": "tortilla_image",
      "label": "3 · Tortilla inferior"
    },

    {
      "type": "header",
      "content": "Tamaño desktop"
    },
    {
      "type": "range",
      "id": "snack_size_desktop",
      "min": 80,
      "max": 180,
      "step": 2,
      "unit": "%",
      "label": "Pan pequeño superior · tamaño desktop",
      "default": 126
    },
    {
      "type": "range",
      "id": "bread_size_desktop",
      "min": 80,
      "max": 180,
      "step": 2,
      "unit": "%",
      "label": "Pan central · tamaño desktop",
      "default": 136
    },
    {
      "type": "range",
      "id": "tortilla_size_desktop",
      "min": 80,
      "max": 180,
      "step": 2,
      "unit": "%",
      "label": "Tortilla inferior · tamaño desktop",
      "default": 124
    },

    {
