<section
  class="g4u-about-manifesto"
  id="G4uAboutManifesto-{{ section.id }}"
  aria-labelledby="G4uAboutManifestoTitle-{{ section.id }}"
  data-g4u-manifesto-parallax
>
  <div class="g4u-about-manifesto__copy">
    <h2
      class="g4u-about-manifesto__title g4u-display"
      id="G4uAboutManifestoTitle-{{ section.id }}"
    >
      Creemos en la <em>nutrición inteligente,</em><br>
      la que combina <strong>ciencia, sabor</strong><br>
      y <strong>bienestar</strong> real.<br>
      En los alimentos que<br>
      no prometen magia,<br>
      sino <em>resultados</em> auténticos.<br>
      Creemos en la <strong>transparencia,</strong><br>
      en los <em>ingredientes limpios</em><br>
      y en las <strong>decisiones conscientes.</strong><br>
      Creemos que lo <em>saludable</em><br>
      no tiene que ser aburrido.
    </h2>

    <div class="g4u-about-manifesto__closing g4u-display">
      <p>{{ section.settings.closing | escape | newline_to_br }}</p>
      <p>{{ section.settings.closing_accent | escape | newline_to_br }}</p>
    </div>
  </div>

  <div class="g4u-about-manifesto__art" aria-hidden="true">

    {%- if section.settings.dust_image != blank -%}
      {{
        section.settings.dust_image
        | image_url: width: 1024
        | image_tag:
          class: 'g4u-about-manifesto__dust',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__dust"
        src="{{ 'g4u-about-manifesto-dust.png' | asset_url }}"
        alt=""
        width="1024"
        height="1536"
        loading="lazy"
      >
    {%- endif -%}

    {%- if section.settings.texture_image != blank -%}
      {{
        section.settings.texture_image
        | image_url: width: 1024
        | image_tag:
          class: 'g4u-about-manifesto__texture',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__texture"
        src="{{ 'g4u-about-manifesto-texture.png' | asset_url }}"
        alt=""
        width="1024"
        height="1535"
        loading="lazy"
      >
    {%- endif -%}

    {%- if section.settings.snack_image != blank -%}
      {{
        section.settings.snack_image
        | image_url: width: 456
        | image_tag:
          class: 'g4u-about-manifesto__object g4u-about-manifesto__object--snack',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__object g4u-about-manifesto__object--snack"
        src="{{ 'g4u-about-snack.png' | asset_url }}"
        alt=""
        width="456"
        height="458"
        loading="lazy"
      >
    {%- endif -%}

    {%- if section.settings.bread_image != blank -%}
      {{
        section.settings.bread_image
        | image_url: width: 866
        | image_tag:
          class: 'g4u-about-manifesto__object g4u-about-manifesto__object--bread',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__object g4u-about-manifesto__object--bread"
        src="{{ 'g4u-about-bread.png' | asset_url }}"
        alt=""
        width="866"
        height="926"
        loading="lazy"
      >
    {%- endif -%}

    {%- if section.settings.tortilla_image != blank -%}
      {{
        section.settings.tortilla_image
        | image_url: width: 490
        | image_tag:
          class: 'g4u-about-manifesto__object g4u-about-manifesto__object--tortilla',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__object g4u-about-manifesto__object--tortilla"
        src="{{ 'g4u-about-tortilla.png' | asset_url }}"
        alt=""
        width="490"
        height="449"
        loading="lazy"
      >
    {%- endif -%}

  </div>
</section>


<style>
  /* ============================================================
     G4U MANIFESTO
     ORGANIC PARALLAX
     DESKTOP + MOBILE
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }} {
    position: relative;
  }

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__art {
    background: transparent !important;
  }


  /* ============================================================
     GENERAL PERFORMANCE
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__dust,

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__texture,

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__object {
    will-change: translate, rotate;
    backface-visibility: hidden;
  }


  /* ============================================================
     DESKTOP
     ============================================================ */

  @media screen and (min-width: 990px) {

    /* ----------------------------
       DUST
       ---------------------------- */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__dust {
      mix-blend-mode: screen;

      translate:
        var(--g4u-dust-x, 0px)
        var(--g4u-dust-y, 0px);

      rotate:
        var(--g4u-dust-rotate, 0deg);
    }


    /* ----------------------------
       TEXTURE
       ---------------------------- */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__texture {
      mix-blend-mode: screen;

      translate:
        var(--g4u-texture-x, 0px)
        var(--g4u-texture-y, 0px);

      rotate:
        var(--g4u-texture-rotate, 0deg);

      scale: 1.055;
    }


    /* ----------------------------
       SNACK
       ---------------------------- */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--snack {
      translate:
        var(--g4u-snack-x, 0px)
        var(--g4u-snack-y, 0px);

      rotate:
        var(--g4u-snack-rotate, 0deg);
    }


    /* ----------------------------
       BREAD
       ---------------------------- */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--bread {
      translate:
        var(--g4u-bread-x, 0px)
        var(--g4u-bread-y, 0px);

      rotate:
        var(--g4u-bread-rotate, 0deg);
    }


    /* ----------------------------
       TORTILLA
       ---------------------------- */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--tortilla {
      translate:
        var(--g4u-tortilla-x, 0px)
        var(--g4u-tortilla-y, 0px);

      rotate:
        var(--g4u-tortilla-rotate, 0deg);
    }

  }


  /* ============================================================
     MOBILE
     ============================================================ */

  @media screen and (max-width: 989px) {

    /*
     * En mobile mantenemos las capas separadas.
     *
     * Los offsets fijos se SUMAN al parallax.
     *
     * Snack     → un poco arriba
     * Pan       → queda como centro visual
     * Tortilla  → un poco abajo
     */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__dust {
      mix-blend-mode: screen;

      translate:
        calc(var(--g4u-dust-x, 0px) - 4px)
        calc(var(--g4u-dust-y, 0px) - 8px);

      rotate:
        var(--g4u-dust-rotate, 0deg);

      scale: 1.04;
    }


    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__texture {
      mix-blend-mode: screen;

      translate:
        calc(var(--g4u-texture-x, 0px) + 4px)
        var(--g4u-texture-y, 0px);

      rotate:
        var(--g4u-texture-rotate, 0deg);

      /*
       * Más margen para que al desplazarse
       * nunca aparezca un borde del asset.
       */

      scale: 1.09;
    }


    /* ==========================================================
       SNACK MOBILE

       Separamos hacia arriba.
       ========================================================== */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--snack {
      translate:
        calc(var(--g4u-snack-x, 0px) - 5px)
        calc(var(--g4u-snack-y, 0px) - 28px);

      rotate:
        var(--g4u-snack-rotate, 0deg);

      scale: 0.94;
    }


    /* ==========================================================
       PAN MOBILE

       Le damos apenas aire pero permanece como protagonista.
       ========================================================== */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--bread {
      translate:
        calc(var(--g4u-bread-x, 0px) + 4px)
        calc(var(--g4u-bread-y, 0px) + 3px);

      rotate:
        var(--g4u-bread-rotate, 0deg);

      scale: 0.93;
    }


    /* ==========================================================
       TORTILLA MOBILE

       Separamos hacia abajo y ligeramente hacia la izquierda.
       ========================================================== */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--tortilla {
      translate:
        calc(var(--g4u-tortilla-x, 0px) - 7px)
        calc(var(--g4u-tortilla-y, 0px) + 32px);

      rotate:
        var(--g4u-tortilla-rotate, 0deg);

      scale: 0.95;
    }

  }


  /* ============================================================
     MOBILE EXTRA SMALL

     En pantallas realmente estrechas les damos todavía
     un poco más de respiración.
     ============================================================ */

  @media screen and (max-width: 480px) {

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--snack {
      translate:
        calc(var(--g4u-snack-x, 0px) - 7px)
        calc(var(--g4u-snack-y, 0px) - 34px);

      scale: 0.91;
    }


    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--bread {
      translate:
        calc(var(--g4u-bread-x, 0px) + 4px)
        calc(var(--g4u-bread-y, 0px) + 3px);

      scale: 0.91;
    }


    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--tortilla {
      translate:
        calc(var(--g4u-tortilla-x, 0px) - 8px)
        calc(var(--g4u-tortilla-y, 0px) + 38px);

      scale: 0.92;
    }

  }


  /* ============================================================
     REDUCED MOTION
     ============================================================ */

  @media (prefers-reduced-motion: reduce) {

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__dust,

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__texture,

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object {
      translate: 0 0 !important;
      rotate: 0deg !important;
    }

  }
</style>


<script>
  (() => {

    const section = document.querySelector(
      '#G4uAboutManifesto-{{ section.id }}'
    );

    if (!section) return;


    /* ==========================================================
       PREVENT DOUBLE INIT
       ========================================================== */

    if (
      section.dataset.g4uParallaxInitialized === 'true'
    ) {
      return;
    }

    section.dataset.g4uParallaxInitialized = 'true';


    /* ==========================================================
       MEDIA QUERIES
       ========================================================== */

    const desktopQuery = window.matchMedia(
      '(min-width: 990px)'
    );

    const reducedMotionQuery = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );


    /* ==========================================================
       DESKTOP CONFIGURATION
       ========================================================== */

    const desktopLayers = {

      dust: {
        scrollY: 21,
        mouseX: -4.5,
        mouseY: -4.5,

        floatX: 2.2,
        floatY: 3.2,

        frequency: 0.00032,
        phase: 0.7,

        energy: 3,
        rotate: 0.04
      },


      texture: {
        scrollY: -37,
        mouseX: 7,
        mouseY: 7,

        floatX: 3.5,
        floatY: 5,

        frequency: 0.00027,
        phase: 2.4,

        energy: 5,
        rotate: -0.06
      },


      snack: {
        scrollY: -67,
        mouseX: 18.5,
        mouseY: 14,

        floatX: 4.5,
        floatY: 6,

        frequency: 0.00055,
        phase: 1.2,

        energy: 9,
        rotate: 0.95
      },


      bread: {
        scrollY: -44,
        mouseX: 11.5,
        mouseY: 9,

        floatX: 3.5,
        floatY: 4.5,

        frequency: 0.00040,
        phase: 3.8,

        energy: 6,
        rotate: -0.42
      },


      tortilla: {
        scrollY: -55,
        mouseX: -12.5,
        mouseY: -9,

        floatX: 4,
        floatY: 5.5,

        frequency: 0.00048,
        phase: 5.1,

        energy: 7,
        rotate: -0.65
      }

    };


    /* ==========================================================
       MOBILE CONFIGURATION

       No utilizamos mouse.

       El movimiento depende de:
       - scroll
       - velocidad de scroll
       - movimiento orgánico propio

       Reduje un poco los recorridos para evitar congestión,
       pero aumenté la independencia entre elementos.
       ========================================================== */

    const mobileLayers = {

      dust: {
        scrollY: 14,
        mouseX: 0,
        mouseY: 0,

        floatX: 1.5,
        floatY: 2.5,

        frequency: 0.00030,
        phase: 0.7,

        energy: 2.5,
        rotate: 0.025
      },


      texture: {
        scrollY: -23,
        mouseX: 0,
        mouseY: 0,

        floatX: 2.5,
        floatY: 3.5,

        frequency: 0.00025,
        phase: 2.4,

        energy: 4,
        rotate: -0.04
      },


      /*
       * SNACK:
       * más reactivo y liviano.
       */

      snack: {
        scrollY: -42,
        mouseX: 0,
        mouseY: 0,

        floatX: 3.2,
        floatY: 5,

        frequency: 0.00058,
        phase: 1.2,

        energy: 7,
        rotate: 0.65
      },


      /*
       * BREAD:
       * movimiento más pesado / estable.
       */

      bread: {
        scrollY: -27,
        mouseX: 0,
        mouseY: 0,

        floatX: 2.3,
        floatY: 3.2,

        frequency: 0.00038,
        phase: 3.8,

        energy: 4.5,
        rotate: -0.27
      },


      /*
       * TORTILLA:
       * movimiento ligeramente diferente al snack,
       * ayuda a generar profundidad.
       */

      tortilla: {
        scrollY: -36,
        mouseX: 0,
        mouseY: 0,

        floatX: 3,
        floatY: 4.3,

        frequency: 0.00050,
        phase: 5.1,

        energy: 5.5,
        rotate: -0.42
      }

    };


    /* ==========================================================
       GET CURRENT CONFIGURATION
       ========================================================== */

    const getLayers = () => {

      return desktopQuery.matches
        ? desktopLayers
        : mobileLayers;

    };


    /* ==========================================================
       STATE
       ========================================================== */

    let targetPointerX = 0;
    let targetPointerY = 0;

    let pointerX = 0;
    let pointerY = 0;

    let targetScrollProgress = 0;
    let scrollProgress = 0;

    let targetEnergy = 0;
    let energy = 0;

    let previousScrollY =
      window.scrollY;

    let previousScrollTime =
      performance.now();

    let isVisible = true;


    /* ==========================================================
       HELPERS
       ========================================================== */

    const clamp = (
      value,
      min,
      max
    ) => {

      return Math.min(
        Math.max(value, min),
        max
      );

    };


    const lerp = (
      current,
      target,
      amount
    ) => {

      return current +
        (target - current) * amount;

    };


    const enabled = () => {

      return !reducedMotionQuery.matches;

    };


    /* ==========================================================
       SCROLL POSITION + SCROLL VELOCITY
       ========================================================== */

    const updateScrollTarget = () => {

      if (!enabled()) return;


      const rect =
        section.getBoundingClientRect();


      const viewportHeight =
        window.innerHeight;


      const sectionCenter =
        rect.top +
        (rect.height / 2);


      const viewportCenter =
        viewportHeight / 2;


      const distance =
        viewportCenter -
        sectionCenter;


      const range =
        (
          viewportHeight +
          rect.height
        ) / 2;


      targetScrollProgress =
        clamp(
          distance / range,
          -1,
          1
        );


      /* ========================================================
         SCROLL VELOCITY
         ======================================================== */

      const now =
        performance.now();


      const currentScrollY =
        window.scrollY;


      const deltaY =
        currentScrollY -
        previousScrollY;


      const deltaTime =
        Math.max(
          now -
          previousScrollTime,
          16
        );


      const velocity =
        Math.abs(deltaY) /
        deltaTime;


      /*
       * Desktop acepta algo más de aceleración.
       *
       * Mobile queda ligeramente amortiguado para que
       * un flick rápido no haga saltar demasiado las imágenes.
       */

      const velocityMultiplier =
        desktopQuery.matches
          ? 1.4
          : 1.05;


      const velocityEnergy =
        clamp(
          velocity *
          velocityMultiplier,
          0,
          1
        );


      targetEnergy =
        Math.max(
          targetEnergy,
          velocityEnergy
        );


      previousScrollY =
        currentScrollY;


      previousScrollTime =
        now;

    };


    /* ==========================================================
       POINTER
       DESKTOP ONLY
       ========================================================== */

    const updatePointerTarget = (
      event
    ) => {

      if (
        !enabled() ||
        !desktopQuery.matches
      ) {
        return;
      }


      const rect =
        section.getBoundingClientRect();


      const normalizedX =
        (
          event.clientX -
          rect.left
        ) /
        rect.width;


      const normalizedY =
        (
          event.clientY -
          rect.top
        ) /
        rect.height;


      targetPointerX =
        clamp(
          (normalizedX - 0.5) * 2,
          -1,
          1
        );


      targetPointerY =
        clamp(
          (normalizedY - 0.5) * 2,
          -1,
          1
        );

    };


    const resetPointer = () => {

      targetPointerX = 0;
      targetPointerY = 0;

    };


    /* ==========================================================
       ORGANIC MOVEMENT
       ========================================================== */

    const getOrganicMotion = (
      time,
      config
    ) => {

      const t =
        time *
        config.frequency;


      const waveA =
        Math.sin(
          t +
          config.phase
        );


      const waveB =
        Math.sin(
          t * 1.73 +
          config.phase * 1.8
        );


      const waveC =
        Math.cos(
          t * 0.61 +
          config.phase * 0.73
        );


      const organicX =
        (
          waveA * 0.55 +
          waveB * 0.30 +
          waveC * 0.15
        ) *
        config.floatX;


      const organicY =
        (
          waveA * 0.25 +
          waveB * 0.50 +
          waveC * 0.25
        ) *
        config.floatY;


      return {
        x: organicX,
        y: organicY
      };

    };


    /* ==========================================================
       SET LAYER VARIABLES
       ========================================================== */

    const setLayerVariables = (
      name,
      config,
      time
    ) => {


      const organic =
        getOrganicMotion(
          time,
          config
        );


      const accelerationX =
        organic.x *
        energy *
        (
          desktopQuery.matches
            ? 0.65
            : 0.42
        );


      const accelerationY =
        Math.sin(
          time * 0.001 +
          config.phase
        ) *
        config.energy *
        energy;


      const x =
        (
          pointerX *
          config.mouseX
        ) +
        organic.x +
        accelerationX;


      const y =
        (
          scrollProgress *
          config.scrollY
        ) +
        (
          pointerY *
          config.mouseY
        ) +
        organic.y +
        accelerationY;


      section.style.setProperty(
        `--g4u-${name}-x`,
        `${x.toFixed(2)}px`
      );


      section.style.setProperty(
        `--g4u-${name}-y`,
        `${y.toFixed(2)}px`
      );


      const organicRotation =
        Math.sin(
          time *
          config.frequency *
          0.85 +
          config.phase
        ) *
        Math.min(
          Math.abs(config.rotate) *
          0.18,
          0.12
        );


      const rotation =
        (
          pointerX *
          config.rotate
        ) +
        organicRotation;


      section.style.setProperty(
        `--g4u-${name}-rotate`,
        `${rotation.toFixed(3)}deg`
      );

    };


    /* ==========================================================
       RESET
       ========================================================== */

    const resetStyles = () => {

      const layerNames = [
        'dust',
        'texture',
        'snack',
        'bread',
        'tortilla'
      ];


      layerNames.forEach(
        (name) => {

          section.style.removeProperty(
            `--g4u-${name}-x`
          );

          section.style.removeProperty(
            `--g4u-${name}-y`
          );

          section.style.removeProperty(
            `--g4u-${name}-rotate`
          );

        }
      );


      targetPointerX = 0;
      targetPointerY = 0;

      pointerX = 0;
      pointerY = 0;

      targetScrollProgress = 0;
      scrollProgress = 0;

      targetEnergy = 0;
      energy = 0;

    };


    /* ==========================================================
       ANIMATION LOOP
       ========================================================== */

    const render = (
      time
    ) => {


      if (!enabled()) {

        resetStyles();

        requestAnimationFrame(
          render
        );

        return;

      }


      /*
       * Desktop:
       * mouse un poco más reactivo.
       *
       * Mobile:
       * el scroll lleva algo más de damping para dar
       * sensación de flotación y no de rebote.
       */

      const pointerEase =
        desktopQuery.matches
          ? 0.095
          : 0.07;


      const scrollEase =
        desktopQuery.matches
          ? 0.078
          : 0.065;


      pointerX =
        lerp(
          pointerX,
          targetPointerX,
          pointerEase
        );


      pointerY =
        lerp(
          pointerY,
          targetPointerY,
          pointerEase
        );


      scrollProgress =
        lerp(
          scrollProgress,
          targetScrollProgress,
          scrollEase
        );


      /* ========================================================
         ENERGY / INERTIA
         ======================================================== */

      energy =
        lerp(
          energy,
          targetEnergy,
          desktopQuery.matches
            ? 0.12
            : 0.10
        );


      targetEnergy *=
        desktopQuery.matches
          ? 0.955
          : 0.945;


      if (
        targetEnergy < 0.001
      ) {
        targetEnergy = 0;
      }


      /* ========================================================
         RENDER VISIBLE SECTION
         ======================================================== */

      if (isVisible) {

        const layers =
          getLayers();


        setLayerVariables(
          'dust',
          layers.dust,
          time
        );


        setLayerVariables(
          'texture',
          layers.texture,
          time
        );


        setLayerVariables(
          'snack',
          layers.snack,
          time
        );


        setLayerVariables(
          'bread',
          layers.bread,
          time
        );


        setLayerVariables(
          'tortilla',
          layers.tortilla,
          time
        );

      }


      requestAnimationFrame(
        render
      );

    };


    /* ==========================================================
       INTERSECTION OBSERVER
       ========================================================== */

    if (
      'IntersectionObserver' in window
    ) {

      const observer =
        new IntersectionObserver(
          (entries) => {

            entries.forEach(
              (entry) => {

                isVisible =
                  entry.isIntersecting;


                if (isVisible) {

                  previousScrollY =
                    window.scrollY;


                  previousScrollTime =
                    performance.now();


                  updateScrollTarget();

                }

              }
            );

          },
          {
            /*
             * Mobile usa un margen algo mayor para que
             * el movimiento ya esté preparado antes de que
             * los objetos entren totalmente en pantalla.
             */

            rootMargin:
              '25% 0px 25% 0px'
          }
        );


      observer.observe(
        section
      );

    }


    /* ==========================================================
       EVENTS
       ========================================================== */

    window.addEventListener(
      'scroll',
      updateScrollTarget,
      {
        passive: true
      }
    );


    window.addEventListener(
      'resize',
      () => {

        /*
         * Si pasamos desktop -> mobile,
         * eliminamos cualquier posición residual del mouse.
         */

        if (
          !desktopQuery.matches
        ) {
          resetPointer();
        }


        previousScrollY =
          window.scrollY;


        previousScrollTime =
          performance.now();


        updateScrollTarget();

      },
      {
        passive: true
      }
    );


    section.addEventListener(
      'pointermove',
      updatePointerTarget,
      {
        passive: true
      }
    );


    section.addEventListener(
      'pointerleave',
      resetPointer,
      {
        passive: true
      }
    );


    desktopQuery.addEventListener?.(
      'change',
      () => {

        resetPointer();

        previousScrollY =
          window.scrollY;


        previousScrollTime =
          performance.now();


        updateScrollTarget();

      }
    );


    reducedMotionQuery.addEventListener?.(
      'change',
      () => {

        if (
          reducedMotionQuery.matches
        ) {
          resetStyles();
        }
        else {
          updateScrollTarget();
        }

      }
    );


    /* ==========================================================
       INIT
       ========================================================== */

    previousScrollY =
      window.scrollY;


    previousScrollTime =
      performance.now();


    updateScrollTarget();


    requestAnimationFrame(
      render
    );

  })();
</script>


