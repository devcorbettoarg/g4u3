<style>
  /* ============================================================
     G4U · MANIFESTO
     DEPTH PARALLAX / ORGANIC 3D
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }} {
    position: relative;
  }

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__art {
    background: transparent !important;

    /*
     * Perspective relativamente larga:
     * suficiente profundidad sin efecto "tarjeta 3D".
     */
    perspective: 1200px;
    perspective-origin: 50% 46%;
    transform-style: preserve-3d;
  }


  /* ============================================================
     PERFORMANCE
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__dust,

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__texture,

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__object {
    backface-visibility: hidden;
    transform-origin: center center;
  }

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__dust,

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__texture {
    will-change: translate, rotate;
  }

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__object {
    will-change: transform, translate, rotate;
  }


  /* ============================================================
     3D OBJECT TRANSFORMS

     El translate / rotate principal sigue usando las
     individual transform properties.

     El transform convencional queda reservado para:
     - Z depth
     - rotateX
     - rotateY
     - micro scale de aproximación
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__object--snack {
    transform:
      translate3d(
        0,
        0,
        var(--g4u-snack-z, 0px)
      )
      rotateX(
        var(--g4u-snack-rx, 0deg)
      )
      rotateY(
        var(--g4u-snack-ry, 0deg)
      )
      scale(
        var(--g4u-snack-depth-scale, 1)
      );
  }

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__object--bread {
    transform:
      translate3d(
        0,
        0,
        var(--g4u-bread-z, 0px)
      )
      rotateX(
        var(--g4u-bread-rx, 0deg)
      )
      rotateY(
        var(--g4u-bread-ry, 0deg)
      )
      scale(
        var(--g4u-bread-depth-scale, 1)
      );
  }

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__object--tortilla {
    transform:
      translate3d(
        0,
        0,
        var(--g4u-tortilla-z, 0px)
      )
      rotateX(
        var(--g4u-tortilla-rx, 0deg)
      )
      rotateY(
        var(--g4u-tortilla-ry, 0deg)
      )
      scale(
        var(--g4u-tortilla-depth-scale, 1)
      );
  }


  /* ============================================================
     DESKTOP
     ============================================================ */

  @media screen and (min-width: 990px) {

    /* DUST */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__dust {
      mix-blend-mode: screen;

      translate:
        var(--g4u-dust-x, 0px)
        var(--g4u-dust-y, 0px);

      rotate:
        var(--g4u-dust-rotate, 0deg);
    }


    /* TEXTURE */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__texture {
      mix-blend-mode: screen;

      translate:
        var(--g4u-texture-x, 0px)
        var(--g4u-texture-y, 0px);

      rotate:
        var(--g4u-texture-rotate, 0deg);

      scale: 1.055;
    }


    /* SNACK */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--snack {
      translate:
        var(--g4u-snack-x, 0px)
        var(--g4u-snack-y, 0px);

      rotate:
        var(--g4u-snack-rotate, 0deg);
    }


    /* BREAD */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--bread {
      translate:
        var(--g4u-bread-x, 0px)
        var(--g4u-bread-y, 0px);

      rotate:
        var(--g4u-bread-rotate, 0deg);
    }


    /* TORTILLA */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--tortilla {
      translate:
        var(--g4u-tortilla-x, 0px)
        var(--g4u-tortilla-y, 0px);

      rotate:
        var(--g4u-tortilla-rotate, 0deg);
    }
  }


  /* ============================================================
     MOBILE
     ============================================================ */

  @media screen and (max-width: 989px) {

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__dust {
      mix-blend-mode: screen;

      translate:
        calc(var(--g4u-dust-x, 0px) - 4px)
        calc(var(--g4u-dust-y, 0px) - 8px);

      rotate:
        var(--g4u-dust-rotate, 0deg);

      scale: 1.04;
    }


    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__texture {
      mix-blend-mode: screen;

      translate:
        calc(var(--g4u-texture-x, 0px) + 4px)
        var(--g4u-texture-y, 0px);

      rotate:
        var(--g4u-texture-rotate, 0deg);

      scale: 1.09;
    }


    /* SNACK */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--snack {
      translate:
        calc(var(--g4u-snack-x, 0px) - 5px)
        calc(var(--g4u-snack-y, 0px) - 28px);

      rotate:
        var(--g4u-snack-rotate, 0deg);

      /*
       * Escala estructural.
       * La profundidad dinámica se multiplica desde transform().
       */
      scale: 0.94;
    }


    /* BREAD */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--bread {
      translate:
        calc(var(--g4u-bread-x, 0px) + 4px)
        calc(var(--g4u-bread-y, 0px) + 3px);

      rotate:
        var(--g4u-bread-rotate, 0deg);

      scale: 0.93;
    }


    /* TORTILLA */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--tortilla {
      translate:
        calc(var(--g4u-tortilla-x, 0px) - 7px)
        calc(var(--g4u-tortilla-y, 0px) + 32px);

      rotate:
        var(--g4u-tortilla-rotate, 0deg);

      scale: 0.95;
    }
  }


  /* ============================================================
     EXTRA SMALL
     ============================================================ */

  @media screen and (max-width: 480px) {

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--snack {
      translate:
        calc(var(--g4u-snack-x, 0px) - 7px)
        calc(var(--g4u-snack-y, 0px) - 34px);

      scale: 0.91;
    }


    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--bread {
      translate:
        calc(var(--g4u-bread-x, 0px) + 4px)
        calc(var(--g4u-bread-y, 0px) + 3px);

      scale: 0.91;
    }


    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--tortilla {
      translate:
        calc(var(--g4u-tortilla-x, 0px) - 8px)
        calc(var(--g4u-tortilla-y, 0px) + 38px);

      scale: 0.92;
    }
  }


  /* ============================================================
     REDUCED MOTION
     ============================================================ */

  @media (prefers-reduced-motion: reduce) {

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__dust,

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__texture,

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object {
      translate: 0 0 !important;
      rotate: 0deg !important;
    }

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object {
      transform: none !important;
    }
  }
</style>


<script>
  (() => {

    const section = document.querySelector(
      '#G4uAboutManifesto-{{ section.id }}'
    );

    if (!section) return;


    /* ==========================================================
       PREVENT DOUBLE INIT
       ========================================================== */

    if (
      section.dataset.g4uParallaxInitialized === 'true'
    ) {
      return;
    }

    section.dataset.g4uParallaxInitialized = 'true';


    /* ==========================================================
       MEDIA QUERIES
       ========================================================== */

    const desktopQuery = window.matchMedia(
      '(min-width: 990px)'
    );

    const reducedMotionQuery = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );


    /* ==========================================================
       DESKTOP MOTION CONFIG
       ========================================================== */

    const desktopLayers = {

      dust: {
        scrollY: 21,
        mouseX: -4.5,
        mouseY: -4.5,

        floatX: 2.2,
        floatY: 3.2,

        frequency: 0.00032,
        phase: 0.7,

        energy: 3,
        rotate: 0.04
      },


      texture: {
        scrollY: -37,
        mouseX: 7,
        mouseY: 7,

        floatX: 3.5,
        floatY: 5,

        frequency: 0.00027,
        phase: 2.4,

        energy: 5,
        rotate: -0.06
      },


      /*
       * SNACK
       *
       * Empieza más lejos,
       * desplazado hacia izquierda / arriba.
       */

      snack: {
        scrollY: -67,

        mouseX: 18.5,
        mouseY: 14,

        floatX: 4.5,
        floatY: 6,

        frequency: 0.00055,
        phase: 1.2,

        energy: 9,
        rotate: 0.95,

        depthX: -68,
        depthY: -28,

        farZ: -180,
        nearZ: 12,

        farScale: 0.965,
        nearScale: 1,

        scalePulse: 0.018,

        tiltX: 1.4,
        tiltY: -2.4,

        pointerTilt: 0.85
      },


      /*
       * BREAD
       *
       * Es el objeto más pesado.
       * Menos dispersión lateral y acercamiento
       * ligeramente más estable.
       */

      bread: {
        scrollY: -44,

        mouseX: 11.5,
        mouseY: 9,

        floatX: 3.5,
        floatY: 4.5,

        frequency: 0.00040,
        phase: 3.8,

        energy: 6,
        rotate: -0.42,

        depthX: 10,
        depthY: 42,

        farZ: -135,
        nearZ: 16,

        farScale: 0.975,
        nearScale: 1,

        scalePulse: 0.013,

        tiltX: -1.15,
        tiltY: 1.5,

        pointerTilt: 0.65
      },


      /*
       * TORTILLA
       *
       * Empieza más lejos a la derecha,
       * generando triangulación con snack y pan.
       */

      tortilla: {
        scrollY: -55,

        mouseX: -12.5,
        mouseY: -9,

        floatX: 4,
        floatY: 5.5,

        frequency: 0.00048,
        phase: 5.1,

        energy: 7,
        rotate: -0.65,

        depthX: 70,
        depthY: 32,

        farZ: -165,
        nearZ: 10,

        farScale: 0.97,
        nearScale: 1,

        scalePulse: 0.016,

        tiltX: 1.35,
        tiltY: 2.2,

        pointerTilt: 0.8
      }

    };


    /* ==========================================================
       MOBILE MOTION CONFIG

       La profundidad se reduce bastante.
       Mobile no necesita movimientos 3D tan amplios.
       ========================================================== */

    const mobileLayers = {

      dust: {
        scrollY: 14,
        mouseX: 0,
        mouseY: 0,

        floatX: 1.5,
        floatY: 2.5,

        frequency: 0.00030,
        phase: 0.7,

        energy: 2.5,
        rotate: 0.025
      },


      texture: {
        scrollY: -23,
        mouseX: 0,
        mouseY: 0,

        floatX: 2.5,
        floatY: 3.5,

        frequency: 0.00025,
        phase: 2.4,

        energy: 4,
        rotate: -0.04
      },


      snack: {
        scrollY: -42,

        mouseX: 0,
        mouseY: 0,

        floatX: 3.2,
        floatY: 5,

        frequency: 0.00058,
        phase: 1.2,

        energy: 7,
        rotate: 0.65,

        depthX: -22,
        depthY: -24,

        farZ: -90,
        nearZ: 4,

        farScale: 0.98,
        nearScale: 1,

        scalePulse: 0.010,

        tiltX: 0.65,
        tiltY: -1.05,

        pointerTilt: 0
      },


      bread: {
        scrollY: -27,

        mouseX: 0,
        mouseY: 0,

        floatX: 2.3,
        floatY: 3.2,

        frequency: 0.00038,
        phase: 3.8,

        energy: 4.5,
        rotate: -0.27,

        depthX: 3,
        depthY: 21,

        farZ: -72,
        nearZ: 5,

        farScale: 0.985,
        nearScale: 1,

        scalePulse: 0.008,

        tiltX: -0.45,
        tiltY: 0.6,

        pointerTilt: 0
      },


      tortilla: {
        scrollY: -36,

        mouseX: 0,
        mouseY: 0,

        floatX: 3,
        floatY: 4.3,

        frequency: 0.00050,
        phase: 5.1,

        energy: 5.5,
        rotate: -0.42,

        depthX: 22,
        depthY: 25,

        farZ: -82,
        nearZ: 4,

        farScale: 0.98,
        nearScale: 1,

        scalePulse: 0.010,

        tiltX: 0.6,
        tiltY: 0.9,

        pointerTilt: 0
      }

    };


    /* ==========================================================
       CONFIG
       ========================================================== */

    const getLayers = () => {
      return desktopQuery.matches
        ? desktopLayers
        : mobileLayers;
    };


    /* ==========================================================
       STATE
       ========================================================== */

    let targetPointerX = 0;
    let targetPointerY = 0;

    let pointerX = 0;
    let pointerY = 0;

    let targetScrollProgress = 0;
    let scrollProgress = 0;

    /*
     * Nuevo:
     *
     * 0 = objetos lejos
     * 1 = objetos en posición final
     */
    let targetApproachProgress = 0;
    let approachProgress = 0;

    let targetEnergy = 0;
    let energy = 0;

    let previousScrollY =
      window.scrollY;

    let previousScrollTime =
      performance.now();

    let isVisible = true;


    /* ==========================================================
       HELPERS
       ========================================================== */

    const clamp = (
      value,
      min,
      max
    ) => {
      return Math.min(
        Math.max(value, min),
        max
      );
    };


    const lerp = (
      current,
      target,
      amount
    ) => {
      return current +
        (target - current) * amount;
    };


    /*
     * Smoothstep evita que el acercamiento
     * tenga comienzo o final mecánicos.
     */
    const smoothstep = (
      edge0,
      edge1,
      value
    ) => {

      const x = clamp(
        (
          value - edge0
        ) /
        (
          edge1 - edge0
        ),
        0,
        1
      );

      return x * x * (3 - 2 * x);
    };


    const enabled = () => {
      return !reducedMotionQuery.matches;
    };


    /* ==========================================================
       SCROLL POSITION
       ========================================================== */

    const updateScrollTarget = () => {

      if (!enabled()) return;


      const rect =
        section.getBoundingClientRect();

      const viewportHeight =
        window.innerHeight;


      /* ----------------------------------------------------------
         PARALLAX TRADICIONAL
         ---------------------------------------------------------- */

      const sectionCenter =
        rect.top +
        rect.height / 2;

      const viewportCenter =
        viewportHeight / 2;

      const distance =
        viewportCenter -
        sectionCenter;

      const range =
        (
          viewportHeight +
          rect.height
        ) / 2;


      targetScrollProgress =
        clamp(
          distance / range,
          -1,
          1
        );


      /* ----------------------------------------------------------
         DEPTH / APPROACH PROGRESS

         Empieza cuando la sección comienza
         a entrar por debajo del viewport.

         Termina aproximadamente cuando la parte superior
         de la sección alcanza el tercio superior de pantalla.

         Esto evita que el objeto siga aumentando
         indefinidamente durante toda la sección.
         ---------------------------------------------------------- */

      const approachRange =
        viewportHeight +
        Math.min(
          rect.height,
          viewportHeight
        );


      const rawApproach =
        clamp(
          (
            viewportHeight -
            rect.top
          ) /
          approachRange,
          0,
          1
        );


      targetApproachProgress =
        smoothstep(
          0.015,
          0.50,
          rawApproach
        );


      /* ----------------------------------------------------------
         SCROLL VELOCITY
         ---------------------------------------------------------- */

      const now =
        performance.now();

      const currentScrollY =
        window.scrollY;

      const deltaY =
        currentScrollY -
        previousScrollY;

      const deltaTime =
        Math.max(
          now -
          previousScrollTime,
          16
        );

      const velocity =
        Math.abs(deltaY) /
        deltaTime;


      const velocityMultiplier =
        desktopQuery.matches
          ? 1.4
          : 1.05;


      const velocityEnergy =
        clamp(
          velocity *
          velocityMultiplier,
          0,
          1
        );


      targetEnergy =
        Math.max(
          targetEnergy,
          velocityEnergy
        );


      previousScrollY =
        currentScrollY;

      previousScrollTime =
        now;
    };


    /* ==========================================================
       POINTER
       DESKTOP ONLY
       ========================================================== */

    const updatePointerTarget = (
      event
    ) => {

      if (
        !enabled() ||
        !desktopQuery.matches
      ) {
        return;
      }


      const rect =
        section.getBoundingClientRect();


      const normalizedX =
        (
          event.clientX -
          rect.left
        ) /
        rect.width;


      const normalizedY =
        (
          event.clientY -
          rect.top
        ) /
        rect.height;


      targetPointerX =
        clamp(
          (normalizedX - 0.5) * 2,
          -1,
          1
        );


      targetPointerY =
        clamp(
          (normalizedY - 0.5) * 2,
          -1,
          1
        );
    };


    const resetPointer = () => {
      targetPointerX = 0;
      targetPointerY = 0;
    };


    /* ==========================================================
       ORGANIC MOTION
       ========================================================== */

    const getOrganicMotion = (
      time,
      config
    ) => {

      const t =
        time *
        config.frequency;


      const waveA =
        Math.sin(
          t +
          config.phase
        );


      const waveB =
        Math.sin(
          t * 1.73 +
          config.phase * 1.8
        );


      const waveC =
        Math.cos(
          t * 0.61 +
          config.phase * 0.73
        );


      const organicX =
        (
          waveA * 0.55 +
          waveB * 0.30 +
          waveC * 0.15
        ) *
        config.floatX;


      const organicY =
        (
          waveA * 0.25 +
          waveB * 0.50 +
          waveC * 0.25
        ) *
        config.floatY;


      return {
        x: organicX,
        y: organicY
      };
    };


    /* ==========================================================
       SET LAYER VARIABLES
       ========================================================== */

    const setLayerVariables = (
      name,
      config,
      time
    ) => {

      const organic =
        getOrganicMotion(
          time,
          config
        );


      const accelerationX =
        organic.x *
        energy *
        (
          desktopQuery.matches
            ? 0.65
            : 0.42
        );


      const accelerationY =
        Math.sin(
          time * 0.001 +
          config.phase
        ) *
        config.energy *
        energy;


      /*
       * Cuando approachProgress = 0,
       * farAmount = 1.
       *
       * Cuando llega a composición final,
       * farAmount = 0.
       */
      const farAmount =
        1 -
        approachProgress;


      const depthOffsetX =
        config.depthX !== undefined
          ? config.depthX * farAmount
          : 0;


      const depthOffsetY =
        config.depthY !== undefined
          ? config.depthY * farAmount
          : 0;


      const x =
        (
          pointerX *
          config.mouseX
        ) +
        organic.x +
        accelerationX +
        depthOffsetX;


      const y =
        (
          scrollProgress *
          config.scrollY
        ) +
        (
          pointerY *
          config.mouseY
        ) +
        organic.y +
        accelerationY +
        depthOffsetY;


      section.style.setProperty(
        `--g4u-${name}-x`,
        `${x.toFixed(2)}px`
      );


      section.style.setProperty(
        `--g4u-${name}-y`,
        `${y.toFixed(2)}px`
      );


      /* ========================================================
         2D ROTATION
         ======================================================== */

      const organicRotation =
        Math.sin(
          time *
          config.frequency *
          0.85 +
          config.phase
        ) *
        Math.min(
          Math.abs(config.rotate) *
          0.18,
          0.12
        );


      const rotation =
        (
          pointerX *
          config.rotate
        ) +
        organicRotation;


      section.style.setProperty(
        `--g4u-${name}-rotate`,
        `${rotation.toFixed(3)}deg`
      );


      /* ========================================================
         3D DEPTH
         Sólo productos.
         ======================================================== */

      if (
        config.farZ !== undefined
      ) {

        /*
         * Z interpolation
         */
        const z =
          lerp(
            config.farZ,
            config.nearZ,
            approachProgress
          );


        /*
         * Micro overshoot.

         * 0 al principio,
         * máximo en mitad del acercamiento,
         * vuelve a 0 al finalizar.
         */
        const pulse =
          Math.sin(
            approachProgress *
            Math.PI
          ) *
          config.scalePulse;


        const depthScale =
          lerp(
            config.farScale,
            config.nearScale,
            approachProgress
          ) +
          pulse;


        /*
         * El tilt inicial desaparece progresivamente.
         * El mouse aporta sólo una mínima perspectiva.
         */
        const rx =
          (
            config.tiltX *
            farAmount
          ) -
          (
            pointerY *
            config.pointerTilt
          );


        const ry =
          (
            config.tiltY *
            farAmount
          ) +
          (
            pointerX *
            config.pointerTilt
          );


        section.style.setProperty(
          `--g4u-${name}-z`,
          `${z.toFixed(2)}px`
        );


        section.style.setProperty(
          `--g4u-${name}-depth-scale`,
          depthScale.toFixed(4)
        );


        section.style.setProperty(
          `--g4u-${name}-rx`,
          `${rx.toFixed(3)}deg`
        );


        section.style.setProperty(
          `--g4u-${name}-ry`,
          `${ry.toFixed(3)}deg`
        );
      }
    };


    /* ==========================================================
       RESET
       ========================================================== */

    const resetStyles = () => {

      const layerNames = [
        'dust',
        'texture',
        'snack',
        'bread',
        'tortilla'
      ];


      layerNames.forEach(
        (name) => {

          section.style.removeProperty(
            `--g4u-${name}-x`
          );

          section.style.removeProperty(
            `--g4u-${name}-y`
          );

          section.style.removeProperty(
            `--g4u-${name}-rotate`
          );

          section.style.removeProperty(
            `--g4u-${name}-z`
          );

          section.style.removeProperty(
            `--g4u-${name}-rx`
          );

          section.style.removeProperty(
            `--g4u-${name}-ry`
          );

          section.style.removeProperty(
            `--g4u-${name}-depth-scale`
          );
        }
      );


      targetPointerX = 0;
      targetPointerY = 0;

      pointerX = 0;
      pointerY = 0;

      targetScrollProgress = 0;
      scrollProgress = 0;

      targetApproachProgress = 0;
      approachProgress = 0;

      targetEnergy = 0;
      energy = 0;
    };


    /* ==========================================================
       RENDER LOOP
       ========================================================== */

    const render = (
      time
    ) => {

      if (!enabled()) {

        requestAnimationFrame(
          render
        );

        return;
      }


      const pointerEase =
        desktopQuery.matches
          ? 0.095
          : 0.07;


      /*
       * Parallax tradicional:
       * deliberadamente flotante.
       */
      const scrollEase =
        desktopQuery.matches
          ? 0.078
          : 0.065;


      /*
       * Acercamiento algo más pesado.

       * Esto es importante:
       * si fuese igual de rápido que el scroll,
       * parecería una interpolación CSS simple.
       */
      const approachEase =
        desktopQuery.matches
          ? 0.055
          : 0.048;


      pointerX =
        lerp(
          pointerX,
          targetPointerX,
          pointerEase
        );


      pointerY =
        lerp(
          pointerY,
          targetPointerY,
          pointerEase
        );


      scrollProgress =
        lerp(
          scrollProgress,
          targetScrollProgress,
          scrollEase
        );


      approachProgress =
        lerp(
          approachProgress,
          targetApproachProgress,
          approachEase
        );


      /* ========================================================
         ENERGY / INERTIA
         ======================================================== */

      energy =
        lerp(
          energy,
          targetEnergy,
          desktopQuery.matches
            ? 0.12
            : 0.10
        );


      targetEnergy *=
        desktopQuery.matches
          ? 0.955
          : 0.945;


      if (
        targetEnergy < 0.001
      ) {
        targetEnergy = 0;
      }


      /* ========================================================
         RENDER ONLY WHEN NEAR VIEWPORT
         ======================================================== */

      if (isVisible) {

        const layers =
          getLayers();


        setLayerVariables(
          'dust',
          layers.dust,
          time
        );


        setLayerVariables(
          'texture',
          layers.texture,
          time
        );


        setLayerVariables(
          'snack',
          layers.snack,
          time
        );


        setLayerVariables(
          'bread',
          layers.bread,
          time
        );


        setLayerVariables(
          'tortilla',
          layers.tortilla,
          time
        );
      }


      requestAnimationFrame(
        render
      );
    };


    /* ==========================================================
       INTERSECTION OBSERVER
       ========================================================== */

    if (
      'IntersectionObserver' in window
    ) {

      const observer =
        new IntersectionObserver(
          (entries) => {

            entries.forEach(
              (entry) => {

                isVisible =
                  entry.isIntersecting;


                if (isVisible) {

                  previousScrollY =
                    window.scrollY;

                  previousScrollTime =
                    performance.now();

                  updateScrollTarget();
                }
              }
            );
          },
          {
            /*
             * Empezamos a preparar las posiciones antes
             * de que los productos entren realmente.
             */
            rootMargin:
              '35% 0px 35% 0px'
          }
        );


      observer.observe(
        section
      );
    }


    /* ==========================================================
       EVENTS
       ========================================================== */

    window.addEventListener(
      'scroll',
      updateScrollTarget,
      {
        passive: true
      }
    );


    window.addEventListener(
      'resize',
      () => {

        if (
          !desktopQuery.matches
        ) {
          resetPointer();
        }


        previousScrollY =
          window.scrollY;

        previousScrollTime =
          performance.now();


        updateScrollTarget();
      },
      {
        passive: true
      }
    );


    section.addEventListener(
      'pointermove',
      updatePointerTarget,
      {
        passive: true
      }
    );


    section.addEventListener(
      'pointerleave',
      resetPointer,
      {
        passive: true
      }
    );


    desktopQuery.addEventListener?.(
      'change',
      () => {

        resetPointer();

        previousScrollY =
          window.scrollY;

        previousScrollTime =
          performance.now();

        updateScrollTarget();
      }
    );


    reducedMotionQuery.addEventListener?.(
      'change',
      () => {

        if (
          reducedMotionQuery.matches
        ) {
          resetStyles();
        }
        else {
          updateScrollTarget();
        }
      }
    );


    /* ==========================================================
       INIT
       ========================================================== */

    previousScrollY =
      window.scrollY;

    previousScrollTime =
      performance.now();


    updateScrollTarget();


    requestAnimationFrame(
      render
    );

  })();
</script>