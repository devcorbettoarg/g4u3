<section class="g4u-about-manifesto" id="G4uAboutManifesto" aria-labelledby="G4uAboutManifestoTitle-{{ section.id }}">
  <div class="g4u-about-manifesto__copy">
    <h2 class="g4u-about-manifesto__title g4u-display" id="G4uAboutManifestoTitle-{{ section.id }}">
      Creemos en la <em>nutrición inteligente,</em><br>
      la que combina <strong>ciencia, sabor</strong><br>
      y <strong>bienestar</strong> real.<br>
      En los alimentos que<br>
      no prometen magia,<br>
      sino <em>resultados</em> auténticos.<br>
      Creemos en la <strong>transparencia,</strong><br>
      en los <em>ingredientes limpios</em><br>
      y en las <strong>decisiones conscientes.</strong><br>
      Creemos que lo <em>saludable</em><br>
      no tiene que ser aburrido.
    </h2>
    <div class="g4u-about-manifesto__closing g4u-display">
      <p>{{ section.settings.closing | escape | newline_to_br }}</p>
      <p>{{ section.settings.closing_accent | escape | newline_to_br }}</p>
    </div>
  </div>
  <div class="g4u-about-manifesto__art" aria-hidden="true">
    {%- if section.settings.dust_image != blank -%}{{ section.settings.dust_image | image_url: width: 1024 | image_tag: class: 'g4u-about-manifesto__dust', loading: 'lazy' }}{%- else -%}<img class="g4u-about-manifesto__dust" src="{{ 'g4u-about-manifesto-dust.png' | asset_url }}" alt="" width="1024" height="1536" loading="lazy">{%- endif -%}
    {%- if section.settings.texture_image != blank -%}{{ section.settings.texture_image | image_url: width: 1024 | image_tag: class: 'g4u-about-manifesto__texture', loading: 'lazy' }}{%- else -%}<img class="g4u-about-manifesto__texture" src="{{ 'g4u-about-manifesto-texture.png' | asset_url }}" alt="" width="1024" height="1535" loading="lazy">{%- endif -%}
    {%- if section.settings.snack_image != blank -%}{{ section.settings.snack_image | image_url: width: 456 | image_tag: class: 'g4u-about-manifesto__object g4u-about-manifesto__object--snack', loading: 'lazy' }}{%- else -%}<img class="g4u-about-manifesto__object g4u-about-manifesto__object--snack" src="{{ 'g4u-about-snack.png' | asset_url }}" alt="" width="456" height="458" loading="lazy">{%- endif -%}
    {%- if section.settings.bread_image != blank -%}{{ section.settings.bread_image | image_url: width: 866 | image_tag: class: 'g4u-about-manifesto__object g4u-about-manifesto__object--bread', loading: 'lazy' }}{%- else -%}<img class="g4u-about-manifesto__object g4u-about-manifesto__object--bread" src="{{ 'g4u-about-bread.png' | asset_url }}" alt="" width="866" height="926" loading="lazy">{%- endif -%}
    {%- if section.settings.tortilla_image != blank -%}{{ section.settings.tortilla_image | image_url: width: 490 | image_tag: class: 'g4u-about-manifesto__object g4u-about-manifesto__object--tortilla', loading: 'lazy' }}{%- else -%}<img class="g4u-about-manifesto__object g4u-about-manifesto__object--tortilla" src="{{ 'g4u-about-tortilla.png' | asset_url }}" alt="" width="490" height="449" loading="lazy">{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "G4U · Manifiesto Nosotros",
  "tag": "section",
  "class": "section-g4u-about-manifesto",
  "settings": [
    { "type": "header", "content": "Imágenes decorativas" },
    { "type": "image_picker", "id": "dust_image", "label": "Polvo / fondo izquierdo" },
    { "type": "image_picker", "id": "texture_image", "label": "Textura / fondo derecho" },
    { "type": "image_picker", "id": "snack_image", "label": "Producto izquierdo" },
    { "type": "image_picker", "id": "bread_image", "label": "Producto central" },
    { "type": "image_picker", "id": "tortilla_image", "label": "Producto derecho" },
    { "type": "textarea", "id": "closing", "label": "Cierre", "default": "Por eso existimos:\nPara redefinir el pan." },
    { "type": "textarea", "id": "closing_accent", "label": "Cierre destacado", "default": "Y demostrar que lo que te hace bien…\ntambién puede ser rico." }
  ],
  "presets": [{ "name": "G4U · Manifiesto Nosotros" }]
}
{% endschema %}
