<section
  class="g4u-about-manifesto"
  id="G4uAboutManifesto-{{ section.id }}"
  aria-labelledby="G4uAboutManifestoTitle-{{ section.id }}"
  data-g4u-manifesto-parallax
>
  <div class="g4u-about-manifesto__copy">
    <h2
      class="g4u-about-manifesto__title g4u-display"
      id="G4uAboutManifestoTitle-{{ section.id }}"
    >
      Creemos en la <em>nutrición inteligente,</em><br>
      la que combina <strong>ciencia, sabor</strong><br>
      y <strong>bienestar</strong> real.<br>
      En los alimentos que<br>
      no prometen magia,<br>
      sino <em>resultados</em> auténticos.<br>
      Creemos en la <strong>transparencia,</strong><br>
      en los <em>ingredientes limpios</em><br>
      y en las <strong>decisiones conscientes.</strong><br>
      Creemos que lo <em>saludable</em><br>
      no tiene que ser aburrido.
    </h2>

    <div class="g4u-about-manifesto__closing g4u-display">
      <p>
        {{ section.settings.closing | escape | newline_to_br }}
      </p>

      <p>
        {{ section.settings.closing_accent | escape | newline_to_br }}
      </p>
    </div>
  </div>


  <div
    class="g4u-about-manifesto__art"
    aria-hidden="true"
  >

    {%- if section.settings.dust_image != blank -%}
      {{
        section.settings.dust_image
        | image_url: width: 1400
        | image_tag:
          class: 'g4u-about-manifesto__dust',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__dust"
        src="{{ 'g4u-about-manifesto-dust.png' | asset_url }}"
        alt=""
        width="1024"
        height="1536"
        loading="lazy"
      >
    {%- endif -%}


    {%- if section.settings.texture_image != blank -%}
      {{
        section.settings.texture_image
        | image_url: width: 1400
        | image_tag:
          class: 'g4u-about-manifesto__texture',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__texture"
        src="{{ 'g4u-about-manifesto-texture.png' | asset_url }}"
        alt=""
        width="1024"
        height="1535"
        loading="lazy"
      >
    {%- endif -%}


    {%- if section.settings.snack_image != blank -%}
      {{
        section.settings.snack_image
        | image_url: width: 700
        | image_tag:
          class: 'g4u-about-manifesto__object g4u-about-manifesto__object--snack',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__object g4u-about-manifesto__object--snack"
        src="{{ 'g4u-about-snack.png' | asset_url }}"
        alt=""
        width="456"
        height="458"
        loading="lazy"
      >
    {%- endif -%}


    {%- if section.settings.bread_image != blank -%}
      {{
        section.settings.bread_image
        | image_url: width: 1100
        | image_tag:
          class: 'g4u-about-manifesto__object g4u-about-manifesto__object--bread',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__object g4u-about-manifesto__object--bread"
        src="{{ 'g4u-about-bread.png' | asset_url }}"
        alt=""
        width="866"
        height="926"
        loading="lazy"
      >
    {%- endif -%}


    {%- if section.settings.tortilla_image != blank -%}
      {{
        section.settings.tortilla_image
        | image_url: width: 700
        | image_tag:
          class: 'g4u-about-manifesto__object g4u-about-manifesto__object--tortilla',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__object g4u-about-manifesto__object--tortilla"
        src="{{ 'g4u-about-tortilla.png' | asset_url }}"
        alt=""
        width="490"
        height="449"
        loading="lazy"
      >
    {%- endif -%}

  </div>
</section>


<style>
  /* ============================================================
     G4U · MANIFESTO
     CINEMATIC DEPTH PARALLAX V3
     ============================================================ */


  /* ============================================================
     ROOT / BACKGROUND

     #500322 ES EL ÚNICO COLOR DE FONDO.
     ============================================================ */

  .section-g4u-about-manifesto {
    background:
      #500322 !important;

    background-color:
      #500322 !important;

    background-image:
      none !important;

    overflow-x:
      hidden;
  }


  #G4uAboutManifesto-{{ section.id }} {
    position:
      relative;

    background:
      #500322 !important;

    background-color:
      #500322 !important;

    background-image:
      none !important;

    overflow-x:
      hidden;

    overflow-x:
      clip;
  }


  /* ============================================================
     ELIMINAR POSIBLES BACKGROUNDS AUXILIARES DEL THEME
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}::before,
  #G4uAboutManifesto-{{ section.id }}::after {
    background:
      transparent !important;

    background-image:
      none !important;
  }


  /* ============================================================
     COPY

     Siempre por encima.
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__copy {
    position:
      relative;

    z-index:
      10;
  }


  /* ============================================================
     ART CONTAINER

     MUY IMPORTANTE:

     Las partículas quedan recortadas dentro del área gráfica.
     De esta manera jamás pueden dibujar barras oscuras
     encima de la zona de texto.
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__art {
    background:
      #500322 !important;

    background-color:
      #500322 !important;

    background-image:
      none !important;

    overflow:
      hidden !important;

    isolation:
      isolate;

    contain:
      paint;
  }


  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__art::before,

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__art::after {
    content:
      none !important;

    display:
      none !important;

    background:
      none !important;
  }


  /* ============================================================
     PARTICLE LAYERS
     ============================================================

     Estas imágenes NO forman parte del mismo plano que
     los productos.

     Son background visual.

     - z-index 0
     - screen
     - grayscale
     - contrast alto
     - brightness reducido

     El tratamiento "aplasta" el fondo oscuro de los archivos
     para que desaparezca y deja fundamentalmente las partículas.
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__dust,

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__texture {
    position:
      absolute !important;

    z-index:
      0 !important;

    pointer-events:
      none !important;

    background:
      transparent !important;

    background-color:
      transparent !important;

    background-image:
      none !important;

    mix-blend-mode:
      screen !important;

    transform-origin:
      center center;

    backface-visibility:
      hidden;

    max-width:
      none !important;

    will-change:
      transform;

    /*
     * "Luma key" CSS.
     *
     * Convierte el fondo rojizo/oscuro del asset
     * prácticamente en negro.
     *
     * Con screen, el negro deja de modificar #500322.
     */
    filter:
      grayscale(1)
      contrast(2.35)
      brightness(0.72);

    opacity:
      0.78;
  }


  /* ============================================================
     DUST

     Overscan:
     nunca se ve un borde aunque se mueva.
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__dust {
    inset:
      -7% !important;

    width:
      114% !important;

    height:
      114% !important;

    object-fit:
      cover !important;

    object-position:
      45% 50% !important;

    transform:
      translate3d(
        var(--g4u-dust-x, 0px),
        var(--g4u-dust-y, 0px),
        0
      )
      rotate(
        var(--g4u-dust-rotate, 0deg)
      )
      scale(1.02);
  }


  /* ============================================================
     TEXTURE
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__texture {
    inset:
      -8% !important;

    width:
      116% !important;

    height:
      116% !important;

    object-fit:
      cover !important;

    object-position:
      55% 50% !important;

    opacity:
      0.58;

    filter:
      grayscale(1)
      contrast(2.55)
      brightness(0.68);

    transform:
      translate3d(
        var(--g4u-texture-x, 0px),
        var(--g4u-texture-y, 0px),
        0
      )
      rotate(
        var(--g4u-texture-rotate, 0deg)
      )
      scale(1.03);
  }


  /* ============================================================
     PRODUCTS
     ============================================================

     NO MIX BLEND.
     NO FILTER.
     NO BACKGROUND.
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__object {
    position:
      absolute;

    z-index:
      3 !important;

    pointer-events:
      none;

    background:
      transparent !important;

    background-color:
      transparent !important;

    background-image:
      none !important;

    mix-blend-mode:
      normal !important;

    filter:
      none !important;

    opacity:
      1 !important;

    transform-origin:
      center center;

    backface-visibility:
      hidden;

    will-change:
      transform;
  }


  /* ============================================================
     SNACK
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__object--snack {
    transform:
      perspective(1500px)

      translate3d(
        var(--g4u-snack-x, 0px),
        var(--g4u-snack-y, 0px),
        0
      )

      rotate(
        var(--g4u-snack-rz, 0deg)
      )

      rotateX(
        var(--g4u-snack-rx, 0deg)
      )

      rotateY(
        var(--g4u-snack-ry, 0deg)
      )

      scale(
        var(--g4u-snack-scale, 1)
      );
  }


  /* ============================================================
     BREAD
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__object--bread {
    transform:
      perspective(1600px)

      translate3d(
        var(--g4u-bread-x, 0px),
        var(--g4u-bread-y, 0px),
        0
      )

      rotate(
        var(--g4u-bread-rz, 0deg)
      )

      rotateX(
        var(--g4u-bread-rx, 0deg)
      )

      rotateY(
        var(--g4u-bread-ry, 0deg)
      )

      scale(
        var(--g4u-bread-scale, 1)
      );
  }


  /* ============================================================
     TORTILLA
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__object--tortilla {
    transform:
      perspective(1500px)

      translate3d(
        var(--g4u-tortilla-x, 0px),
        var(--g4u-tortilla-y, 0px),
        0
      )

      rotate(
        var(--g4u-tortilla-rz, 0deg)
      )

      rotateX(
        var(--g4u-tortilla-rx, 0deg)
      )

      rotateY(
        var(--g4u-tortilla-ry, 0deg)
      )

      scale(
        var(--g4u-tortilla-scale, 1)
      );
  }


  /* ============================================================
     MOBILE ORIGINAL POSITIONING

     Conservamos los pequeños offsets que tenías,
     pero la animación dinámica va mediante transform.
     ============================================================ */

  @media screen and (max-width: 989px) {

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--snack {
      margin-left:
        -5px;

      margin-top:
        -28px;
    }


    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--bread {
      margin-left:
        4px;

      margin-top:
        3px;
    }


    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--tortilla {
      margin-left:
        -7px;

      margin-top:
        32px;
    }

  }


  @media screen and (max-width: 480px) {

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--snack {
      margin-left:
        -7px;

      margin-top:
        -34px;
    }


    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--tortilla {
      margin-left:
        -8px;

      margin-top:
        38px;
    }

  }


  /* ============================================================
     REDUCED MOTION
     ============================================================ */

  @media (
    prefers-reduced-motion: reduce
  ) {

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__dust,

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__texture {
      transform:
        none !important;
    }


    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object {
      transform:
        none !important;
    }

  }
</style>


<script>
  (() => {

    const section =
      document.querySelector(
        '#G4uAboutManifesto-{{ section.id }}'
      );


    if (!section) {
      return;
    }


    /* ==========================================================
       PREVENT DOUBLE INITIALIZATION
       ========================================================== */

    if (
      section.dataset.g4uParallaxInitialized ===
      'true'
    ) {
      return;
    }


    section.dataset.g4uParallaxInitialized =
      'true';


    /* ==========================================================
       MEDIA
       ========================================================== */

    const desktopQuery =
      window.matchMedia(
        '(min-width: 990px)'
      );


    const reducedMotionQuery =
      window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      );


    /* ==========================================================
       DESKTOP CONFIG
       ========================================================== */

    const desktopLayers = {

      /*
       * ========================================================
       * BACKGROUND PARTICLES
       *
       * Muy poco desplazamiento.
       *
       * Se deben sentir prácticamente ancladas al fondo.
       * ========================================================
       */

      dust: {
        scrollY:
          8,

        pointerX:
          -1.5,

        pointerY:
          -1.0,

        floatX:
          1.0,

        floatY:
          1.4,

        frequency:
          0.00022,

        phase:
          0.5,

        rotation:
          0.018
      },


      texture: {
        scrollY:
          -11,

        pointerX:
          1.8,

        pointerY:
          1.2,

        floatX:
          1.3,

        floatY:
          1.8,

        frequency:
          0.00019,

        phase:
          2.2,

        rotation:
          -0.022
      },


      /*
       * ========================================================
       * SNACK
       *
       * Liviano.
       * Se acerca algo más rápido.
       *
       * Separación inicial deliberadamente pequeña.
       * ========================================================
       */

      snack: {
        scrollY:
          -48,

        pointerX:
          10,

        pointerY:
          7,

        floatX:
          2.6,

        floatY:
          3.4,

        frequency:
          0.00048,

        phase:
          1.1,

        rotation:
          0.48,

        energy:
          3.8,


        farX:
          -9,

        farY:
          -8,


        farScale:
          0.89,

        nearScale:
          1,


        scalePulse:
          0.012,


        farTiltX:
          0.65,

        farTiltY:
          -0.9,


        pointerTilt:
          0.28
      },


      /*
       * ========================================================
       * CENTRAL BREAD
       *
       * Más pesado.
       * Menos recorrido.
       * ========================================================
       */

      bread: {
        scrollY:
          -34,

        pointerX:
          6.5,

        pointerY:
          5,

        floatX:
          2,

        floatY:
          2.7,

        frequency:
          0.00035,

        phase:
          3.7,

        rotation:
          -0.25,

        energy:
          2.8,


        farX:
          0,

        farY:
          8,


        farScale:
          0.91,

        nearScale:
          1,


        scalePulse:
          0.009,


        farTiltX:
          -0.45,

        farTiltY:
          0.55,


        pointerTilt:
          0.21
      },


      /*
       * ========================================================
       * TORTILLA
       *
       * Contrapeso del snack.
       * ========================================================
       */

      tortilla: {
        scrollY:
          -41,

        pointerX:
          -7.5,

        pointerY:
          -5.5,

        floatX:
          2.3,

        floatY:
          3,

        frequency:
          0.00043,

        phase:
          5.0,

        rotation:
          -0.36,

        energy:
          3.2,


        farX:
          9,

        farY:
          8,


        farScale:
          0.90,

        nearScale:
          1,


        scalePulse:
          0.010,


        farTiltX:
          0.55,

        farTiltY:
          0.75,


        pointerTilt:
          0.24
      }

    };


    /* ==========================================================
       MOBILE CONFIG
       ========================================================== */

    const mobileLayers = {


      dust: {
        scrollY:
          4,

        pointerX:
          0,

        pointerY:
          0,

        floatX:
          0.6,

        floatY:
          0.9,

        frequency:
          0.00022,

        phase:
          0.5,

        rotation:
          0.010
      },


      texture: {
        scrollY:
          -6,

        pointerX:
          0,

        pointerY:
          0,

        floatX:
          0.8,

        floatY:
          1.1,

        frequency:
          0.00019,

        phase:
          2.2,

        rotation:
          -0.012
      },


      snack: {
        scrollY:
          -30,

        pointerX:
          0,

        pointerY:
          0,

        floatX:
          1.6,

        floatY:
          2.3,

        frequency:
          0.00048,

        phase:
          1.1,

        rotation:
          0.28,

        energy:
          2.7,


        farX:
          -4,

        farY:
          -4,


        farScale:
          0.94,

        nearScale:
          1,


        scalePulse:
          0.006,


        farTiltX:
          0.25,

        farTiltY:
          -0.35,


        pointerTilt:
          0
      },


      bread: {
        scrollY:
          -21,

        pointerX:
          0,

        pointerY:
          0,

        floatX:
          1.3,

        floatY:
          1.8,

        frequency:
          0.00035,

        phase:
          3.7,

        rotation:
          -0.15,

        energy:
          2,


        farX:
          0,

        farY:
          3,


        farScale:
          0.95,

        nearScale:
          1,


        scalePulse:
          0.005,


        farTiltX:
          -0.18,

        farTiltY:
          0.22,


        pointerTilt:
          0
      },


      tortilla: {
        scrollY:
          -26,

        pointerX:
          0,

        pointerY:
          0,

        floatX:
          1.5,

        floatY:
          2,

        frequency:
          0.00043,

        phase:
          5.0,

        rotation:
          -0.21,

        energy:
          2.3,


        farX:
          4,

        farY:
          4,


        farScale:
          0.945,

        nearScale:
          1,


        scalePulse:
          0.006,


        farTiltX:
          0.20,

        farTiltY:
          0.30,


        pointerTilt:
          0
      }

    };


    /* ==========================================================
       STATE
       ========================================================== */

    let targetPointerX =
      0;

    let targetPointerY =
      0;


    let pointerX =
      0;

    let pointerY =
      0;


    let targetScroll =
      0;

    let scroll =
      0;


    /*
     * 0:
     * objetos lejos.
     *
     * 1:
     * objetos en su escala final.
     */
    let targetApproach =
      0;

    let approach =
      0;


    let targetEnergy =
      0;

    let energy =
      0;


    let previousScrollY =
      window.scrollY;


    let previousScrollTime =
      performance.now();


    let isVisible =
      true;


    /* ==========================================================
       HELPERS
       ========================================================== */

    const clamp = (
      value,
      min,
      max
    ) => {

      return Math.min(
        Math.max(
          value,
          min
        ),
        max
      );

    };


    const lerp = (
      current,
      target,
      amount
    ) => {

      return (
        current +
        (
          target -
          current
        ) *
        amount
      );

    };


    const smoothstep = (
      value
    ) => {

      const x =
        clamp(
          value,
          0,
          1
        );


      return (
        x *
        x *
        (
          3 -
          (
            2 *
            x
          )
        )
      );

    };


    const getLayers = () => {

      return desktopQuery.matches
        ? desktopLayers
        : mobileLayers;

    };


    /* ==========================================================
       SCROLL TARGET
       ========================================================== */

    const updateScrollTarget = () => {

      if (
        reducedMotionQuery.matches
      ) {
        return;
      }


      const rect =
        section.getBoundingClientRect();


      const viewportHeight =
        window.innerHeight;


      /* ========================================================
         GENERAL SCROLL PROGRESS
         ======================================================== */

      const sectionCenter =
        rect.top +
        (
          rect.height /
          2
        );


      const viewportCenter =
        viewportHeight /
        2;


      const range =
        (
          viewportHeight +
          rect.height
        ) /
        2;


      targetScroll =
        clamp(
          (
            viewportCenter -
            sectionCenter
          ) /
          range,
          -1,
          1
        );


      /* ========================================================
         APPROACH PROGRESS

         Empieza antes de entrar.

         La mayor parte del acercamiento ocurre mientras
         el hero visual va entrando en viewport.
         ======================================================== */

      const start =
        viewportHeight *
        1.12;


      const end =
        viewportHeight *
        0.08;


      const rawApproach =
        clamp(
          (
            start -
            rect.top
          ) /
          (
            start -
            end
          ),
          0,
          1
        );


      targetApproach =
        smoothstep(
          rawApproach
        );


      /* ========================================================
         VELOCITY
         ======================================================== */

      const now =
        performance.now();


      const currentScrollY =
        window.scrollY;


      const deltaY =
        currentScrollY -
        previousScrollY;


      const deltaTime =
        Math.max(
          now -
          previousScrollTime,
          16
        );


      const velocity =
        Math.abs(
          deltaY
        ) /
        deltaTime;


      const velocityMultiplier =
        desktopQuery.matches
          ? 1.1
          : 0.8;


      targetEnergy =
        Math.max(
          targetEnergy,
          clamp(
            velocity *
            velocityMultiplier,
            0,
            1
          )
        );


      previousScrollY =
        currentScrollY;


      previousScrollTime =
        now;

    };


    /* ==========================================================
       POINTER
       ========================================================== */

    const updatePointer = (
      event
    ) => {

      if (
        !desktopQuery.matches ||
        reducedMotionQuery.matches
      ) {
        return;
      }


      const rect =
        section.getBoundingClientRect();


      targetPointerX =
        clamp(
          (
            (
              event.clientX -
              rect.left
            ) /
            rect.width -
            0.5
          ) *
          2,
          -1,
          1
        );


      targetPointerY =
        clamp(
          (
            (
              event.clientY -
              rect.top
            ) /
            rect.height -
            0.5
          ) *
          2,
          -1,
          1
        );

    };


    const resetPointer = () => {

      targetPointerX =
        0;

      targetPointerY =
        0;

    };


    /* ==========================================================
       ORGANIC MOTION
       ========================================================== */

    const getOrganic = (
      time,
      config
    ) => {

      const t =
        time *
        config.frequency;


      const a =
        Math.sin(
          t +
          config.phase
        );


      const b =
        Math.sin(
          (
            t *
            1.61
          ) +
          (
            config.phase *
            1.7
          )
        );


      const c =
        Math.cos(
          (
            t *
            0.63
          ) +
          (
            config.phase *
            0.77
          )
        );


      return {

        x:
          (
            (
              a *
              0.52
            ) +
            (
              b *
              0.31
            ) +
            (
              c *
              0.17
            )
          ) *
          config.floatX,


        y:
          (
            (
              a *
              0.27
            ) +
            (
              b *
              0.48
            ) +
            (
              c *
              0.25
            )
          ) *
          config.floatY

      };

    };


    /* ==========================================================
       BACKGROUND PARTICLE RENDER
       ========================================================== */

    const renderParticle = (
      name,
      config,
      time
    ) => {

      const organic =
        getOrganic(
          time,
          config
        );


      const x =
        (
          pointerX *
          config.pointerX
        ) +
        organic.x;


      const y =
        (
          scroll *
          config.scrollY
        ) +
        (
          pointerY *
          config.pointerY
        ) +
        organic.y;


      const rotation =
        Math.sin(
          (
            time *
            config.frequency *
            0.7
          ) +
          config.phase
        ) *
        config.rotation;


      section.style.setProperty(
        `--g4u-${name}-x`,
        `${x.toFixed(2)}px`
      );


      section.style.setProperty(
        `--g4u-${name}-y`,
        `${y.toFixed(2)}px`
      );


      section.style.setProperty(
        `--g4u-${name}-rotate`,
        `${rotation.toFixed(3)}deg`
      );

    };


    /* ==========================================================
       PRODUCT RENDER
       ========================================================== */

    const renderProduct = (
      name,
      config,
      time
    ) => {

      const organic =
        getOrganic(
          time,
          config
        );


      const far =
        1 -
        approach;


      /* ========================================================
         GROUPED ENTRY

         Sólo unos pocos pixels de separación.
         ======================================================== */

      const approachX =
        config.farX *
        far;


      const approachY =
        config.farY *
        far;


      /* ========================================================
         INERTIA

         Muy pequeña.
         ======================================================== */

      const inertiaY =
        Math.sin(
          (
            time *
            0.001
          ) +
          config.phase
        ) *
        config.energy *
        energy;


      /* ========================================================
         X
         ======================================================== */

      const x =
        (
          pointerX *
          config.pointerX
        ) +
        organic.x +
        approachX;


      /* ========================================================
         Y
         ======================================================== */

      const y =
        (
          scroll *
          config.scrollY
        ) +
        (
          pointerY *
          config.pointerY
        ) +
        organic.y +
        approachY +
        inertiaY;


      /* ========================================================
         SCALE / DEPTH

         Lejos:
         89-91%.

         Cerca:
         100%.

         Durante el recorrido:
         micro expansión adicional.
         ======================================================== */

      const baseScale =
        lerp(
          config.farScale,
          config.nearScale,
          approach
        );


      const pulse =
        Math.sin(
          approach *
          Math.PI
        ) *
        config.scalePulse;


      const scale =
        baseScale +
        pulse;


      /* ========================================================
         ROTATION Z
         ======================================================== */

      const organicRotation =
        Math.sin(
          (
            time *
            config.frequency *
            0.82
          ) +
          config.phase
        ) *
        0.06;


      const rotateZ =
        (
          pointerX *
          config.rotation
        ) +
        organicRotation;


      /* ========================================================
         SUBTLE 3D TILT
         ======================================================== */

      const rotateX =
        (
          config.farTiltX *
          far
        ) -
        (
          pointerY *
          config.pointerTilt
        );


      const rotateY =
        (
          config.farTiltY *
          far
        ) +
        (
          pointerX *
          config.pointerTilt
        );


      section.style.setProperty(
        `--g4u-${name}-x`,
        `${x.toFixed(2)}px`
      );


      section.style.setProperty(
        `--g4u-${name}-y`,
        `${y.toFixed(2)}px`
      );


      section.style.setProperty(
        `--g4u-${name}-scale`,
        scale.toFixed(4)
      );


      section.style.setProperty(
        `--g4u-${name}-rz`,
        `${rotateZ.toFixed(3)}deg`
      );


      section.style.setProperty(
        `--g4u-${name}-rx`,
        `${rotateX.toFixed(3)}deg`
      );


      section.style.setProperty(
        `--g4u-${name}-ry`,
        `${rotateY.toFixed(3)}deg`
      );

    };


    /* ==========================================================
       RENDER LOOP
       ========================================================== */

    const render = (
      time
    ) => {

      if (
        reducedMotionQuery.matches
      ) {

        requestAnimationFrame(
          render
        );

        return;

      }


      /* ========================================================
         DAMPING
         ======================================================== */

      pointerX =
        lerp(
          pointerX,
          targetPointerX,
          desktopQuery.matches
            ? 0.075
            : 0.05
        );


      pointerY =
        lerp(
          pointerY,
          targetPointerY,
          desktopQuery.matches
            ? 0.075
            : 0.05
        );


      scroll =
        lerp(
          scroll,
          targetScroll,
          desktopQuery.matches
            ? 0.065
            : 0.055
        );


      /*
       * Depth deliberadamente más pesado.
       */
      approach =
        lerp(
          approach,
          targetApproach,
          desktopQuery.matches
            ? 0.045
            : 0.038
        );


      energy =
        lerp(
          energy,
          targetEnergy,
          0.09
        );


      targetEnergy *=
        0.945;


      if (
        targetEnergy <
        0.001
      ) {

        targetEnergy =
          0;

      }


      /* ========================================================
         VISIBLE ONLY
         ======================================================== */

      if (isVisible) {

        const layers =
          getLayers();


        renderParticle(
          'dust',
          layers.dust,
          time
        );


        renderParticle(
          'texture',
          layers.texture,
          time
        );


        renderProduct(
          'snack',
          layers.snack,
          time
        );


        renderProduct(
          'bread',
          layers.bread,
          time
        );


        renderProduct(
          'tortilla',
          layers.tortilla,
          time
        );

      }


      requestAnimationFrame(
        render
      );

    };


    /* ==========================================================
       OBSERVER
       ========================================================== */

    if (
      'IntersectionObserver' in window
    ) {

      const observer =
        new IntersectionObserver(
          (entries) => {

            entries.forEach(
              (entry) => {

                isVisible =
                  entry.isIntersecting;


                if (
                  isVisible
                ) {

                  previousScrollY =
                    window.scrollY;


                  previousScrollTime =
                    performance.now();


                  updateScrollTarget();

                }

              }
            );

          },
          {
            rootMargin:
              '25% 0px 25% 0px'
          }
        );


      observer.observe(
        section
      );

    }


    /* ==========================================================
       EVENTS
       ========================================================== */

    window.addEventListener(
      'scroll',
      updateScrollTarget,
      {
        passive:
          true
      }
    );


    window.addEventListener(
      'resize',
      () => {

        resetPointer();


        previousScrollY =
          window.scrollY;


        previousScrollTime =
          performance.now();


        updateScrollTarget();

      },
      {
        passive:
          true
      }
    );


    section.addEventListener(
      'pointermove',
      updatePointer,
      {
        passive:
          true
      }
    );


    section.addEventListener(
      'pointerleave',
      resetPointer,
      {
        passive:
          true
      }
    );


    desktopQuery.addEventListener?.(
      'change',
      () => {

        resetPointer();

        updateScrollTarget();

      }
    );


    /* ==========================================================
       INIT
       ========================================================== */

    updateScrollTarget();


    requestAnimationFrame(
      render
    );

  })();
</script>


