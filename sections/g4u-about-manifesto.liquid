<section
  class="g4u-about-manifesto"
  id="G4uAboutManifesto-{{ section.id }}"
  aria-labelledby="G4uAboutManifestoTitle-{{ section.id }}"
  data-g4u-manifesto-parallax
>
  <div class="g4u-about-manifesto__copy">
   <h2
  class="g4u-about-manifesto__title g4u-display g4u-manifesto-reveal"
  id="G4uAboutManifestoTitle-{{ section.id }}"
>
  <span class="g4u-manifesto-line" style="--i: 0">
    <span class="g4u-manifesto-line__inner">
      Creemos en la <em>nutrición inteligente,</em>
    </span>
  </span>

  <span class="g4u-manifesto-line" style="--i: 1">
    <span class="g4u-manifesto-line__inner">
      la que combina <strong>ciencia, sabor</strong>
    </span>
  </span>

  <span class="g4u-manifesto-line" style="--i: 2">
    <span class="g4u-manifesto-line__inner">
      y <strong>bienestar</strong> real.
    </span>
  </span>

  <span class="g4u-manifesto-line" style="--i: 3">
    <span class="g4u-manifesto-line__inner">
      En los alimentos que
    </span>
  </span>

  <span class="g4u-manifesto-line" style="--i: 4">
    <span class="g4u-manifesto-line__inner">
      no prometen magia,
    </span>
  </span>

  <span class="g4u-manifesto-line" style="--i: 5">
    <span class="g4u-manifesto-line__inner">
      sino <em>resultados</em> auténticos.
    </span>
  </span>

  <span class="g4u-manifesto-line" style="--i: 6">
    <span class="g4u-manifesto-line__inner">
      Creemos en la <strong>transparencia,</strong>
    </span>
  </span>

  <span class="g4u-manifesto-line" style="--i: 7">
    <span class="g4u-manifesto-line__inner">
      en los <em>ingredientes limpios</em>
    </span>
  </span>

  <span class="g4u-manifesto-line" style="--i: 8">
    <span class="g4u-manifesto-line__inner">
      y en las <strong>decisiones conscientes.</strong>
    </span>
  </span>

  <span class="g4u-manifesto-line" style="--i: 9">
    <span class="g4u-manifesto-line__inner">
      Creemos que lo <em>saludable</em>
    </span>
  </span>

  <span class="g4u-manifesto-line" style="--i: 10">
    <span class="g4u-manifesto-line__inner">
      no tiene que ser aburrido.
    </span>
  </span>
</h2>

    <div class="g4u-about-manifesto__closing g4u-display">
      <p>{{ section.settings.closing | escape | newline_to_br }}</p>
      <p>{{ section.settings.closing_accent | escape | newline_to_br }}</p>
    </div>
  </div>


  <div
    class="g4u-about-manifesto__art"
    aria-hidden="true"
  >

    {%- if section.settings.particles_image_1 != blank -%}
      {{
        section.settings.particles_image_1
        | image_url: width: 1800
        | image_tag:
          class: 'g4u-about-manifesto__particles g4u-about-manifesto__particles--one',
          loading: 'lazy'
      }}
    {%- endif -%}


    {%- if section.settings.particles_image_2 != blank -%}
      {{
        section.settings.particles_image_2
        | image_url: width: 1800
        | image_tag:
          class: 'g4u-about-manifesto__particles g4u-about-manifesto__particles--two',
          loading: 'lazy'
      }}
    {%- endif -%}


    {%- if section.settings.snack_image != blank -%}
      {{
        section.settings.snack_image
        | image_url: width: 1400
        | image_tag:
          class: 'g4u-about-manifesto__object g4u-about-manifesto__object--snack',
          loading: 'lazy'
      }}
    {%- endif -%}


    {%- if section.settings.bread_image != blank -%}
      {{
        section.settings.bread_image
        | image_url: width: 1800
        | image_tag:
          class: 'g4u-about-manifesto__object g4u-about-manifesto__object--bread',
          loading: 'lazy'
      }}
    {%- endif -%}


    {%- if section.settings.tortilla_image != blank -%}
      {{
        section.settings.tortilla_image
        | image_url: width: 1400
        | image_tag:
          class: 'g4u-about-manifesto__object g4u-about-manifesto__object--tortilla',
          loading: 'lazy'
      }}
    {%- endif -%}

  </div>
</section>


<style>
  /* ============================================================
     G4U · MANIFIESTO
     INDEPENDENT CINEMATIC PARALLAX V4

     DESKTOP:
     se mantiene el comportamiento aprobado.

     MOBILE:
     - tortilla más separada del pan central
     - entrada inferior más marcada
     - más recorrido vertical
     - damping ligeramente más reactivo
     ============================================================ */


  /* ============================================================
     ROOT
     ============================================================ */

  .section-g4u-about-manifesto {
    background:
      #500322 !important;

    background-color:
      #500322 !important;

    background-image:
      none !important;

    overflow:
      hidden;
  }


  #G4uAboutManifesto-{{ section.id }} {
    position:
      relative;

    background:
      #500322 !important;

    background-color:
      #500322 !important;

    background-image:
      none !important;

    overflow:
      hidden;

    isolation:
      isolate;
  }


  #G4uAboutManifesto-{{ section.id }}::before,
  #G4uAboutManifesto-{{ section.id }}::after {
    content:
      none !important;

    display:
      none !important;

    background:
      none !important;
  }


  /* ============================================================
     COPY
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__copy {
    position:
      relative;

    z-index:
      10;
  }


  /* ============================================================
     ART
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__art {
    position:
      relative;

    background:
      #500322 !important;

    background-color:
      #500322 !important;

    background-image:
      none !important;

    overflow:
      hidden;

    isolation:
      isolate;

    contain:
      paint;
  }


  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__art::before,

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__art::after {
    content:
      none !important;

    display:
      none !important;
  }


  /* ============================================================
     PARTICLES
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__particles {
    position:
      absolute !important;

    z-index:
      1 !important;

    pointer-events:
      none;

    user-select:
      none;

    background:
      transparent !important;

    background-color:
      transparent !important;

    background-image:
      none !important;

    mix-blend-mode:
      screen !important;

    backface-visibility:
      hidden;

    transform-origin:
      center center;

    max-width:
      none !important;

    will-change:
      transform;
  }


  /* ============================================================
     PARTICLES ONE
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__particles--one {
    inset:
      -7% !important;

    width:
      114% !important;

    height:
      114% !important;

    object-fit:
      cover;

    object-position:
      center center;

    opacity:
      {{ section.settings.particles_1_opacity | divided_by: 100.0 }};

    transform:
      translate3d(
        var(--g4u-particles-one-x, 0px),
        var(--g4u-particles-one-y, 0px),
        0
      )
      rotate(
        var(--g4u-particles-one-r, 0deg)
      )
      scale(1.04);
  }


  /* ============================================================
     PARTICLES TWO
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__particles--two {
    inset:
      -9% !important;

    width:
      118% !important;

    height:
      118% !important;

    object-fit:
      cover;

    object-position:
      center center;

    opacity:
      {{ section.settings.particles_2_opacity | divided_by: 100.0 }};

    transform:
      translate3d(
        var(--g4u-particles-two-x, 0px),
        var(--g4u-particles-two-y, 0px),
        0
      )
      rotate(
        var(--g4u-particles-two-r, 0deg)
      )
      scale(1.05);
  }


  /* ============================================================
     PRODUCTS COMMON
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__object {
    position:
      absolute;

    pointer-events:
      none;

    user-select:
      none;

    background:
      transparent !important;

    background-color:
      transparent !important;

    background-image:
      none !important;

    mix-blend-mode:
      normal !important;

    filter:
      none !important;

    opacity:
      1 !important;

    transform-origin:
      center center;

    backface-visibility:
      hidden;

    will-change:
      transform;
  }


  /* ============================================================
     SNACK
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__object--snack {
    z-index:
      4 !important;

    transform:
      perspective(1400px)

      translate3d(
        var(--g4u-snack-x, 0px),
        var(--g4u-snack-y, 0px),
        0
      )

      rotate(
        var(--g4u-snack-rz, 0deg)
      )

      rotateX(
        var(--g4u-snack-rx, 0deg)
      )

      rotateY(
        var(--g4u-snack-ry, 0deg)
      )

      scale(
        var(--g4u-snack-scale, 1)
      );
  }


  /* ============================================================
     BREAD
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__object--bread {
    z-index:
      5 !important;

    transform:
      perspective(1500px)

      translate3d(
        var(--g4u-bread-x, 0px),
        var(--g4u-bread-y, 0px),
        0
      )

      rotate(
        var(--g4u-bread-rz, 0deg)
      )

      rotateX(
        var(--g4u-bread-rx, 0deg)
      )

      rotateY(
        var(--g4u-bread-ry, 0deg)
      )

      scale(
        var(--g4u-bread-scale, 1)
      );
  }


  /* ============================================================
     TORTILLA
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__object--tortilla {
    z-index:
      4 !important;

    transform:
      perspective(1400px)

      translate3d(
        var(--g4u-tortilla-x, 0px),
        var(--g4u-tortilla-y, 0px),
        0
      )

      rotate(
        var(--g4u-tortilla-rz, 0deg)
      )

      rotateX(
        var(--g4u-tortilla-rx, 0deg)
      )

      rotateY(
        var(--g4u-tortilla-ry, 0deg)
      )

      scale(
        var(--g4u-tortilla-scale, 1)
      );
  }


  /* ============================================================
     MOBILE
     ============================================================ */

  @media screen and (max-width: 989px) {

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--snack {
      margin-left:
        -5px;

      margin-top:
        -28px;
    }


    /*
     * Pan central:
     * queda como ancla visual.
     */
    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--bread {
      margin-left:
        4px;

      margin-top:
        0px;
    }


    /*
     * Tortilla:
     * antes estaba en +32px.
     *
     * Ahora queda bastante más abajo,
     * dando aire entre los productos.
     */
    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--tortilla {
      margin-left:
        -9px;

      margin-top:
        58px;
    }

  }


  /* ============================================================
     MOBILE EXTRA SMALL
     ============================================================ */

  @media screen and (max-width: 480px) {

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--snack {
      margin-left:
        -7px;

      margin-top:
        -34px;
    }


    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--bread {
      margin-left:
        3px;

      margin-top:
        0px;
    }


    /*
     * Más separación todavía en celulares angostos.
     */
    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--tortilla {
      margin-left:
        -9px;

      margin-top:
        68px;
    }

  }


  /* ============================================================
     REDUCED MOTION
     ============================================================ */

  @media (
    prefers-reduced-motion: reduce
  ) {

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__particles,

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object {
      transform:
        none !important;
    }

  }
</style>


<script>
  (() => {

    const section =
      document.querySelector(
        '#G4uAboutManifesto-{{ section.id }}'
      );


    if (!section) {
      return;
    }


    /* ==========================================================
       PREVENT DOUBLE INIT
       ========================================================== */

    if (
      section.dataset
        .g4uIndependentParallaxV4 ===
      'true'
    ) {
      return;
    }


    section.dataset
      .g4uIndependentParallaxV4 =
      'true';


    /* ==========================================================
       MEDIA
       ========================================================== */

    const desktopQuery =
      window.matchMedia(
        '(min-width: 990px)'
      );


    const reducedMotionQuery =
      window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      );


    /* ==========================================================
       DESKTOP PRODUCTS

       NO CAMBIAR.
       Este es el comportamiento aprobado.
       ========================================================== */

    const desktopProducts = {


      /* ========================================================
         SNACK
         FROM TOP-LEFT
         ======================================================== */

      snack: {

        entryX:
          -145,

        entryY:
          -115,


        scrollX:
          18,

        scrollY:
          -72,


        mouseX:
          18,

        mouseY:
          13,


        floatX:
          3.3,

        floatY:
          4.2,


        frequency:
          0.00050,

        phase:
          1.1,


        startScale:
          0.68,

        finalScale:
          1,


        displayScale:
          {{ section.settings.snack_size_desktop_v2 | divided_by: 100.0 }},


        scalePulse:
          0.032,


        startRotate:
          -7.5,


        tiltX:
          1.4,

        tiltY:
          -2.0,


        pointerTilt:
          0.38
      },


      /* ========================================================
         BREAD
         FROM TOP-RIGHT
         ======================================================== */

      bread: {

        entryX:
          165,

        entryY:
          -96,


        scrollX:
          -15,

        scrollY:
          -52,


        mouseX:
          10,

        mouseY:
          7,


        floatX:
          2.4,

        floatY:
          3.1,


        frequency:
          0.00036,

        phase:
          3.7,


        startScale:
          0.70,

        finalScale:
          1,


        displayScale:
          {{ section.settings.bread_size_desktop_v2 | divided_by: 100.0 }},


        scalePulse:
          0.025,


        startRotate:
          5,


        tiltX:
          -0.95,

        tiltY:
          1.4,


        pointerTilt:
          0.27
      },


      /* ========================================================
         TORTILLA
         FROM BOTTOM-LEFT
         ======================================================== */

      tortilla: {

        entryX:
          -135,

        entryY:
          140,


        scrollX:
          14,

        scrollY:
          -62,


        mouseX:
          -11,

        mouseY:
          -8,


        floatX:
          2.8,

        floatY:
          3.6,


        frequency:
          0.00044,

        phase:
          5.0,


        startScale:
          0.69,

        finalScale:
          1,


        displayScale:
          {{ section.settings.tortilla_size_desktop_v2 | divided_by: 100.0 }},


        scalePulse:
          0.028,


        startRotate:
          -5,


        tiltX:
          1.1,

        tiltY:
          -1.35,


        pointerTilt:
          0.30
      }

    };


    /* ==========================================================
       MOBILE PRODUCTS

       Acá sí hacemos el refinement.
       ========================================================== */

    const mobileProducts = {


      /* ========================================================
         SNACK MOBILE
         ======================================================== */

      snack: {

        entryX:
          -58,

        entryY:
          -50,


        scrollX:
          8,

        scrollY:
          -38,


        mouseX:
          0,

        mouseY:
          0,


        floatX:
          1.7,

        floatY:
          2.3,


        frequency:
          0.00050,

        phase:
          1.1,


        startScale:
          0.84,

        finalScale:
          1,


        displayScale:
          {{ section.settings.snack_size_mobile_v2 | divided_by: 100.0 }},


        scalePulse:
          0.014,


        startRotate:
          -3,


        tiltX:
          0.40,

        tiltY:
          -0.55,


        pointerTilt:
          0
      },


      /* ========================================================
         BREAD MOBILE

         Se mantiene más pesado y estable.
         ======================================================== */

      bread: {

        entryX:
          68,

        entryY:
          -44,


        scrollX:
          -6,

        scrollY:
          -27,


        mouseX:
          0,

        mouseY:
          0,


        floatX:
          1.4,

        floatY:
          1.8,


        frequency:
          0.00036,

        phase:
          3.7,


        startScale:
          0.86,

        finalScale:
          1,


        displayScale:
          {{ section.settings.bread_size_mobile_v2 | divided_by: 100.0 }},


        scalePulse:
          0.011,


        startRotate:
          2.2,


        tiltX:
          -0.28,

        tiltY:
          0.38,


        pointerTilt:
          0
      },


      /* ========================================================
         TORTILLA MOBILE

         Mejorada:
         - más abajo
         - empieza más lejos
         - más desplazamiento vertical
         - más profundidad
         - más independiente del bread
         ======================================================== */

      tortilla: {

        /*
         * Antes:
         * -56
         *
         * Ahora abre un poco más hacia la izquierda.
         */
        entryX:
          -62,


        /*
         * Antes:
         * 62
         *
         * Ahora:
         * 92
         *
         * Entra claramente desde abajo.
         */
        entryY:
          92,


        scrollX:
          8,


        /*
         * Antes:
         * -33
         *
         * Ahora:
         * -44
         *
         * Más diferencia de velocidad
         * respecto al pan central.
         */
        scrollY:
          -44,


        mouseX:
          0,

        mouseY:
          0,


        /*
         * Más flotación orgánica,
         * pero sin llegar al nivel desktop.
         */
        floatX:
          1.7,

        floatY:
          2.3,


        frequency:
          0.00044,

        phase:
          5.0,


        /*
         * Antes:
         * 0.85
         *
         * Arranca un poco más lejos.
         */
        startScale:
          0.81,


        finalScale:
          1,


        displayScale:
          {{ section.settings.tortilla_size_mobile_v2 | divided_by: 100.0 }},


        /*
         * Un poco más de respiración durante el approach.
         */
        scalePulse:
          0.015,


        /*
         * Rotación inicial ligeramente mayor.
         */
        startRotate:
          -3.2,


        tiltX:
          0.42,

        tiltY:
          -0.52,


        pointerTilt:
          0
      }

    };


    /* ==========================================================
       PARTICLES DESKTOP
       ========================================================== */

    const desktopParticles = {

      one: {

        scrollY:
          20,

        mouseX:
          -3,

        mouseY:
          -2,


        floatX:
          1.5,

        floatY:
          2,


        frequency:
          0.00021,

        phase:
          0.4,


        rotate:
          0.025
      },


      two: {

        scrollY:
          -25,

        mouseX:
          2.5,

        mouseY:
          1.8,


        floatX:
          1.8,

        floatY:
          2.4,


        frequency:
          0.00018,

        phase:
          2.5,


        rotate:
          -0.021
      }

    };


    /* ==========================================================
       PARTICLES MOBILE
       ========================================================== */

    const mobileParticles = {

      one: {

        scrollY:
          10,

        mouseX:
          0,

        mouseY:
          0,


        floatX:
          0.8,

        floatY:
          1.1,


        frequency:
          0.00021,

        phase:
          0.4,


        rotate:
          0.012
      },


      two: {

        scrollY:
          -13,

        mouseX:
          0,

        mouseY:
          0,


        floatX:
          0.9,

        floatY:
          1.3,


        frequency:
          0.00018,

        phase:
          2.5,


        rotate:
          -0.010
      }

    };


    /* ==========================================================
       STATE
       ========================================================== */

    let targetPointerX =
      0;

    let targetPointerY =
      0;


    let pointerX =
      0;

    let pointerY =
      0;


    let targetScroll =
      0;

    let currentScroll =
      0;


    let targetApproach =
      0;

    let currentApproach =
      0;


    let visible =
      true;


    /* ==========================================================
       HELPERS
       ========================================================== */

    const clamp = (
      value,
      min,
      max
    ) => {

      return Math.min(
        Math.max(
          value,
          min
        ),
        max
      );

    };


    const lerp = (
      current,
      target,
      amount
    ) => {

      return (
        current +
        (
          target -
          current
        ) *
        amount
      );

    };


    const smoothstep = (
      value
    ) => {

      const x =
        clamp(
          value,
          0,
          1
        );


      return (
        x *
        x *
        (
          3 -
          (
            2 *
            x
          )
        )
      );

    };


    /* ==========================================================
       CONFIG
       ========================================================== */

    const getProducts = () => {

      return desktopQuery.matches
        ? desktopProducts
        : mobileProducts;

    };


    const getParticles = () => {

      return desktopQuery.matches
        ? desktopParticles
        : mobileParticles;

    };


    /* ==========================================================
       SCROLL
       ========================================================== */

    const updateScroll = () => {

      if (
        reducedMotionQuery.matches
      ) {
        return;
      }


      const rect =
        section.getBoundingClientRect();


      const viewportHeight =
        window.innerHeight;


      /* ========================================================
         FULL PARALLAX PROGRESS
         ======================================================== */

      const sectionCenter =
        rect.top +
        (
          rect.height /
          2
        );


      const viewportCenter =
        viewportHeight /
        2;


      const travelRange =
        (
          viewportHeight +
          rect.height
        ) /
        2;


      targetScroll =
        clamp(
          (
            viewportCenter -
            sectionCenter
          ) /
          travelRange,
          -1,
          1
        );


      /* ========================================================
         APPROACH
         ======================================================== */

      const start =
        viewportHeight *
        1.25;


      const end =
        viewportHeight *
        -0.02;


      const raw =
        clamp(
          (
            start -
            rect.top
          ) /
          (
            start -
            end
          ),
          0,
          1
        );


      targetApproach =
        smoothstep(
          raw
        );

    };


    /* ==========================================================
       POINTER
       ========================================================== */

    const updatePointer = (
      event
    ) => {

      if (
        !desktopQuery.matches ||
        reducedMotionQuery.matches
      ) {
        return;
      }


      const rect =
        section.getBoundingClientRect();


      targetPointerX =
        clamp(
          (
            (
              event.clientX -
              rect.left
            ) /
            rect.width -
            0.5
          ) *
          2,
          -1,
          1
        );


      targetPointerY =
        clamp(
          (
            (
              event.clientY -
              rect.top
            ) /
            rect.height -
            0.5
          ) *
          2,
          -1,
          1
        );

    };


    const resetPointer = () => {

      targetPointerX =
        0;

      targetPointerY =
        0;

    };


    /* ==========================================================
       ORGANIC MOTION
       ========================================================== */

    const getOrganic = (
      time,
      config
    ) => {

      const t =
        time *
        config.frequency;


      const waveA =
        Math.sin(
          t +
          config.phase
        );


      const waveB =
        Math.sin(
          (
            t *
            1.67
          ) +
          (
            config.phase *
            1.8
          )
        );


      const waveC =
        Math.cos(
          (
            t *
            0.63
          ) +
          (
            config.phase *
            0.75
          )
        );


      return {

        x:
          (
            (
              waveA *
              0.52
            ) +
            (
              waveB *
              0.31
            ) +
            (
              waveC *
              0.17
            )
          ) *
          config.floatX,


        y:
          (
            (
              waveA *
              0.27
            ) +
            (
              waveB *
              0.48
            ) +
            (
              waveC *
              0.25
            )
          ) *
          config.floatY

      };

    };


    /* ==========================================================
       PARTICLES RENDER
       ========================================================== */

    const renderParticle = (
      key,
      config,
      time
    ) => {

      const organic =
        getOrganic(
          time,
          config
        );


      const x =
        (
          pointerX *
          config.mouseX
        ) +
        organic.x;


      const y =
        (
          currentScroll *
          config.scrollY
        ) +
        (
          pointerY *
          config.mouseY
        ) +
        organic.y;


      const rotation =
        Math.sin(
          (
            time *
            config.frequency *
            0.75
          ) +
          config.phase
        ) *
        config.rotate;


      section.style.setProperty(
        `--g4u-particles-${key}-x`,
        `${x.toFixed(2)}px`
      );


      section.style.setProperty(
        `--g4u-particles-${key}-y`,
        `${y.toFixed(2)}px`
      );


      section.style.setProperty(
        `--g4u-particles-${key}-r`,
        `${rotation.toFixed(3)}deg`
      );

    };


    /* ==========================================================
       PRODUCT RENDER
       ========================================================== */

    const renderProduct = (
      name,
      config,
      time
    ) => {

      const organic =
        getOrganic(
          time,
          config
        );


      /*
       * 1 = entry
       * 0 = final composition
       */
      const far =
        1 -
        currentApproach;


      /* ========================================================
         ENTRY VECTOR
         ======================================================== */

      const entryX =
        config.entryX *
        far;


      const entryY =
        config.entryY *
        far;


      /* ========================================================
         X
         ======================================================== */

      const x =
        entryX +

        (
          currentScroll *
          config.scrollX
        ) +

        (
          pointerX *
          config.mouseX
        ) +

        organic.x;


      /* ========================================================
         Y
         ======================================================== */

      const y =
        entryY +

        (
          currentScroll *
          config.scrollY
        ) +

        (
          pointerY *
          config.mouseY
        ) +

        organic.y;


      /* ========================================================
         SCALE
         ======================================================== */

      const baseScale =
        lerp(
          config.startScale,
          config.finalScale,
          currentApproach
        );


      const pulse =
        Math.sin(
          currentApproach *
          Math.PI
        ) *
        config.scalePulse;


      const scale =
        (
          baseScale +
          pulse
        ) *
        config.displayScale;


      /* ========================================================
         ROTATE Z
         ======================================================== */

      const entryRotation =
        config.startRotate *
        far;


      const organicRotation =
        Math.sin(
          (
            time *
            config.frequency *
            0.80
          ) +
          config.phase
        ) *
        0.085;


      const rotateZ =
        entryRotation +
        organicRotation;


      /* ========================================================
         3D TILT
         ======================================================== */

      const rotateX =
        (
          config.tiltX *
          far
        ) -
        (
          pointerY *
          config.pointerTilt
        );


      const rotateY =
        (
          config.tiltY *
          far
        ) +
        (
          pointerX *
          config.pointerTilt
        );


      /* ========================================================
         WRITE
         ======================================================== */

      section.style.setProperty(
        `--g4u-${name}-x`,
        `${x.toFixed(2)}px`
      );


      section.style.setProperty(
        `--g4u-${name}-y`,
        `${y.toFixed(2)}px`
      );


      section.style.setProperty(
        `--g4u-${name}-scale`,
        scale.toFixed(4)
      );


      section.style.setProperty(
        `--g4u-${name}-rz`,
        `${rotateZ.toFixed(3)}deg`
      );


      section.style.setProperty(
        `--g4u-${name}-rx`,
        `${rotateX.toFixed(3)}deg`
      );


      section.style.setProperty(
        `--g4u-${name}-ry`,
        `${rotateY.toFixed(3)}deg`
      );

    };


    /* ==========================================================
       LOOP
       ========================================================== */

    const render = (
      time
    ) => {

      if (
        reducedMotionQuery.matches
      ) {

        requestAnimationFrame(
          render
        );

        return;

      }


      /* ========================================================
         POINTER DAMPING
         ======================================================== */

      pointerX =
        lerp(
          pointerX,
          targetPointerX,
          desktopQuery.matches
            ? 0.09
            : 0.05
        );


      pointerY =
        lerp(
          pointerY,
          targetPointerY,
          desktopQuery.matches
            ? 0.09
            : 0.05
        );


      /* ========================================================
         SCROLL DAMPING

         Desktop queda igual.

         Mobile pasa:
         0.060 → 0.068

         Se percibe un poco mejor el parallax
         sin producir un movimiento seco.
         ======================================================== */

      currentScroll =
        lerp(
          currentScroll,
          targetScroll,
          desktopQuery.matches
            ? 0.080
            : 0.068
        );


      /* ========================================================
         APPROACH DAMPING

         Desktop:
         idéntico.

         Mobile:
         0.038 → 0.043
         ======================================================== */

      currentApproach =
        lerp(
          currentApproach,
          targetApproach,
          desktopQuery.matches
            ? 0.046
            : 0.043
        );


      /* ========================================================
         DRAW
         ======================================================== */

      if (visible) {

        const particles =
          getParticles();


        const products =
          getProducts();


        renderParticle(
          'one',
          particles.one,
          time
        );


        renderParticle(
          'two',
          particles.two,
          time
        );


        renderProduct(
          'snack',
          products.snack,
          time
        );


        renderProduct(
          'bread',
          products.bread,
          time
        );


        renderProduct(
          'tortilla',
          products.tortilla,
          time
        );

      }


      requestAnimationFrame(
        render
      );

    };


    /* ==========================================================
       OBSERVER
       ========================================================== */

    if (
      'IntersectionObserver' in window
    ) {

      const observer =
        new IntersectionObserver(
          (entries) => {

            entries.forEach(
              (entry) => {

                visible =
                  entry.isIntersecting;


                if (visible) {

                  updateScroll();

                }

              }
            );

          },
          {
            rootMargin:
              '35% 0px 35% 0px'
          }
        );


      observer.observe(
        section
      );

    }


    /* ==========================================================
       EVENTS
       ========================================================== */

    window.addEventListener(
      'scroll',
      updateScroll,
      {
        passive:
          true
      }
    );


    window.addEventListener(
      'resize',
      () => {

        resetPointer();

        updateScroll();

      },
      {
        passive:
          true
      }
    );


    section.addEventListener(
      'pointermove',
      updatePointer,
      {
        passive:
          true
      }
    );


    section.addEventListener(
      'pointerleave',
      resetPointer,
      {
        passive:
          true
      }
    );


    desktopQuery.addEventListener?.(
      'change',
      () => {

        resetPointer();

        updateScroll();

      }
    );


    /* ==========================================================
       INIT
       ========================================================== */

    updateScroll();


    requestAnimationFrame(
      render
    );

  })();
</script>


