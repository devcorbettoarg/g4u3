<section
  class="g4u-about-manifesto"
  id="G4uAboutManifesto-{{ section.id }}"
  aria-labelledby="G4uAboutManifestoTitle-{{ section.id }}"
  data-g4u-manifesto-parallax
>
  <div class="g4u-about-manifesto__copy">
    <h2
      class="g4u-about-manifesto__title g4u-display"
      id="G4uAboutManifestoTitle-{{ section.id }}"
    >
      Creemos en la <em>nutrición inteligente,</em><br>
      la que combina <strong>ciencia, sabor</strong><br>
      y <strong>bienestar</strong> real.<br>
      En los alimentos que<br>
      no prometen magia,<br>
      sino <em>resultados</em> auténticos.<br>
      Creemos en la <strong>transparencia,</strong><br>
      en los <em>ingredientes limpios</em><br>
      y en las <strong>decisiones conscientes.</strong><br>
      Creemos que lo <em>saludable</em><br>
      no tiene que ser aburrido.
    </h2>

    <div class="g4u-about-manifesto__closing g4u-display">
      <p>{{ section.settings.closing | escape | newline_to_br }}</p>
      <p>{{ section.settings.closing_accent | escape | newline_to_br }}</p>
    </div>
  </div>

  <div class="g4u-about-manifesto__art" aria-hidden="true">

    {%- if section.settings.dust_image != blank -%}
      {{
        section.settings.dust_image
        | image_url: width: 1024
        | image_tag:
          class: 'g4u-about-manifesto__dust',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__dust"
        src="{{ 'g4u-about-manifesto-dust.png' | asset_url }}"
        alt=""
        width="1024"
        height="1536"
        loading="lazy"
      >
    {%- endif -%}

    {%- if section.settings.texture_image != blank -%}
      {{
        section.settings.texture_image
        | image_url: width: 1024
        | image_tag:
          class: 'g4u-about-manifesto__texture',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__texture"
        src="{{ 'g4u-about-manifesto-texture.png' | asset_url }}"
        alt=""
        width="1024"
        height="1535"
        loading="lazy"
      >
    {%- endif -%}

    {%- if section.settings.snack_image != blank -%}
      {{
        section.settings.snack_image
        | image_url: width: 456
        | image_tag:
          class: 'g4u-about-manifesto__object g4u-about-manifesto__object--snack',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__object g4u-about-manifesto__object--snack"
        src="{{ 'g4u-about-snack.png' | asset_url }}"
        alt=""
        width="456"
        height="458"
        loading="lazy"
      >
    {%- endif -%}

    {%- if section.settings.bread_image != blank -%}
      {{
        section.settings.bread_image
        | image_url: width: 866
        | image_tag:
          class: 'g4u-about-manifesto__object g4u-about-manifesto__object--bread',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__object g4u-about-manifesto__object--bread"
        src="{{ 'g4u-about-bread.png' | asset_url }}"
        alt=""
        width="866"
        height="926"
        loading="lazy"
      >
    {%- endif -%}

    {%- if section.settings.tortilla_image != blank -%}
      {{
        section.settings.tortilla_image
        | image_url: width: 490
        | image_tag:
          class: 'g4u-about-manifesto__object g4u-about-manifesto__object--tortilla',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__object g4u-about-manifesto__object--tortilla"
        src="{{ 'g4u-about-tortilla.png' | asset_url }}"
        alt=""
        width="490"
        height="449"
        loading="lazy"
      >
    {%- endif -%}

  </div>
</section>


<style>
  /* ============================================================
     G4U MANIFESTO
     ORGANIC PARALLAX — DESKTOP
     ============================================================ */

  @media screen and (min-width: 990px) {

    #G4uAboutManifesto-{{ section.id }} {
      position: relative;
    }


    /* ==========================================================
       ART CONTAINER
       ========================================================== */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__art {
      background: transparent !important;
    }


    /* ==========================================================
       PERFORMANCE
       ========================================================== */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__dust,

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__texture,

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object {
      will-change: translate, rotate;
      backface-visibility: hidden;
    }


    /* ==========================================================
       DUST
       ========================================================== */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__dust {
      mix-blend-mode: screen;

      translate:
        var(--g4u-dust-x, 0px)
        var(--g4u-dust-y, 0px);

      rotate:
        var(--g4u-dust-rotate, 0deg);
    }


    /* ==========================================================
       TEXTURE
       ========================================================== */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__texture {
      mix-blend-mode: screen;

      translate:
        var(--g4u-texture-x, 0px)
        var(--g4u-texture-y, 0px);

      rotate:
        var(--g4u-texture-rotate, 0deg);

      /*
       * Un poco de margen extra para que el movimiento
       * de la textura no revele bordes.
       */
      scale: 1.055;
    }


    /* ==========================================================
       SNACK
       ========================================================== */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--snack {
      translate:
        var(--g4u-snack-x, 0px)
        var(--g4u-snack-y, 0px);

      rotate:
        var(--g4u-snack-rotate, 0deg);
    }


    /* ==========================================================
       BREAD
       ========================================================== */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--bread {
      translate:
        var(--g4u-bread-x, 0px)
        var(--g4u-bread-y, 0px);

      rotate:
        var(--g4u-bread-rotate, 0deg);
    }


    /* ==========================================================
       TORTILLA
       ========================================================== */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--tortilla {
      translate:
        var(--g4u-tortilla-x, 0px)
        var(--g4u-tortilla-y, 0px);

      rotate:
        var(--g4u-tortilla-rotate, 0deg);
    }

  }


  /* ============================================================
     REDUCED MOTION
     ============================================================ */

  @media (prefers-reduced-motion: reduce) {

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__dust,

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__texture,

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object {
      translate: 0 0 !important;
      rotate: 0deg !important;
      scale: 1 !important;
    }

  }
</style>


<script>
  (() => {

    const section = document.querySelector(
      '#G4uAboutManifesto-{{ section.id }}'
    );

    if (!section) return;


    /* ==========================================================
       PREVENT DOUBLE INIT
       ========================================================== */

    if (
      section.dataset.g4uParallaxInitialized === 'true'
    ) {
      return;
    }

    section.dataset.g4uParallaxInitialized = 'true';


    /* ==========================================================
       MEDIA QUERIES
       ========================================================== */

    const desktopQuery = window.matchMedia(
      '(min-width: 990px)'
    );

    const reducedMotionQuery = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );


    /* ==========================================================
       LAYER CONFIGURATION

       Intensidad aumentada aprox. 15%.

       floatX / floatY:
       microflotación orgánica

       frequency:
       velocidad individual de flotación

       phase:
       cada elemento empieza en un punto diferente

       energy:
       cuánto reacciona a la aceleración del scroll
       ========================================================== */

    const layers = {

      dust: {
        scrollY: 21,
        mouseX: -4.5,
        mouseY: -4.5,

        floatX: 2.2,
        floatY: 3.2,

        frequency: 0.00032,
        phase: 0.7,

        energy: 3,
        rotate: 0.04
      },


      texture: {
        scrollY: -37,
        mouseX: 7,
        mouseY: 7,

        floatX: 3.5,
        floatY: 5,

        frequency: 0.00027,
        phase: 2.4,

        energy: 5,
        rotate: -0.06
      },


      snack: {
        scrollY: -67,
        mouseX: 18.5,
        mouseY: 14,

        floatX: 4.5,
        floatY: 6,

        frequency: 0.00055,
        phase: 1.2,

        energy: 9,
        rotate: 0.95
      },


      bread: {
        scrollY: -44,
        mouseX: 11.5,
        mouseY: 9,

        floatX: 3.5,
        floatY: 4.5,

        frequency: 0.00040,
        phase: 3.8,

        energy: 6,
        rotate: -0.42
      },


      tortilla: {
        scrollY: -55,
        mouseX: -12.5,
        mouseY: -9,

        floatX: 4,
        floatY: 5.5,

        frequency: 0.00048,
        phase: 5.1,

        energy: 7,
        rotate: -0.65
      }

    };


    /* ==========================================================
       STATE
       ========================================================== */

    let targetPointerX = 0;
    let targetPointerY = 0;

    let pointerX = 0;
    let pointerY = 0;

    let targetScrollProgress = 0;
    let scrollProgress = 0;


    /*
     * Energía generada cuando el usuario acelera el scroll.
     *
     * 0 = movimiento normal
     * 1 = pequeño impulso adicional
     */

    let targetEnergy = 0;
    let energy = 0;


    let previousScrollY = window.scrollY;
    let previousScrollTime = performance.now();

    let isVisible = true;


    /* ==========================================================
       HELPERS
       ========================================================== */

    const clamp = (
      value,
      min,
      max
    ) => {

      return Math.min(
        Math.max(value, min),
        max
      );

    };


    const lerp = (
      current,
      target,
      amount
    ) => {

      return current +
        (target - current) * amount;

    };


    const enabled = () => {

      return (
        desktopQuery.matches &&
        !reducedMotionQuery.matches
      );

    };


    /* ==========================================================
       SCROLL POSITION + VELOCITY
       ========================================================== */

    const updateScrollTarget = () => {

      if (!enabled()) return;


      const rect =
        section.getBoundingClientRect();


      const viewportHeight =
        window.innerHeight;


      const sectionCenter =
        rect.top +
        (rect.height / 2);


      const viewportCenter =
        viewportHeight / 2;


      const distance =
        viewportCenter -
        sectionCenter;


      const range =
        (
          viewportHeight +
          rect.height
        ) / 2;


      targetScrollProgress =
        clamp(
          distance / range,
          -1,
          1
        );


      /* ========================================================
         SCROLL VELOCITY

         Cuanto más rápido scrolleamos, más energía acumulamos.
         No afecta brutalmente al movimiento: sólo genera
         una pequeña aceleración / overshoot.
         ======================================================== */

      const now =
        performance.now();


      const currentScrollY =
        window.scrollY;


      const deltaY =
        currentScrollY -
        previousScrollY;


      const deltaTime =
        Math.max(
          now - previousScrollTime,
          16
        );


      const velocity =
        Math.abs(deltaY) /
        deltaTime;


      /*
       * Normalizamos la velocidad.
       *
       * Scroll tranquilo:
       * energy cerca de 0.
       *
       * Scroll rápido:
       * energy se aproxima a 1.
       */

      const velocityEnergy =
        clamp(
          velocity * 1.4,
          0,
          1
        );


      targetEnergy =
        Math.max(
          targetEnergy,
          velocityEnergy
        );


      previousScrollY =
        currentScrollY;


      previousScrollTime =
        now;

    };


    /* ==========================================================
       POINTER
       ========================================================== */

    const updatePointerTarget = (
      event
    ) => {

      if (!enabled()) return;


      const rect =
        section.getBoundingClientRect();


      const normalizedX =
        (
          event.clientX -
          rect.left
        ) /
        rect.width;


      const normalizedY =
        (
          event.clientY -
          rect.top
        ) /
        rect.height;


      targetPointerX =
        clamp(
          (normalizedX - 0.5) * 2,
          -1,
          1
        );


      targetPointerY =
        clamp(
          (normalizedY - 0.5) * 2,
          -1,
          1
        );

    };


    const resetPointer = () => {

      targetPointerX = 0;
      targetPointerY = 0;

    };


    /* ==========================================================
       ORGANIC MOTION

       En lugar de random frame a frame usamos varias ondas
       ligeramente desfasadas.

       Esto genera irregularidad aparente sin vibraciones.
       ========================================================== */

    const getOrganicMotion = (
      time,
      config
    ) => {

      const t =
        time * config.frequency;


      /*
       * Primera onda:
       * movimiento principal.
       */

      const waveA =
        Math.sin(
          t +
          config.phase
        );


      /*
       * Segunda onda:
       * frecuencia diferente para romper la regularidad.
       */

      const waveB =
        Math.sin(
          t * 1.73 +
          config.phase * 1.8
        );


      /*
       * Tercera onda todavía más lenta.
       */

      const waveC =
        Math.cos(
          t * 0.61 +
          config.phase * 0.73
        );


      /*
       * Combinación pseudoaleatoria suave.
       */

      const organicX =
        (
          waveA * 0.55 +
          waveB * 0.30 +
          waveC * 0.15
        ) *
        config.floatX;


      const organicY =
        (
          waveA * 0.25 +
          waveB * 0.50 +
          waveC * 0.25
        ) *
        config.floatY;


      return {
        x: organicX,
        y: organicY
      };

    };


    /* ==========================================================
       SET CSS VARIABLES
       ========================================================== */

    const setLayerVariables = (
      name,
      config,
      time
    ) => {


      const organic =
        getOrganicMotion(
          time,
          config
        );


      /*
       * El boost sólo aparece cuando hubo aceleración.
       *
       * No es una posición random:
       * aprovecha la onda orgánica para que el impulso tenga
       * una dirección coherente.
       */

      const accelerationX =
        organic.x *
        energy *
        0.65;


      const accelerationY =
        Math.sin(
          time * 0.001 +
          config.phase
        ) *
        config.energy *
        energy;


      const x =
        (
          pointerX *
          config.mouseX
        ) +
        organic.x +
        accelerationX;


      const y =
        (
          scrollProgress *
          config.scrollY
        ) +
        (
          pointerY *
          config.mouseY
        ) +
        organic.y +
        accelerationY;


      section.style.setProperty(
        `--g4u-${name}-x`,
        `${x.toFixed(2)}px`
      );


      section.style.setProperty(
        `--g4u-${name}-y`,
        `${y.toFixed(2)}px`
      );


      /*
       * La rotación también recibe una microvariación.
       */

      const organicRotation =
        Math.sin(
          time *
          config.frequency *
          0.85 +
          config.phase
        ) *
        Math.min(
          Math.abs(config.rotate) * 0.18,
          0.12
        );


      const rotation =
        (
          pointerX *
          config.rotate
        ) +
        organicRotation;


      section.style.setProperty(
        `--g4u-${name}-rotate`,
        `${rotation.toFixed(3)}deg`
      );

    };


    /* ==========================================================
       RESET
       ========================================================== */

    const resetStyles = () => {

      Object
        .keys(layers)
        .forEach((name) => {

          section.style.removeProperty(
            `--g4u-${name}-x`
          );

          section.style.removeProperty(
            `--g4u-${name}-y`
          );

          section.style.removeProperty(
            `--g4u-${name}-rotate`
          );

        });


      targetPointerX = 0;
      targetPointerY = 0;

      pointerX = 0;
      pointerY = 0;

      targetScrollProgress = 0;
      scrollProgress = 0;

      targetEnergy = 0;
      energy = 0;

    };


    /* ==========================================================
       ANIMATION LOOP
       ========================================================== */

    const render = (
      time
    ) => {

      if (!enabled()) {

        resetStyles();

        requestAnimationFrame(
          render
        );

        return;

      }


      /*
       * Pointer:
       * ligeramente más reactivo que antes.
       */

      const pointerEase =
        0.095;


      /*
       * Scroll:
       * un poco más pesado para que el cambio de velocidad
       * produzca una sensación de inercia.
       */

      const scrollEase =
        0.078;


      pointerX =
        lerp(
          pointerX,
          targetPointerX,
          pointerEase
        );


      pointerY =
        lerp(
          pointerY,
          targetPointerY,
          pointerEase
        );


      scrollProgress =
        lerp(
          scrollProgress,
          targetScrollProgress,
          scrollEase
        );


      /* ========================================================
         ENERGY

         Ataque relativamente rápido.
         Caída lenta.

         Esto hace que un scroll rápido produzca un pequeño
         impulso y después vuelva suavemente al movimiento normal.
         ======================================================== */

      energy =
        lerp(
          energy,
          targetEnergy,
          0.12
        );


      /*
       * Decaimiento continuo.
       */

      targetEnergy *= 0.955;


      if (
        targetEnergy < 0.001
      ) {
        targetEnergy = 0;
      }


      if (isVisible) {

        setLayerVariables(
          'dust',
          layers.dust,
          time
        );


        setLayerVariables(
          'texture',
          layers.texture,
          time
        );


        setLayerVariables(
          'snack',
          layers.snack,
          time
        );


        setLayerVariables(
          'bread',
          layers.bread,
          time
        );


        setLayerVariables(
          'tortilla',
          layers.tortilla,
          time
        );

      }


      requestAnimationFrame(
        render
      );

    };


    /* ==========================================================
       INTERSECTION OBSERVER
       ========================================================== */

    if (
      'IntersectionObserver' in window
    ) {

      const observer =
        new IntersectionObserver(
          (entries) => {

            entries.forEach(
              (entry) => {

                isVisible =
                  entry.isIntersecting;


                if (isVisible) {

                  /*
                   * Reset de referencia para evitar que volver
                   * a entrar genere un falso pico de velocidad.
                   */

                  previousScrollY =
                    window.scrollY;


                  previousScrollTime =
                    performance.now();


                  updateScrollTarget();

                }

              }
            );

          },
          {
            rootMargin:
              '15% 0px 15% 0px'
          }
        );


      observer.observe(
        section
      );

    }


    /* ==========================================================
       EVENTS
       ========================================================== */

    window.addEventListener(
      'scroll',
      updateScrollTarget,
      {
        passive: true
      }
    );


    window.addEventListener(
      'resize',
      updateScrollTarget,
      {
        passive: true
      }
    );


    section.addEventListener(
      'pointermove',
      updatePointerTarget,
      {
        passive: true
      }
    );


    section.addEventListener(
      'pointerleave',
      resetPointer,
      {
        passive: true
      }
    );


    desktopQuery.addEventListener?.(
      'change',
      () => {

        if (!enabled()) {
          resetStyles();
        }

        previousScrollY =
          window.scrollY;

        previousScrollTime =
          performance.now();

        updateScrollTarget();

      }
    );


    reducedMotionQuery.addEventListener?.(
      'change',
      () => {

        if (!enabled()) {
          resetStyles();
        }

      }
    );


    /* ==========================================================
       INIT
       ========================================================== */

    previousScrollY =
      window.scrollY;


    previousScrollTime =
      performance.now();


    updateScrollTarget();


    requestAnimationFrame(
      render
    );

  })();
</script>


{% schema %}
{
  "name": "G4U · Manifiesto Nosotros",
  "tag": "section",
  "class": "section-g4u-about-manifesto",
  "settings": [
    {
      "type": "header",
      "content": "Imágenes decorativas"
    },
    {
      "type": "image_picker",
      "id": "dust_image",
      "label": "Polvo / fondo izquierdo"
    },
    {
      "type": "image_picker",
      "id": "texture_image",
      "label": "Textura / fondo derecho"
    },
    {
      "type": "image_picker",
      "id": "snack_image",
      "label": "Producto izquierdo"
    },
    {
      "type": "image_picker",
      "id": "bread_image",
      "label": "Producto central"
    },
    {
      "type": "image_picker",
      "id": "tortilla_image",
      "label": "Producto derecho"
    },
    {
      "type": "textarea",
      "id": "closing",
      "label": "Cierre",
      "default": "Por eso existimos:\nPara redefinir el pan."
    },
    {
      "type": "textarea",
      "id": "closing_accent",
      "label": "Cierre destacado",
      "default": "Y demostrar que lo que te hace bien…\ntambién puede ser rico."
    }
  ],
  "presets": [
    {
      "name": "G4U · Manifiesto Nosotros"
    }
  ]
}
{% endschema %}