<section
  class="g4u-about-manifesto"
  id="G4uAboutManifesto-{{ section.id }}"
  aria-labelledby="G4uAboutManifestoTitle-{{ section.id }}"
  data-g4u-manifesto-parallax
>
  <div class="g4u-about-manifesto__copy">
    <h2
      class="g4u-about-manifesto__title g4u-display"
      id="G4uAboutManifestoTitle-{{ section.id }}"
    >
      Creemos en la <em>nutrición inteligente,</em><br>
      la que combina <strong>ciencia, sabor</strong><br>
      y <strong>bienestar</strong> real.<br>
      En los alimentos que<br>
      no prometen magia,<br>
      sino <em>resultados</em> auténticos.<br>
      Creemos en la <strong>transparencia,</strong><br>
      en los <em>ingredientes limpios</em><br>
      y en las <strong>decisiones conscientes.</strong><br>
      Creemos que lo <em>saludable</em><br>
      no tiene que ser aburrido.
    </h2>

    <div class="g4u-about-manifesto__closing g4u-display">
      <p>{{ section.settings.closing | escape | newline_to_br }}</p>
      <p>{{ section.settings.closing_accent | escape | newline_to_br }}</p>
    </div>
  </div>

  <div class="g4u-about-manifesto__art" aria-hidden="true">

    {%- if section.settings.dust_image != blank -%}
      {{
        section.settings.dust_image
        | image_url: width: 1024
        | image_tag:
          class: 'g4u-about-manifesto__dust',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__dust"
        src="{{ 'g4u-about-manifesto-dust.png' | asset_url }}"
        alt=""
        width="1024"
        height="1536"
        loading="lazy"
      >
    {%- endif -%}


    {%- if section.settings.texture_image != blank -%}
      {{
        section.settings.texture_image
        | image_url: width: 1024
        | image_tag:
          class: 'g4u-about-manifesto__texture',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__texture"
        src="{{ 'g4u-about-manifesto-texture.png' | asset_url }}"
        alt=""
        width="1024"
        height="1535"
        loading="lazy"
      >
    {%- endif -%}


    {%- if section.settings.snack_image != blank -%}
      {{
        section.settings.snack_image
        | image_url: width: 456
        | image_tag:
          class: 'g4u-about-manifesto__object g4u-about-manifesto__object--snack',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__object g4u-about-manifesto__object--snack"
        src="{{ 'g4u-about-snack.png' | asset_url }}"
        alt=""
        width="456"
        height="458"
        loading="lazy"
      >
    {%- endif -%}


    {%- if section.settings.bread_image != blank -%}
      {{
        section.settings.bread_image
        | image_url: width: 866
        | image_tag:
          class: 'g4u-about-manifesto__object g4u-about-manifesto__object--bread',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__object g4u-about-manifesto__object--bread"
        src="{{ 'g4u-about-bread.png' | asset_url }}"
        alt=""
        width="866"
        height="926"
        loading="lazy"
      >
    {%- endif -%}


    {%- if section.settings.tortilla_image != blank -%}
      {{
        section.settings.tortilla_image
        | image_url: width: 490
        | image_tag:
          class: 'g4u-about-manifesto__object g4u-about-manifesto__object--tortilla',
          loading: 'lazy'
      }}
    {%- else -%}
      <img
        class="g4u-about-manifesto__object g4u-about-manifesto__object--tortilla"
        src="{{ 'g4u-about-tortilla.png' | asset_url }}"
        alt=""
        width="490"
        height="449"
        loading="lazy"
      >
    {%- endif -%}

  </div>
</section>


<style>
  /* ============================================================
     G4U · MANIFIESTO
     CINEMATIC ORGANIC DEPTH PARALLAX

     - Scroll parallax
     - Profundidad progresiva
     - Perspectiva 3D leve
     - Movimiento orgánico
     - Inercia por velocidad
     - Pointer parallax desktop
     - Mobile optimizado
     ============================================================ */


  #G4uAboutManifesto-{{ section.id }} {
    position: relative;
  }


  /* ============================================================
     ART / PERSPECTIVE
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__art {
    background: transparent !important;

    /*
     * Perspectiva larga y elegante.
     * Evitamos un 3D exagerado.
     */
    perspective: 1250px;
    perspective-origin: 50% 46%;
    transform-style: preserve-3d;
  }


  /* ============================================================
     PERFORMANCE
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__dust,

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__texture,

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__object {
    backface-visibility: hidden;
    transform-origin: center center;
  }


  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__dust,

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__texture {
    will-change: translate, rotate;
  }


  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__object {
    will-change: transform, translate, rotate;
  }


  /* ============================================================
     3D DEPTH
     ============================================================ */

  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__object--snack {
    transform:
      translate3d(
        0,
        0,
        var(--g4u-snack-z, 0px)
      )
      rotateX(
        var(--g4u-snack-rx, 0deg)
      )
      rotateY(
        var(--g4u-snack-ry, 0deg)
      )
      scale(
        var(--g4u-snack-depth-scale, 1)
      );
  }


  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__object--bread {
    transform:
      translate3d(
        0,
        0,
        var(--g4u-bread-z, 0px)
      )
      rotateX(
        var(--g4u-bread-rx, 0deg)
      )
      rotateY(
        var(--g4u-bread-ry, 0deg)
      )
      scale(
        var(--g4u-bread-depth-scale, 1)
      );
  }


  #G4uAboutManifesto-{{ section.id }}
  .g4u-about-manifesto__object--tortilla {
    transform:
      translate3d(
        0,
        0,
        var(--g4u-tortilla-z, 0px)
      )
      rotateX(
        var(--g4u-tortilla-rx, 0deg)
      )
      rotateY(
        var(--g4u-tortilla-ry, 0deg)
      )
      scale(
        var(--g4u-tortilla-depth-scale, 1)
      );
  }


  /* ============================================================
     DESKTOP
     ============================================================ */

  @media screen and (min-width: 990px) {

    /* ------------------------------------------------------------
       DUST
       ------------------------------------------------------------ */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__dust {
      mix-blend-mode: screen;

      translate:
        var(--g4u-dust-x, 0px)
        var(--g4u-dust-y, 0px);

      rotate:
        var(--g4u-dust-rotate, 0deg);
    }


    /* ------------------------------------------------------------
       TEXTURE
       ------------------------------------------------------------ */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__texture {
      mix-blend-mode: screen;

      translate:
        var(--g4u-texture-x, 0px)
        var(--g4u-texture-y, 0px);

      rotate:
        var(--g4u-texture-rotate, 0deg);

      scale: 1.055;
    }


    /* ------------------------------------------------------------
       SNACK
       ------------------------------------------------------------ */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--snack {
      translate:
        var(--g4u-snack-x, 0px)
        var(--g4u-snack-y, 0px);

      rotate:
        var(--g4u-snack-rotate, 0deg);
    }


    /* ------------------------------------------------------------
       BREAD
       ------------------------------------------------------------ */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--bread {
      translate:
        var(--g4u-bread-x, 0px)
        var(--g4u-bread-y, 0px);

      rotate:
        var(--g4u-bread-rotate, 0deg);
    }


    /* ------------------------------------------------------------
       TORTILLA
       ------------------------------------------------------------ */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--tortilla {
      translate:
        var(--g4u-tortilla-x, 0px)
        var(--g4u-tortilla-y, 0px);

      rotate:
        var(--g4u-tortilla-rotate, 0deg);
    }
  }


  /* ============================================================
     MOBILE
     ============================================================ */

  @media screen and (max-width: 989px) {

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__art {
      /*
       * Un poco más de perspectiva en mobile para compensar
       * el viewport más pequeño sin exagerar el efecto.
       */
      perspective: 1050px;
    }


    /* ------------------------------------------------------------
       DUST
       ------------------------------------------------------------ */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__dust {
      mix-blend-mode: screen;

      translate:
        calc(var(--g4u-dust-x, 0px) - 4px)
        calc(var(--g4u-dust-y, 0px) - 8px);

      rotate:
        var(--g4u-dust-rotate, 0deg);

      scale: 1.04;
    }


    /* ------------------------------------------------------------
       TEXTURE
       ------------------------------------------------------------ */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__texture {
      mix-blend-mode: screen;

      translate:
        calc(var(--g4u-texture-x, 0px) + 4px)
        var(--g4u-texture-y, 0px);

      rotate:
        var(--g4u-texture-rotate, 0deg);

      scale: 1.09;
    }


    /* ------------------------------------------------------------
       SNACK
       ------------------------------------------------------------ */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--snack {
      translate:
        calc(var(--g4u-snack-x, 0px) - 5px)
        calc(var(--g4u-snack-y, 0px) - 28px);

      rotate:
        var(--g4u-snack-rotate, 0deg);

      scale: 0.94;
    }


    /* ------------------------------------------------------------
       BREAD
       ------------------------------------------------------------ */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--bread {
      translate:
        calc(var(--g4u-bread-x, 0px) + 4px)
        calc(var(--g4u-bread-y, 0px) + 3px);

      rotate:
        var(--g4u-bread-rotate, 0deg);

      scale: 0.93;
    }


    /* ------------------------------------------------------------
       TORTILLA
       ------------------------------------------------------------ */

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--tortilla {
      translate:
        calc(var(--g4u-tortilla-x, 0px) - 7px)
        calc(var(--g4u-tortilla-y, 0px) + 32px);

      rotate:
        var(--g4u-tortilla-rotate, 0deg);

      scale: 0.95;
    }
  }


  /* ============================================================
     MOBILE EXTRA SMALL
     ============================================================ */

  @media screen and (max-width: 480px) {

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--snack {
      translate:
        calc(var(--g4u-snack-x, 0px) - 7px)
        calc(var(--g4u-snack-y, 0px) - 34px);

      scale: 0.91;
    }


    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--bread {
      translate:
        calc(var(--g4u-bread-x, 0px) + 4px)
        calc(var(--g4u-bread-y, 0px) + 3px);

      scale: 0.91;
    }


    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object--tortilla {
      translate:
        calc(var(--g4u-tortilla-x, 0px) - 8px)
        calc(var(--g4u-tortilla-y, 0px) + 38px);

      scale: 0.92;
    }
  }


  /* ============================================================
     REDUCED MOTION
     ============================================================ */

  @media (prefers-reduced-motion: reduce) {

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__dust,

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__texture,

    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object {
      translate: 0 0 !important;
      rotate: 0deg !important;
    }


    #G4uAboutManifesto-{{ section.id }}
    .g4u-about-manifesto__object {
      transform: none !important;
    }
  }
</style>


<script>
  (() => {

    const section = document.querySelector(
      '#G4uAboutManifesto-{{ section.id }}'
    );

    if (!section) return;


    /* ==========================================================
       PREVENT DOUBLE INIT
       ========================================================== */

    if (
      section.dataset.g4uParallaxInitialized === 'true'
    ) {
      return;
    }

    section.dataset.g4uParallaxInitialized = 'true';


    /* ==========================================================
       MEDIA QUERIES
       ========================================================== */

    const desktopQuery = window.matchMedia(
      '(min-width: 990px)'
    );

    const reducedMotionQuery = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );


    /* ==========================================================
       DESKTOP CONFIGURATION
       ========================================================== */

    const desktopLayers = {

      /*
       * BACKGROUND DUST
       *
       * Se mueve más lento porque visualmente está
       * en el plano más profundo.
       */
      dust: {
        scrollY: 21,

        mouseX: -4.5,
        mouseY: -4.5,

        floatX: 2.2,
        floatY: 3.2,

        frequency: 0.00032,
        phase: 0.7,

        energy: 3,
        rotate: 0.04
      },


      /*
       * BACKGROUND TEXTURE
       */
      texture: {
        scrollY: -37,

        mouseX: 7,
        mouseY: 7,

        floatX: 3.5,
        floatY: 5,

        frequency: 0.00027,
        phase: 2.4,

        energy: 5,
        rotate: -0.06
      },


      /*
       * ========================================================
       * SNACK
       *
       * Elemento visualmente más ligero.
       *
       * Empieza:
       * - más lejos
       * - hacia la izquierda
       * - ligeramente arriba
       *
       * Luego converge progresivamente.
       * ========================================================
       */

      snack: {
        scrollY: -67,

        mouseX: 18.5,
        mouseY: 14,

        floatX: 4.5,
        floatY: 6,

        frequency: 0.00055,
        phase: 1.2,

        energy: 9,
        rotate: 0.95,


        /* Posición inicial extra */
        depthX: -72,
        depthY: -30,


        /* Profundidad Z */
        farZ: -190,
        nearZ: 12,


        /* Crecimiento */
        farScale: 0.955,
        nearScale: 1,

        /*
         * Micro expansión en mitad del scroll.
         * 1.8% máximo adicional.
         */
        scalePulse: 0.018,


        /* Rotación 3D inicial */
        tiltX: 1.35,
        tiltY: -2.25,


        /* Influencia 3D del mouse */
        pointerTilt: 0.80
      },


      /*
       * ========================================================
       * BREAD
       *
       * Es el protagonista visual.
       * Debe sentirse más pesado y estable.
       * ========================================================
       */

      bread: {
        scrollY: -44,

        mouseX: 11.5,
        mouseY: 9,

        floatX: 3.5,
        floatY: 4.5,

        frequency: 0.00040,
        phase: 3.8,

        energy: 6,
        rotate: -0.42,


        depthX: 10,
        depthY: 44,


        farZ: -145,
        nearZ: 15,


        farScale: 0.965,
        nearScale: 1,

        scalePulse: 0.013,


        tiltX: -1.05,
        tiltY: 1.35,


        pointerTilt: 0.58
      },


      /*
       * ========================================================
       * TORTILLA
       *
       * Contrapeso del snack.
       * Entra desde derecha / abajo.
       * ========================================================
       */

      tortilla: {
        scrollY: -55,

        mouseX: -12.5,
        mouseY: -9,

        floatX: 4,
        floatY: 5.5,

        frequency: 0.00048,
        phase: 5.1,

        energy: 7,
        rotate: -0.65,


        depthX: 74,
        depthY: 34,


        farZ: -175,
        nearZ: 10,


        farScale: 0.96,
        nearScale: 1,

        scalePulse: 0.016,


        tiltX: 1.25,
        tiltY: 2.05,


        pointerTilt: 0.72
      }

    };


    /* ==========================================================
       MOBILE CONFIGURATION

       Mobile mantiene profundidad pero:
       - menos Z
       - menos desplazamiento
       - casi nada de inclinación
       - sin mouse
       ========================================================== */

    const mobileLayers = {

      dust: {
        scrollY: 14,

        mouseX: 0,
        mouseY: 0,

        floatX: 1.5,
        floatY: 2.5,

        frequency: 0.00030,
        phase: 0.7,

        energy: 2.5,
        rotate: 0.025
      },


      texture: {
        scrollY: -23,

        mouseX: 0,
        mouseY: 0,

        floatX: 2.5,
        floatY: 3.5,

        frequency: 0.00025,
        phase: 2.4,

        energy: 4,
        rotate: -0.04
      },


      snack: {
        scrollY: -42,

        mouseX: 0,
        mouseY: 0,

        floatX: 3.2,
        floatY: 5,

        frequency: 0.00058,
        phase: 1.2,

        energy: 7,
        rotate: 0.65,


        depthX: -26,
        depthY: -22,

        farZ: -92,
        nearZ: 3,

        farScale: 0.975,
        nearScale: 1,

        scalePulse: 0.010,

        tiltX: 0.55,
        tiltY: -0.90,

        pointerTilt: 0
      },


      bread: {
        scrollY: -27,

        mouseX: 0,
        mouseY: 0,

        floatX: 2.3,
        floatY: 3.2,

        frequency: 0.00038,
        phase: 3.8,

        energy: 4.5,
        rotate: -0.27,


        depthX: 3,
        depthY: 20,

        farZ: -72,
        nearZ: 4,

        farScale: 0.98,
        nearScale: 1,

        scalePulse: 0.008,

        tiltX: -0.40,
        tiltY: 0.55,

        pointerTilt: 0
      },


      tortilla: {
        scrollY: -36,

        mouseX: 0,
        mouseY: 0,

        floatX: 3,
        floatY: 4.3,

        frequency: 0.00050,
        phase: 5.1,

        energy: 5.5,
        rotate: -0.42,


        depthX: 26,
        depthY: 24,

        farZ: -84,
        nearZ: 3,

        farScale: 0.975,
        nearScale: 1,

        scalePulse: 0.010,

        tiltX: 0.50,
        tiltY: 0.80,

        pointerTilt: 0
      }

    };


    /* ==========================================================
       GET CURRENT CONFIGURATION
       ========================================================== */

    const getLayers = () => {

      return desktopQuery.matches
        ? desktopLayers
        : mobileLayers;

    };


    /* ==========================================================
       STATE
       ========================================================== */

    let targetPointerX = 0;
    let targetPointerY = 0;

    let pointerX = 0;
    let pointerY = 0;


    /*
     * Parallax vertical general.
     *
     * -1 = sección debajo
     *  0 = centro
     *  1 = sección arriba
     */
    let targetScrollProgress = 0;
    let scrollProgress = 0;


    /*
     * Profundidad / acercamiento.
     *
     * 0 = lejos
     * 1 = composición final
     */
    let targetApproachProgress = 0;
    let approachProgress = 0;


    /*
     * Energía generada por velocidad del scroll.
     */
    let targetEnergy = 0;
    let energy = 0;


    let previousScrollY =
      window.scrollY;


    let previousScrollTime =
      performance.now();


    let isVisible = true;


    /* ==========================================================
       HELPERS
       ========================================================== */

    const clamp = (
      value,
      min,
      max
    ) => {

      return Math.min(
        Math.max(value, min),
        max
      );

    };


    const lerp = (
      current,
      target,
      amount
    ) => {

      return current +
        (target - current) * amount;

    };


    /*
     * Smoothstep:
     *
     * hace que entrada y salida de la interpolación
     * sean progresivas.
     */
    const smoothstep = (
      edge0,
      edge1,
      value
    ) => {

      const x =
        clamp(
          (
            value - edge0
          ) /
          (
            edge1 - edge0
          ),
          0,
          1
        );


      return (
        x *
        x *
        (
          3 -
          (2 * x)
        )
      );

    };


    const enabled = () => {

      return !reducedMotionQuery.matches;

    };


    /* ==========================================================
       SCROLL POSITION + DEPTH + VELOCITY
       ========================================================== */

    const updateScrollTarget = () => {

      if (!enabled()) return;


      const rect =
        section.getBoundingClientRect();


      const viewportHeight =
        window.innerHeight;


      /* ========================================================
         GENERAL PARALLAX
         ======================================================== */

      const sectionCenter =
        rect.top +
        (
          rect.height / 2
        );


      const viewportCenter =
        viewportHeight / 2;


      const distance =
        viewportCenter -
        sectionCenter;


      const range =
        (
          viewportHeight +
          rect.height
        ) / 2;


      targetScrollProgress =
        clamp(
          distance / range,
          -1,
          1
        );


      /* ========================================================
         DEPTH APPROACH
         ========================================================

         La animación comienza cuando el inicio de la sección
         comienza a entrar al viewport.

         Se completa aproximadamente cuando el inicio de la
         sección llega a la parte superior.

         De esta forma el usuario realmente siente que los
         productos vienen desde el fondo hacia él.
         ======================================================== */

      const depthDistance =
        viewportHeight -
        rect.top;


      const rawApproach =
        clamp(
          depthDistance /
          viewportHeight,
          0,
          1
        );


      /*
       * Dejamos los primeros milímetros visuales
       * con el objeto todavía lejos.
       */
      targetApproachProgress =
        smoothstep(
          0.02,
          0.98,
          rawApproach
        );


      /* ========================================================
         SCROLL VELOCITY / INERTIA
         ======================================================== */

      const now =
        performance.now();


      const currentScrollY =
        window.scrollY;


      const deltaY =
        currentScrollY -
        previousScrollY;


      const deltaTime =
        Math.max(
          now -
          previousScrollTime,
          16
        );


      const velocity =
        Math.abs(deltaY) /
        deltaTime;


      /*
       * Desktop admite algo más de reacción.
       * Mobile queda amortiguado.
       */
      const velocityMultiplier =
        desktopQuery.matches
          ? 1.35
          : 1.00;


      const velocityEnergy =
        clamp(
          velocity *
          velocityMultiplier,
          0,
          1
        );


      targetEnergy =
        Math.max(
          targetEnergy,
          velocityEnergy
        );


      previousScrollY =
        currentScrollY;


      previousScrollTime =
        now;

    };


    /* ==========================================================
       POINTER
       DESKTOP ONLY
       ========================================================== */

    const updatePointerTarget = (
      event
    ) => {

      if (
        !enabled() ||
        !desktopQuery.matches
      ) {
        return;
      }


      const rect =
        section.getBoundingClientRect();


      const normalizedX =
        (
          event.clientX -
          rect.left
        ) /
        rect.width;


      const normalizedY =
        (
          event.clientY -
          rect.top
        ) /
        rect.height;


      targetPointerX =
        clamp(
          (
            normalizedX -
            0.5
          ) *
          2,
          -1,
          1
        );


      targetPointerY =
        clamp(
          (
            normalizedY -
            0.5
          ) *
          2,
          -1,
          1
        );

    };


    const resetPointer = () => {

      targetPointerX = 0;
      targetPointerY = 0;

    };


    /* ==========================================================
       ORGANIC MOVEMENT
       ========================================================== */

    const getOrganicMotion = (
      time,
      config
    ) => {

      const t =
        time *
        config.frequency;


      /*
       * Tres ondas ligeramente incompatibles
       * evitan un movimiento sinusoidal demasiado obvio.
       */

      const waveA =
        Math.sin(
          t +
          config.phase
        );


      const waveB =
        Math.sin(
          (
            t * 1.73
          ) +
          (
            config.phase * 1.8
          )
        );


      const waveC =
        Math.cos(
          (
            t * 0.61
          ) +
          (
            config.phase * 0.73
          )
        );


      const organicX =
        (
          (
            waveA * 0.55
          ) +
          (
            waveB * 0.30
          ) +
          (
            waveC * 0.15
          )
        ) *
        config.floatX;


      const organicY =
        (
          (
            waveA * 0.25
          ) +
          (
            waveB * 0.50
          ) +
          (
            waveC * 0.25
          )
        ) *
        config.floatY;


      return {
        x: organicX,
        y: organicY
      };

    };


    /* ==========================================================
       SET LAYER VARIABLES
       ========================================================== */

    const setLayerVariables = (
      name,
      config,
      time
    ) => {

      const organic =
        getOrganicMotion(
          time,
          config
        );


      /* ========================================================
         SCROLL VELOCITY INERTIA
         ======================================================== */

      const accelerationX =
        organic.x *
        energy *
        (
          desktopQuery.matches
            ? 0.62
            : 0.40
        );


      const accelerationY =
        Math.sin(
          (
            time * 0.001
          ) +
          config.phase
        ) *
        config.energy *
        energy;


      /* ========================================================
         FAR → NEAR POSITION
         ======================================================== */

      /*
       * 1 cuando está lejos
       * 0 cuando llegó a posición final
       */
      const farAmount =
        1 -
        approachProgress;


      const depthOffsetX =
        config.depthX !== undefined
          ? config.depthX * farAmount
          : 0;


      const depthOffsetY =
        config.depthY !== undefined
          ? config.depthY * farAmount
          : 0;


      /* ========================================================
         FINAL X
         ======================================================== */

      const x =
        (
          pointerX *
          config.mouseX
        ) +
        organic.x +
        accelerationX +
        depthOffsetX;


      /* ========================================================
         FINAL Y
         ======================================================== */

      const y =
        (
          scrollProgress *
          config.scrollY
        ) +
        (
          pointerY *
          config.mouseY
        ) +
        organic.y +
        accelerationY +
        depthOffsetY;


      section.style.setProperty(
        `--g4u-${name}-x`,
        `${x.toFixed(2)}px`
      );


      section.style.setProperty(
        `--g4u-${name}-y`,
        `${y.toFixed(2)}px`
      );


      /* ========================================================
         2D ROTATION
         ======================================================== */

      const organicRotation =
        Math.sin(
          (
            time *
            config.frequency *
            0.85
          ) +
          config.phase
        ) *
        Math.min(
          (
            Math.abs(
              config.rotate
            ) *
            0.18
          ),
          0.12
        );


      const rotation =
        (
          pointerX *
          config.rotate
        ) +
        organicRotation;


      section.style.setProperty(
        `--g4u-${name}-rotate`,
        `${rotation.toFixed(3)}deg`
      );


      /* ========================================================
         PRODUCT DEPTH
         ======================================================== */

      if (
        config.farZ !== undefined
      ) {

        /* ------------------------------------------------------
           Z POSITION
           ------------------------------------------------------ */

        const z =
          lerp(
            config.farZ,
            config.nearZ,
            approachProgress
          );


        /* ------------------------------------------------------
           SCALE

           Base:
           pequeño → tamaño final.

           Pulse:
           micro expansión durante la aproximación.
           ------------------------------------------------------ */

        const scalePulse =
          Math.sin(
            approachProgress *
            Math.PI
          ) *
          config.scalePulse;


        const baseScale =
          lerp(
            config.farScale,
            config.nearScale,
            approachProgress
          );


        const depthScale =
          baseScale +
          scalePulse;


        /* ------------------------------------------------------
           ROTATE X

           La inclinación de entrada desaparece mientras
           el objeto se aproxima.

           El pointer agrega una micro inclinación.
           ------------------------------------------------------ */

        const rotateX =
          (
            config.tiltX *
            farAmount
          ) -
          (
            pointerY *
            config.pointerTilt
          );


        /* ------------------------------------------------------
           ROTATE Y
           ------------------------------------------------------ */

        const rotateY =
          (
            config.tiltY *
            farAmount
          ) +
          (
            pointerX *
            config.pointerTilt
          );


        section.style.setProperty(
          `--g4u-${name}-z`,
          `${z.toFixed(2)}px`
        );


        section.style.setProperty(
          `--g4u-${name}-depth-scale`,
          depthScale.toFixed(4)
        );


        section.style.setProperty(
          `--g4u-${name}-rx`,
          `${rotateX.toFixed(3)}deg`
        );


        section.style.setProperty(
          `--g4u-${name}-ry`,
          `${rotateY.toFixed(3)}deg`
        );

      }

    };


    /* ==========================================================
       RESET STYLES
       ========================================================== */

    const resetStyles = () => {

      const layerNames = [
        'dust',
        'texture',
        'snack',
        'bread',
        'tortilla'
      ];


      layerNames.forEach(
        (name) => {

          section.style.removeProperty(
            `--g4u-${name}-x`
          );


          section.style.removeProperty(
            `--g4u-${name}-y`
          );


          section.style.removeProperty(
            `--g4u-${name}-rotate`
          );


          section.style.removeProperty(
            `--g4u-${name}-z`
          );


          section.style.removeProperty(
            `--g4u-${name}-rx`
          );


          section.style.removeProperty(
            `--g4u-${name}-ry`
          );


          section.style.removeProperty(
            `--g4u-${name}-depth-scale`
          );

        }
      );


      targetPointerX = 0;
      targetPointerY = 0;

      pointerX = 0;
      pointerY = 0;


      targetScrollProgress = 0;
      scrollProgress = 0;


      targetApproachProgress = 0;
      approachProgress = 0;


      targetEnergy = 0;
      energy = 0;

    };


    /* ==========================================================
       ANIMATION LOOP
       ========================================================== */

    const render = (
      time
    ) => {

      if (!enabled()) {

        requestAnimationFrame(
          render
        );

        return;

      }


      /*
       * Pointer:
       * algo reactivo pero amortiguado.
       */
      const pointerEase =
        desktopQuery.matches
          ? 0.090
          : 0.07;


      /*
       * Parallax vertical.
       */
      const scrollEase =
        desktopQuery.matches
          ? 0.076
          : 0.063;


      /*
       * Depth tiene más masa.

       * Debe retrasarse ligeramente respecto
       * de la rueda del mouse para generar
       * sensación de objeto físico.
       */
      const approachEase =
        desktopQuery.matches
          ? 0.052
          : 0.046;


      /* ========================================================
         POINTER DAMPING
         ======================================================== */

      pointerX =
        lerp(
          pointerX,
          targetPointerX,
          pointerEase
        );


      pointerY =
        lerp(
          pointerY,
          targetPointerY,
          pointerEase
        );


      /* ========================================================
         PARALLAX DAMPING
         ======================================================== */

      scrollProgress =
        lerp(
          scrollProgress,
          targetScrollProgress,
          scrollEase
        );


      /* ========================================================
         DEPTH DAMPING
         ======================================================== */

      approachProgress =
        lerp(
          approachProgress,
          targetApproachProgress,
          approachEase
        );


      /* ========================================================
         ENERGY / INERTIA
         ======================================================== */

      energy =
        lerp(
          energy,
          targetEnergy,
          desktopQuery.matches
            ? 0.115
            : 0.095
        );


      /*
       * La energía decae progresivamente.
       */
      targetEnergy *=
        desktopQuery.matches
          ? 0.955
          : 0.945;


      if (
        targetEnergy < 0.001
      ) {
        targetEnergy = 0;
      }


      /* ========================================================
         RENDER ONLY WHEN SECTION IS NEAR VIEWPORT
         ======================================================== */

      if (isVisible) {

        const layers =
          getLayers();


        setLayerVariables(
          'dust',
          layers.dust,
          time
        );


        setLayerVariables(
          'texture',
          layers.texture,
          time
        );


        setLayerVariables(
          'snack',
          layers.snack,
          time
        );


        setLayerVariables(
          'bread',
          layers.bread,
          time
        );


        setLayerVariables(
          'tortilla',
          layers.tortilla,
          time
        );

      }


      requestAnimationFrame(
        render
      );

    };


    /* ==========================================================
       INTERSECTION OBSERVER
       ========================================================== */

    if (
      'IntersectionObserver' in window
    ) {

      const observer =
        new IntersectionObserver(
          (entries) => {

            entries.forEach(
              (entry) => {

                isVisible =
                  entry.isIntersecting;


                if (isVisible) {

                  /*
                   * Evita interpretar como velocidad real
                   * el salto de posición ocurrido mientras
                   * la sección estuvo fuera del viewport.
                   */

                  previousScrollY =
                    window.scrollY;


                  previousScrollTime =
                    performance.now();


                  updateScrollTarget();

                }

              }
            );

          },
          {
            /*
             * Preparamos la posición 3D ANTES
             * de que los objetos entren al viewport.
             */
            rootMargin:
              '35% 0px 35% 0px'
          }
        );


      observer.observe(
        section
      );

    }


    /* ==========================================================
       EVENTS
       ========================================================== */

    window.addEventListener(
      'scroll',
      updateScrollTarget,
      {
        passive: true
      }
    );


    window.addEventListener(
      'resize',
      () => {

        /*
         * Desktop → mobile:
         * limpiar posición residual del mouse.
         */
        if (
          !desktopQuery.matches
        ) {
          resetPointer();
        }


        previousScrollY =
          window.scrollY;


        previousScrollTime =
          performance.now();


        updateScrollTarget();

      },
      {
        passive: true
      }
    );


    /* ==========================================================
       POINTER EVENTS
       ========================================================== */

    section.addEventListener(
      'pointermove',
      updatePointerTarget,
      {
        passive: true
      }
    );


    section.addEventListener(
      'pointerleave',
      resetPointer,
      {
        passive: true
      }
    );


    /* ==========================================================
       BREAKPOINT CHANGE
       ========================================================== */

    desktopQuery.addEventListener?.(
      'change',
      () => {

        resetPointer();


        previousScrollY =
          window.scrollY;


        previousScrollTime =
          performance.now();


        updateScrollTarget();

      }
    );


    /* ==========================================================
       REDUCED MOTION CHANGE
       ========================================================== */

    reducedMotionQuery.addEventListener?.(
      'change',
      () => {

        if (
          reducedMotionQuery.matches
        ) {

          resetStyles();

        }
        else {

          previousScrollY =
            window.scrollY;


          previousScrollTime =
            performance.now();


          updateScrollTarget();

        }

      }
    );


    /* ==========================================================
       INIT
       ========================================================== */

    if (
      reducedMotionQuery.matches
    ) {

      resetStyles();

      return;

    }


    previousScrollY =
      window.scrollY;


    previousScrollTime =
      performance.now();


    updateScrollTarget();


    requestAnimationFrame(
      render
    );

  })();
</script>


