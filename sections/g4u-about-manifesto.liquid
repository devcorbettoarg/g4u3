<style>
/* ============================================================
   G4U · MANIFESTO — VIEWPORT LINE REVEAL
   Cada línea se anima solamente cuando entra en pantalla.
   ============================================================ */

#G4uAboutManifesto-{{ section.id }}
.g4u-manifesto-line {
  display: block;
  overflow: hidden;

  padding: 0.08em 0;
  margin: -0.08em 0;
}


#G4uAboutManifesto-{{ section.id }}
.g4u-manifesto-line__inner {
  display: block;

  opacity: 0;

  transform:
    translate3d(0, 110%, 0);

  filter:
    blur(4px);

  transition:
    transform
      0.95s
      cubic-bezier(0.16, 1, 0.3, 1),

    opacity
      0.62s
      ease-out,

    filter
      0.75s
      ease-out;

  will-change:
    transform,
    opacity,
    filter;
}


/* ============================================================
   CADA LÍNEA SE ACTIVA INDIVIDUALMENTE
   ============================================================ */

#G4uAboutManifesto-{{ section.id }}
.g4u-manifesto-line.is-visible
.g4u-manifesto-line__inner {
  opacity: 1;

  transform:
    translate3d(0, 0, 0);

  filter:
    blur(0);
}


/* ============================================================
   MOBILE
   ============================================================ */

@media screen and (max-width: 749px) {

  #G4uAboutManifesto-{{ section.id }}
  .g4u-manifesto-line__inner {
    transform:
      translate3d(0, 90%, 0);

    filter:
      blur(2px);

    transition:
      transform
        0.82s
        cubic-bezier(0.16, 1, 0.3, 1),

      opacity
        0.55s
        ease-out,

      filter
        0.65s
        ease-out;
  }

}


/* ============================================================
   REDUCED MOTION
   ============================================================ */

@media (prefers-reduced-motion: reduce) {

  #G4uAboutManifesto-{{ section.id }}
  .g4u-manifesto-line__inner {
    opacity: 1 !important;

    transform:
      none !important;

    filter:
      none !important;

    transition:
      none !important;
  }

}
</style>

<script>
(() => {

  const section =
    document.querySelector(
      '#G4uAboutManifesto-{{ section.id }}'
    );

  if (!section) {
    return;
  }


  /* ==========================================================
     PREVENT DOUBLE INIT
     ========================================================== */

  if (
    section.dataset.g4uManifestoViewportReveal === 'true'
  ) {
    return;
  }

  section.dataset.g4uManifestoViewportReveal = 'true';


  const lines =
    Array.from(
      section.querySelectorAll(
        '.g4u-manifesto-line'
      )
    );

  if (!lines.length) {
    return;
  }


  const reducedMotion =
    window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );


  /* ==========================================================
     ACCESSIBILITY
     ========================================================== */

  if (reducedMotion.matches) {

    lines.forEach(
      (line) => {
        line.classList.add(
          'is-visible'
        );
      }
    );

    return;
  }


  /* ==========================================================
     FALLBACK
     ========================================================== */

  if (
    !('IntersectionObserver' in window)
  ) {

    lines.forEach(
      (line) => {
        line.classList.add(
          'is-visible'
        );
      }
    );

    return;
  }


  /* ==========================================================
     OBSERVER POR LÍNEA

     La línea NO comienza su animación hasta que ella misma
     alcanza la zona visible del viewport.
     ========================================================== */

  const observer =
    new IntersectionObserver(
      (entries) => {

        entries.forEach(
          (entry) => {

            if (!entry.isIntersecting) {
              return;
            }


            /*
             * Esperamos dos frames para garantizar que
             * el navegador haya pintado el estado oculto.
             */

            requestAnimationFrame(() => {

              requestAnimationFrame(() => {

                entry.target.classList.add(
                  'is-visible'
                );

              });

            });


            /*
             * Reveal una sola vez.
             */

            observer.unobserve(
              entry.target
            );

          }
        );

      },
      {
        /*
         * La línea necesita estar realmente dentro
         * de la pantalla.
         */
        threshold: 0.35,

        /*
         * Reducimos la zona activa inferior.
         *
         * La animación empieza aproximadamente cuando
         * la línea supera el último 10% del viewport.
         */
        rootMargin:
          '0px 0px -10% 0px'
      }
    );


  /* ==========================================================
     OBSERVE EACH LINE
     ========================================================== */

  lines.forEach(
    (line) => {

      observer.observe(
        line
      );

    }
  );

})();
</script>


