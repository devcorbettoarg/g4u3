<section class="g4u-flour-hero" aria-labelledby="G4uFlourHero-{{ section.id }}">

  <picture class="g4u-flour-hero__media">
    {%- if section.settings.mobile_image != blank -%}
      <source
        media="(max-width: 749px)"
        srcset="{{ section.settings.mobile_image | image_url: width: 1100 }}"
      >
    {%- endif -%}

    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'g4u-flour-hero__image',
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 1800, 2200, 2400',
          sizes: '100vw'
      }}
    {%- else -%}
      <img
        class="g4u-flour-hero__image"
        src="{{ 'g4u-flour-hero.webp' | asset_url }}"
        alt="{{ section.settings.image_alt | escape }}"
        width="2400"
        height="1600"
        fetchpriority="high"
      >
    {%- endif -%}
  </picture>

  <div class="g4u-flour-hero__content">

    <h1
      class="g4u-flour-hero__title g4u-display wow animate__fadeInUp"
      id="G4uFlourHero-{{ section.id }}"
      data-wow-duration="0.8s"
      data-wow-delay="0.05s"
    >
      {{ section.settings.title_before | escape }}
      <em>{{ section.settings.title_accent_1 | escape }}</em><br>
      {{ section.settings.title_after | escape }}
      <em>{{ section.settings.title_accent_2 | escape }}</em>
    </h1>

    <div
      class="g4u-flour-hero__text rte wow animate__fadeInUp"
      data-wow-duration="0.8s"
      data-wow-delay="0.18s"
    >
      {{ section.settings.text }}
    </div>

  </div>

  <a
    class="g4u-flour-hero__scroll wow animate__fadeIn"
    href="#G4uFlourChallenge"
    aria-label="Ir al contenido"
    data-wow-duration="0.8s"
    data-wow-delay="0.5s"
  >
    <span></span>
  </a>

</section>

{% schema %}
{
  "name": "G4U · Hero Harina",
  "tag": "section",
  "class": "section-g4u-flour-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de escritorio"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Imagen móvil"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Descripción de imagen",
      "default": "Masa de pan sobre una superficie con harina"
    },
    {
      "type": "text",
      "id": "title_before",
      "label": "Título antes destacado",
      "default": "La"
    },
    {
      "type": "text",
      "id": "title_accent_1",
      "label": "Destacado 1",
      "default": "diferencia"
    },
    {
      "type": "text",
      "id": "title_after",
      "label": "Título segunda línea",
      "default": "empieza en la"
    },
    {
      "type": "text",
      "id": "title_accent_2",
      "label": "Destacado 2",
      "default": "harina"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Desarrollamos una harina funcional propia para reinventar el pan desde su origen, combinando ciencia, nutrición y sabor en una única fórmula.</p>"
    }
  ],
  "presets": [
    {
      "name": "G4U · Hero Harina"
    }
  ]
}
{% endschema %}