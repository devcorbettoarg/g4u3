    "g4u_services": {
      "type": "g4u-service-benefits",
      "blocks": {
        "shipping": { "type": "benefit", "settings": { "text": "Envíos Buenos Aires,\nCórdoba y Santa Fe" } },
        "nutrition": { "type": "benefit", "settings": { "text": "Nutrición inteligente,\ncon sabor auténtico y beneficios reales" } },
        "delivery": { "type": "benefit", "settings": { "text": "Entregas en 24/48 hs\nen AMBA" } },
        "payment": { "type": "benefit", "settings": { "text": "Pago seguro" } }
