{
  "sections": {
    "banner": {
      "type": "main-collection-banner",
      "settings": {
        "show_collection_description": true,
        "show_collection_image": false,
        "color_scheme": "scheme-1"
      }
    },
    "product-grid": {
      "type": "main-collection-product-grid",
      "settings": {
        "products_per_page": 16,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "quick_add": "none",
        "enable_filtering": true,
        "filter_type": "horizontal",
        "enable_sorting": true,
        "columns_mobile": "2",
        "padding_top": 40,
        "padding_bottom": 80
      }
    },
    "g4u_instagram": {
      "type": "g4u-instagram",
      "blocks": {
        "post_1": { "type": "post", "settings": { "accessibility_label": "Ver publicación de G4U en Instagram" } },
        "post_2": { "type": "post", "settings": { "accessibility_label": "Ver publicación de G4U en Instagram" } },
        "post_3": { "type": "post", "settings": { "accessibility_label": "Ver publicación de G4U en Instagram" } },
        "post_4": { "type": "post", "settings": { "accessibility_label": "Ver publicación de G4U en Instagram" } },
        "post_5": { "type": "post", "settings": { "accessibility_label": "Ver publicación de G4U en Instagram" } },
        "post_6": { "type": "post", "settings": { "accessibility_label": "Ver publicación de G4U en Instagram" } },
        "post_7": { "type": "post", "settings": { "accessibility_label": "Ver publicación de G4U en Instagram" } },
        "post_8": { "type": "post", "settings": { "accessibility_label": "Ver publicación de G4U en Instagram" } }
